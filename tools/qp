def die(msg):
    sys.exit('qp: ' + msg)


# The framework files that define what a theorem means and how the C is translated to it: the statement
# (Contract.v, Env.v, quickproof.h), the lemmas the whole-program proof is assembled from, the plain-C libc and
# malloc compiled into whole_prog, and the translation chain (clight.sh and the scripts it and new_contract.py
# use).  `qp verify` requires the framework submodule of the proof repository to hold these byte for byte as
# this verifier does, so that a modified framework cannot change what a theorem says (docs/QP.md).
TRUSTED_FRAMEWORK_FILES = ([
    'include/quickproof.h',
    'libc/libc.c', 'libc/malloc_unit.c', 'libc/string.c',
    'tools/clight.sh', 'tools/conf.py', 'tools/tag_anon.py', 'tools/canon_anon.py', 'tools/new_contract.py',
    'tools/link_units.py',
] + ['coq/QuickProof/%s.v' % m for m in ('Env', 'Contract', 'EnvBodies', 'Pick', 'Link', 'Assembly')])

# _CoqProject options.  The main build may use only -Q, -R and -arg with a warning control.  A run/prebuild
# project (the build of a vendored library) may pass coqc other options, except those that load code or change
# the logic.
COQPROJECT_FLAGS_OK = {'-Q', '-R', '-arg'}
DANGEROUS_COQ_FLAGS = {'-I', '-impredicative-set', '-type-in-type', '-noinit', '-mangle-names',
                       '-allow-rewrite-rules', '-rifrom', '-generate-meta-for-package', '-coqlib', '-boot'}
COQPROJECT_ARG_OK = re.compile(r'^-w$|^[-+=][\w.,+-]*$')   # -arg values that are warning controls only
# file extensions in _CoqProject or tracked in the repo that would compile or load an OCaml plugin
PLUGIN_EXT = ('.ml', '.mli', '.mll', '.mly', '.mlg', '.ml4', '.mlib', '.mllib', '.mlpack', '.cmxs', '.cma',
              '.cmxa', '.cmo', '.cmi', '.cmx', '.cmt', '.cmti')
# vernac in the proof's own sources that loads code or turns off a check of the kernel (the framework's own
# files are trusted and compared byte for byte, so they are not scanned)
UNSAFE_VERNAC = re.compile(
    r'(Declare\s+ML\s+Module'
    r'|(?:Unset|Set)\s+(?:Universe|Guard|Positivity)\s+Checking'
    r'|Extract\s+(?:Constant|Inlined\s+Constant|Inductive)'
    r'|Extraction\s+(?:Language|Blacklist))')


def file_sha(path):
    try:
        return sha256(open(path, 'rb').read())
    except OSError:
        return None


def framework_trusted_diff(fwdir):
    """(missing, differing): the TRUSTED_FRAMEWORK_FILES of the repository's framework `fwdir` that are absent
    or differ byte for byte from this verifier's own framework (FRAMEWORK_HOME).  Empty lists: the framework is,
    in everything that defines a theorem's meaning and its translation, this verifier's framework."""
    missing, differ = [], []
    for rel in TRUSTED_FRAMEWORK_FILES:
        mine = file_sha(os.path.join(FRAMEWORK_HOME, rel))
        theirs = file_sha(os.path.join(fwdir, rel))
        if theirs is None:
            missing.append(rel)
        elif mine is None or theirs != mine:
            differ.append(rel)
    return missing, differ


def conf_refusal(path):
    """None when the quickproof.conf at `path` is data, assignments only (tools/conf.py, this verifier's copy),
    else why it is not.  Everything that sources a conf checks it first: a conf that ran commands could, among
    other things, change the framework after qp verify has compared it with its own."""
    import importlib.util
    sys.dont_write_bytecode = True
    spec = importlib.util.spec_from_file_location('qp_conf', os.path.join(TOOLS, 'conf.py'))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    try:
        m.check(open(path).read())
    except m.Bad as e:
        return '%s is not data, only assignments are allowed (tools/conf.py): %s' % (CONF, e)
    except OSError as e:
        return '%s: %s' % (CONF, e)
    return None


def release_of(commit):
    """Which QuickProof release tag of this verifier's repository names `commit`, as text for the report."""
    r = sh(['git', '-C', FRAMEWORK_HOME, 'tag', '--points-at', commit, '--list', 'v[0-9]*'], check=False, capture=True)
    tags = r.stdout.split() if r.returncode == 0 else []
    return 'release %s' % ', '.join(tags) if tags else 'not a release tag of this verifier\'s repository'


def framework_changed(d):
    """'' when the framework of the clone `d` still holds this verifier's trusted files and none of its tracked
    files has changed since the checkout; else what changed.  qp verify asks again after every step that runs
    something of the repository (the translation, the builds) and before the verdict."""
    missing, differ = framework_trusted_diff(os.path.join(d, FW))
    st = sh(['git', '-C', os.path.join(d, FW), 'status', '--porcelain', '--untracked-files=no'], check=False,
            capture=True).stdout.split('\n')
    changed = sorted(set(missing + differ + [x[3:] for x in st if x.strip()]))
    return ', '.join(changed)


def structure_problems(d):
    """Why `d` is not a QuickProof proof repository (an empty list: it is one): no framework submodule, no
    quickproof.conf, no law in harness/, or an _CoqProject that does not map the logical root QuickProof to the
    framework's coq/QuickProof (so the trusted Contract.v is what a statement's harness_safe resolves to)."""
    out = []
    if not git_head(os.path.join(d, FW)):
        out.append('no %s/ framework submodule (not a proof repository made by `qp assemble`)' % FW)
    if not os.path.exists(os.path.join(d, CONF)):
        out.append('no %s' % CONF)
    if not glob.glob(os.path.join(d, 'harness', '*.c')):
        out.append('no law in harness/')
    cp = os.path.join(d, '_CoqProject')
    text = open(cp).read() if os.path.exists(cp) else ''
    if not os.path.exists(cp):
        out.append('no _CoqProject')
    else:
        if not re.search(r'^-Q\s+%s/coq/QuickProof\s+QuickProof\s*$' % re.escape(FW), text, re.M):
            out.append('_CoqProject does not map QuickProof to %s/coq/QuickProof (-Q %s/coq/QuickProof QuickProof)' % (FW, FW))
        if not re.search(r'^-R\s+src\s+\S+\s*$', text, re.M):
            out.append('_CoqProject has no "-R src LOGICAL"')
    return out


def coqproject_problems(rel, text, strict):
    """The code-loading or logic-changing entries of one _CoqProject text (`rel`: its path, for messages).
    strict (the main build): only -Q, -R and -arg (warning controls); a run/prebuild project (strict=False) may
    pass coqc other flags, but never one that loads code or changes the logic."""
    out = []
    toks = []
    for line in text.splitlines():
        line = line.split('#', 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if parts[0].startswith('-'):
            toks.append(parts)
        else:
            for f in parts:
                if f.endswith(PLUGIN_EXT):
                    out.append('%s loads or builds an OCaml plugin file (%s)' % (rel, f))
    for parts in toks:
        flag = parts[0]
        if flag in DANGEROUS_COQ_FLAGS:
            out.append('%s has the option %s (it loads code or changes the logic)' % (rel, flag))
        elif flag == '-arg':
            for a in parts[1:]:
                if a in DANGEROUS_COQ_FLAGS or a.endswith(PLUGIN_EXT):
                    out.append('%s passes %s through -arg (it loads code or changes the logic)' % (rel, a))
                elif strict and not COQPROJECT_ARG_OK.match(a):
                    out.append('%s passes %s through -arg (the main build allows only warning controls)' % (rel, a))
        elif strict and flag not in COQPROJECT_FLAGS_OK:
            out.append('%s has the option %s (the main build allows only %s)' % (rel, flag, ', '.join(sorted(COQPROJECT_FLAGS_OK))))
    return out


def unsafe_problems(d):
    """Code-loading / logic-changing constructs in a repository: plugin files tracked in it, _CoqProject options
    (main build and every run/prebuild project) outside the allow-list, and unsafe vernac in the proof's own
    Coq sources (the framework's trusted files are compared byte for byte, not scanned here)."""
    out = []
    tracked = sh(['git', '-C', d, 'ls-files'], capture=True).stdout.split('\n')
    for f in tracked:
        if f and f.endswith(PLUGIN_EXT) and not f.startswith(FW + '/'):
            out.append('the repository tracks an OCaml plugin file (%s); `qp verify` would build and load it' % f)
    cps = ['_CoqProject']
    try:
        cps += [os.path.join(pd, '_CoqProject') for pd in prebuild_dirs(d)]
    except ValueError:
        pass
    for rel in cps:
        f = os.path.join(d, rel)
        if os.path.exists(f):
            out += coqproject_problems(rel, open(f, errors='replace').read(), strict=(rel == '_CoqProject'))
    for f in coq_sources(d):
        m = UNSAFE_VERNAC.search(blank_comments(open(f, errors='replace').read()))
        if m:
            out.append('%s: %s (loads code or disables a kernel check)' % (os.path.relpath(f, d), ' '.join(m.group(1).split())))
    return out


def preconditions(d):
    """The checks qp verify makes before it builds anything: `d` is a QuickProof proof repository
    (structure_problems), its framework's trusted files are this verifier's (framework_trusted_diff), and nothing
    in it loads code or disables a kernel check (unsafe_problems).  Returns (report lines, refusals): PASS needs
    no refusal."""
    refusals = ['not a QuickProof proof repository: ' + x for x in structure_problems(d)]
    if refusals:
        return [], refusals
    missing, differ = framework_trusted_diff(os.path.join(d, FW))
    if missing or differ:
        return [], ['%s/ is not the framework of this verifier: %s; check the proof with the qp of the QuickProof '
                    'release it pins' % (FW, '; '.join(x for x in ('missing ' + ', '.join(missing) if missing else '',
                                                                   'changed ' + ', '.join(differ) if differ else '') if x))]
    lines = ['- framework trusted files (%d: the statement, the libc, the translation chain): identical to this '
             'verifier (%s)' % (len(TRUSTED_FRAMEWORK_FILES), FRAMEWORK_HOME)]
    conf = conf_refusal(os.path.join(d, CONF))
    return lines, ['refused (loads code or disables a check): ' + x for x in unsafe_problems(d)] + \
        (['refused (runs commands): ' + conf] if conf else [])


def coqchk(d):
    """coqchk on every compiled module of the proof (src/) and of the framework's Coq library, each with -norec:
    Coq's separate checker re-checks every proof term of the repository and takes the toolchain's libraries (VST,
    CompCert, Coq's) as compiled.  The load path is that of _CoqProject.  Returns (report line, ok)."""
    loadpath = shlex.split(' '.join(l for l in open(os.path.join(d, '_CoqProject')) if l.lstrip().startswith(('-Q', '-R'))))
    mods = ['QuickProof.' + os.path.basename(f)[:-3] for f in sorted(glob.glob(os.path.join(d, FW, 'coq', 'QuickProof', '*.vo')))]
    mods += [module_of(d, os.path.relpath(f, d)[:-1]) for f in sorted(glob.glob(os.path.join(d, 'src', '**', '*.vo'), recursive=True))]
    r = sh(['coqchk', '-silent'] + loadpath + [x for m in mods for x in ('-norec', m)], cwd=d, coq=True, check=False, capture=True)
    open(os.path.join(d, 'coqchk.log'), 'w').write(r.stdout or '')
    ok = r.returncode == 0 and bool(mods)
    return ('- coqchk: %s (%d modules of the proof and the framework re-checked; the libraries of the toolchain taken as '
            'compiled)' % ('OK' if ok else '**FAILED** (coqchk.log)', len(mods)), ok)


def sh(cmd, cwd=None, check=True, capture=False, env=None, timeout=None, coq=False):
    """Run a command (list, or a string for bash).  coq=True: with the toolchain's environment (opam_env)."""
    if isinstance(cmd, str):
        cmd = ['bash', '-c', cmd]
    e = dict(os.environ)
    if coq:
        e.update(opam_env())
    if env:
        e.update(env)
    try:
        r = subprocess.run(cmd, cwd=cwd, env=e, text=True, timeout=timeout, errors='replace',
                           stdout=subprocess.PIPE if capture else None,
                           stderr=subprocess.STDOUT if capture else None)
    except subprocess.TimeoutExpired as t:
        if check:
            die('timeout: %s' % ' '.join(cmd))
        return subprocess.CompletedProcess(cmd, 124, (t.stdout or b'').decode(errors='replace') if isinstance(t.stdout, bytes) else (t.stdout or ''))
    if check and r.returncode != 0:
        die('failed (%d): %s\n%s' % (r.returncode, ' '.join(cmd)[:300], (r.stdout or '')[-3000:]))
    return r


_OPAM = None


def opam_env():
    """The toolchain's environment (Coq, VST, CompCert): that of the opam switch QP_OPAM_SWITCH, or none (the
    toolchain in PATH)."""
    global _OPAM
    if _OPAM is None:
        env = {}       # set _OPAM only when complete: commands run from several threads (qp fidelity --interp)
        if SITE['QP_OPAM_SWITCH']:
            out = subprocess.run(['opam', 'env', '--switch=' + SITE['QP_OPAM_SWITCH'], '--set-switch'],
                                 capture_output=True, text=True, check=True).stdout
            env = dict(re.findall(r"^(\w+)='([^']*)'", out, re.M))
        _OPAM = env
    return _OPAM


def source(path, names, gp=''):
    """The values of bash variables/arrays `names` after sourcing `path` (from its directory, with $GP set).  A
    quickproof.conf must be data (conf_refusal)."""
    if os.path.basename(path) == CONF:
        why = conf_refusal(path)
        if why:
            die('%s: %s' % (path, why))
    script = ('cd "$(dirname "$1")"; GP="$2"; INC=(); DEFS=(); UNITS=(); source "$1" >/dev/null; shift 2\n'
              'for n in "$@"; do eval \'a=("${\'"$n"\'[@]}")\'; printf "%s\\0" "${a[@]}"; printf "\\001\\0"; done')
    out = subprocess.run(['bash', '-c', script, '_', os.path.realpath(path), gp] + names,
                         capture_output=True, text=True, check=True).stdout
    vals, cur = [], []
    for item in out.split('\0')[:-1]:
        if item == '\x01':
            vals.append([x for x in cur if x != '']); cur = []
        else:
            cur.append(item)
    return dict(zip(names, vals))


