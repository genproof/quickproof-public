def new(name, url, ref, framework=None):
    d = os.path.join(WORKSPACE, 'projects', name)
    if os.path.exists(d):
        die('%s exists' % d)
    if not re.fullmatch(r'[A-Za-z0-9][\w.-]*', name):
        die('project name %s: letters, digits, `.`, `_` and `-` only' % name)
    if not is_url(url):
        url = os.path.realpath(os.path.expanduser(url))        # a local repository
    repo = upstream_repo(url)
    if not ref:
        tags = sh(['git', '-C', repo, 'tag', '--sort=-v:refname'], capture=True).stdout.split()
        rel = [t for t in tags if re.fullmatch(r'(v|r|release-)?\d+(\.\d+)*', t)]
        ref = rel[0] if rel else ('origin/HEAD' if resolve_commit(repo, 'origin/HEAD') else 'HEAD')
    commit = resolve_commit(repo, ref) or die('%s: no commit %s' % (url, ref))
    if framework:
        fw = framework_repo(framework)[1]
        fw_note = 'framework %s' % framework
    else:
        fw = git_head(SITE['QP_FRAMEWORK_DIR'] or FRAMEWORK_HOME) or ''
        fw_note = 'the HEAD of the framework checkout' if fw else 'empty: the framework checkout qp belongs to'
