#!/usr/bin/env python3
"""A stand-in for Claude Code, for testing `qpdemo prove` without a key (tests/prove_fake.sh).  It answers
`--version`, `auth status`, `mcp ...`, and in print mode (-p) it plays a scripted agent:

  FAKE_CLAUDE_MODE=solve2   round 1 writes the specifications and body proofs (src/proof/) but leaves the
                            theorem Admitted, so the judge fails; round 2 (--resume) writes the contract's proof
                            (src/contracts/), so the judge passes.  The files come from FAKE_CLAUDE_SOLUTION, a
                            known proof of the template's law (docker/tests/count_byte_ok).
  FAKE_CLAUDE_MODE=stuck    every round adds a comment to a proof file and uses min(3, --max-turns) turns,
                            never proving anything: the budget must end the run.

It checks the flags that qpdemo prove must pass (headless stream-json, permission mode dontAsk, the allowed
tools, the MCP config with the server rocq, --max-turns), starts that MCP server once and lists its tools (so
the config is known to work), and appends its argv and findings to FAKE_CLAUDE_LOG as JSON lines."""
import json
import os
import shutil
import subprocess
import sys
import uuid

args = sys.argv[1:]
LOG = os.environ.get('FAKE_CLAUDE_LOG', '/tmp/fake-claude.log')


def log(**kw):
    with open(LOG, 'a') as f:
        f.write(json.dumps(kw) + '\n')


def opt(name, default=None):
    return args[args.index(name) + 1] if name in args else default


if args[:1] in (['--version'], ['-v']):
    print('0.0.0 (fake Claude Code for tests)')
    sys.exit(0)
if args[:2] == ['auth', 'status']:
    print(json.dumps({'loggedIn': True, 'authMethod': 'fake'}))
    sys.exit(0)
if args[:1] == ['mcp']:
    log(mcp=args)
    sys.exit(0)
if '-p' not in args and '--print' not in args:
    print('fake claude: only print mode is scripted', file=sys.stderr)
    sys.exit(2)


def emit(ev):
    print(json.dumps(ev), flush=True)


def mcp_tools(conf):
    """initialize + tools/list on the configured server rocq, over stdio (plain JSON-RPC)."""
    srv = conf['mcpServers']['rocq']
    p = subprocess.Popen([srv['command']] + srv.get('args', []), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True, env=dict(os.environ, **srv.get('env', {})))
    def send(m):
        p.stdin.write(json.dumps(m) + '\n'); p.stdin.flush()
    def recv(i):
        for line in p.stdout:
            m = json.loads(line)
            if m.get('id') == i:
                return m
    send({'jsonrpc': '2.0', 'id': 1, 'method': 'initialize', 'params': {
        'protocolVersion': '2025-06-18', 'capabilities': {}, 'clientInfo': {'name': 'fake-claude', 'version': '0'}}})
    recv(1)
    send({'jsonrpc': '2.0', 'method': 'notifications/initialized'})
    send({'jsonrpc': '2.0', 'id': 2, 'method': 'tools/list'})
    tools = [t['name'] for t in recv(2)['result']['tools']]
    p.stdin.close(); p.terminate()
    return tools


problems = []
prompt = opt('-p') or opt('--print')
if opt('--output-format') != 'stream-json' or '--verbose' not in args:
    problems.append('not --output-format stream-json --verbose')
if opt('--permission-mode') != 'dontAsk':
    problems.append('permission mode is %s, not dontAsk' % opt('--permission-mode'))
allowed = (opt('--allowedTools') or '').split(',')
for need in ('Edit(/src/**)', 'mcp__rocq', 'Bash(qpdemo verify *)', 'Bash(qpdemo build *)'):
    if need not in allowed:
        problems.append('allowed tools lack %s' % need)
for bad in ('Bash', 'Edit', 'Write', 'Bash(*)'):
    if bad in allowed:
        problems.append('allowed tools are too broad: %s' % bad)
if '--strict-mcp-config' not in args or not opt('--mcp-config'):
    problems.append('no --mcp-config with --strict-mcp-config')
max_turns = int(opt('--max-turns', '0'))
if max_turns <= 0:
    problems.append('no --max-turns')
resume = opt('--resume')
session = resume or str(uuid.uuid4())
tools = []
if opt('--mcp-config') and not resume:
    try:
        tools = mcp_tools(json.load(open(opt('--mcp-config'))))
    except Exception as e:  # noqa: BLE001
        problems.append('MCP server rocq did not answer: %r' % e)
if not resume and tools and 'rocq_start' not in tools:
    problems.append('MCP server rocq has no rocq_start')
log(argv=args, cwd=os.getcwd(), max_turns=max_turns, resume=resume, mcp_tools=tools, problems=problems,
    prompt_head=(prompt or '')[:200])

emit({'type': 'system', 'subtype': 'init', 'session_id': session, 'model': 'fake-model',
      'mcp_servers': [{'name': 'rocq', 'status': 'connected' if tools or resume else 'failed'}], 'tools': tools})
if problems:
    emit({'type': 'result', 'subtype': 'error_during_execution', 'is_error': True, 'num_turns': 0,
          'session_id': session, 'total_cost_usd': 0, 'result': 'fake claude: ' + '; '.join(problems)})
    sys.exit(1)

mode = os.environ.get('FAKE_CLAUDE_MODE', 'solve2')
sol = os.environ.get('FAKE_CLAUDE_SOLUTION', '/solution')
repo = os.getcwd()


def tool(name, inp, out):
    i = 'toolu_' + uuid.uuid4().hex[:12]
    emit({'type': 'assistant', 'session_id': session, 'message': {'role': 'assistant', 'content': [
        {'type': 'tool_use', 'id': i, 'name': name, 'input': inp}]}})
    emit({'type': 'user', 'session_id': session, 'message': {'role': 'user', 'content': [
        {'type': 'tool_result', 'tool_use_id': i, 'content': out}]}})


def say(text):
    emit({'type': 'assistant', 'session_id': session, 'message': {'role': 'assistant', 'content': [
        {'type': 'text', 'text': text}]}})


def copy(rel):
    os.makedirs(os.path.dirname(os.path.join(repo, rel)), exist_ok=True)
    shutil.copy(os.path.join(sol, rel), os.path.join(repo, rel))
    tool('Write', {'file_path': os.path.join(repo, rel)}, 'written')


used = 0
if mode == 'solve2':
    tool('Read', {'file_path': os.path.join(repo, 'AGENTS.md')}, '(the brief)')
    part = 'src/proof' if not resume else 'src/contracts'
    for f in sorted(os.listdir(os.path.join(sol, part))):
        copy(os.path.join(part, f))
    say('The specifications and body proofs are written; the theorem is next.' if not resume else
        'The proof of main and the theorem are written.')
    used = 1 + len(os.listdir(os.path.join(sol, part)))
    subtype = 'success'
else:   # stuck
    used = min(3, max_turns)
    os.makedirs(os.path.join(repo, 'src', 'proof'), exist_ok=True)
    with open(os.path.join(repo, 'src', 'proof', 'Attempt.v'), 'a') as f:
        f.write('(* attempt %s *)\n' % uuid.uuid4().hex[:6])
    for _ in range(used):
        tool('mcp__rocq__rocq_check', {'body': 'start_function.', 'from_state': 1}, 'goals ...')
    say('Still working on the loop invariant.')
    subtype = 'error_max_turns' if used >= max_turns else 'success'
emit({'type': 'result', 'subtype': subtype, 'is_error': subtype != 'success', 'num_turns': used,
      'session_id': session, 'total_cost_usd': 0.01 * used,
      'usage': {'input_tokens': 100 * used, 'output_tokens': 10 * used, 'cache_read_input_tokens': 1000 * used,
                'cache_creation_input_tokens': 0},
      'result': 'fake round done'})
