EXAMPLES = os.path.join(FRAMEWORK_HOME, 'examples')
# the commits qp examples makes carry this date: the same files give the same commits in every run
EXAMPLE_DATE = '2026-01-01T00:00:00+00:00'
EXAMPLE_GIT = ['git', '-c', 'user.name=quickproof', '-c', 'user.email=quickproof@localhost',
               '-c', 'init.defaultBranch=main', '-c', 'commit.gpgsign=false']


def example_names():
    if not os.path.isdir(EXAMPLES):
        return []
    return sorted(n for n in os.listdir(EXAMPLES) if os.path.isfile(os.path.join(EXAMPLES, n, 'project.conf')))


def commit_all(d, msg):
    """git init (if needed), add everything and commit in d, with qp examples' identity and date."""
    if not os.path.isdir(os.path.join(d, '.git')):
        sh(EXAMPLE_GIT + ['init', '-q', d], capture=True)
    sh(EXAMPLE_GIT + ['-C', d, 'add', '-A'], capture=True)
    sh(EXAMPLE_GIT + ['-C', d, 'commit', '-q', '-m', msg], capture=True)
    return sh(['git', '-C', d, 'rev-parse', 'HEAD'], capture=True).stdout.strip()


def framework_snapshot(dest):
    """A git repository of the framework's files as they are on disk, for a checkout with uncommitted changes or
    one that is not a git checkout (a release archive): the tracked and untracked files of a git checkout (not
    the ignored ones), else every file but .git, build products and tools/site.conf.  Returns its path."""
    shutil.rmtree(dest, ignore_errors=True)
    os.makedirs(dest)
    if git_head(FRAMEWORK_HOME):
        files = sh(['git', '-C', FRAMEWORK_HOME, 'ls-files', '-z', '-c', '-o', '--exclude-standard'],
                   capture=True).stdout.split('\0')
    else:
        files = []
        for dp, dns, fns in os.walk(FRAMEWORK_HOME):
            dns[:] = [x for x in dns if x not in ('.git', '__pycache__')]
            files += [os.path.relpath(os.path.join(dp, f), FRAMEWORK_HOME) for f in fns]
        files = [f for f in files if not BUILD_ARTIFACT.search(f) and f != os.path.join('tools', 'site.conf')]
    for f in sorted(set(files)):
        src = os.path.join(FRAMEWORK_HOME, f)
        if f and (os.path.isfile(src) or os.path.islink(src)):
            os.makedirs(os.path.dirname(os.path.join(dest, f)), exist_ok=True)
            shutil.copy2(src, os.path.join(dest, f), follow_symlinks=False)
    commit_all(dest, 'QuickProof: the files of %s' % FRAMEWORK_HOME)
    return dest


def examples(names, verbose=False):
    """qp examples [NAME..]: each example of examples/ checked as a proof is checked.  Its code (CODE of its
    project.conf) is committed to a scratch upstream repository, `qp assemble` writes the proof repository with
    the contract (tag `contract`), the files of its proof/ are committed on top, and `qp verify` checks the
    result.  The framework is this checkout at HEAD, or a snapshot of its files when it has uncommitted changes.
    Everything is written under $QP_CACHE/examples.  Returns the exit status: 0 iff every example passes."""
    global WORKSPACE
    have = example_names()
    names = names or have
    bad = [n for n in names if n not in have]
    if bad:
        die('no example %s in %s (there are: %s)' % (', '.join(bad), EXAMPLES, ', '.join(have) or 'none'))
    base = os.path.join(CACHE, 'examples')
    os.makedirs(base, exist_ok=True)
    os.environ.update(GIT_AUTHOR_DATE=EXAMPLE_DATE, GIT_COMMITTER_DATE=EXAMPLE_DATE)
    if git_head(FRAMEWORK_HOME) and not sh(['git', '-C', FRAMEWORK_HOME, 'status', '--porcelain'],
                                           capture=True).stdout.strip():
        SITE['QP_FRAMEWORK_DIR'] = FRAMEWORK_HOME
        print('qp examples: the framework is %s at %s' % (FRAMEWORK_HOME, git_head(FRAMEWORK_HOME)[:12]), flush=True)
    else:
        SITE['QP_FRAMEWORK_DIR'] = framework_snapshot(os.path.join(base, 'framework'))
        print('qp examples: the framework is a snapshot of the files of %s (%s), at %s' % (
            FRAMEWORK_HOME, 'uncommitted changes' if git_head(FRAMEWORK_HOME) else 'not a git checkout',
            SITE['QP_FRAMEWORK_DIR']), flush=True)
    results = []
    for name in names:
        t0 = time.time()
        ex, d = os.path.join(EXAMPLES, name), os.path.join(base, name)
        print('\n== examples/%s: the contract (qp assemble), then the proof from examples/%s/proof, then qp verify'
              % (name, name), flush=True)
        shutil.rmtree(d, ignore_errors=True)
        conf = open(os.path.join(ex, 'project.conf')).read()
        code = ' '.join(source(os.path.join(ex, 'project.conf'), ['CODE'])['CODE']).split()
        if not code or not os.path.isdir(os.path.join(ex, 'proof')):
            die('examples/%s: CODE is empty in project.conf, or there is no proof/' % name)
        up = os.path.join(d, 'upstream')
        for c in code:
            src = os.path.join(ex, c)
            if os.path.isdir(src):
                shutil.copytree(src, os.path.join(up, c))
            elif os.path.isfile(src):
                os.makedirs(os.path.dirname(os.path.join(up, c)), exist_ok=True)
                shutil.copy(src, os.path.join(up, c))
            else:
                die('examples/%s: %s (in CODE) does not exist' % (name, c))
        commit = commit_all(up, 'The code of the example %s' % name)
        pd = os.path.join(d, 'ws', 'projects', name)
        os.makedirs(pd)
        for f in (CONF, 'env.c', 'env', 'harness', 'patch'):
            s = os.path.join(ex, f)
            if os.path.isdir(s):
                shutil.copytree(s, os.path.join(pd, f))
            elif os.path.exists(s):
                shutil.copy(s, pd)
        conf = re.sub(r'^UPSTREAM=.*$', lambda m: 'UPSTREAM=' + shlex.quote(up), conf, flags=re.M)
        conf = re.sub(r'^COMMIT=.*$', 'COMMIT=' + commit, conf, flags=re.M)
        open(os.path.join(pd, 'project.conf'), 'w').write(conf)
        WORKSPACE = os.path.join(d, 'ws')
        repo = os.path.join(d, name)
        hs, _ = assemble(Project(name), repo)
        shutil.copytree(os.path.join(ex, 'proof'), repo, dirs_exist_ok=True)
        commit_all(repo, 'The proof of the example %s' % name)
        _, ok, res = verify(repo, 'HEAD', verbose=verbose, brief=sys.stdout.isatty() and sys.stderr.isatty())
        passed = verdict(ok, res)
        results.append((name, passed, time.time() - t0, len(hs)))
        print('%s examples/%s: %s (%s)' % ('PASS' if passed else 'FAIL', name,
                                          'every law proved' if passed else 'see the report above', secs(time.time() - t0)),
              flush=True)
    if len(results) > 1:
        print('\n' + '\n'.join('%-4s %-12s %d law%s  %s' % ('PASS' if ok else 'FAIL', n, k, '' if k == 1 else 's', secs(t))
                               for n, ok, t, k in results))
    return 0 if all(ok for _, ok, _, _ in results) else 1


def secs(t):
    """A duration for people: 1m05s."""
    t = int(round(t))
    return '%dm%02ds' % (t // 60, t % 60)


