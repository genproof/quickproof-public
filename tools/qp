def assemble(p, out, reuse=None, templates=None):
    """The proof repository of a project in `out`: the code under test (upstream at COMMIT + the project's
    files + PATCH), the framework as the submodule quickproof/ at the project's framework commit (recorded with
    the URL QP_FRAMEWORK_URL), the generated Clight and contracts (each law Admitted), _CoqProject and a
    .gitignore; one commit, tagged `contract`.  `templates`: a directory whose files are copied in as well, with
    their {KEY}s filled (write_templates).  `reuse`: an exported proof whose proved laws are copied in."""
    if os.path.exists(out):
        die('%s exists' % out)
    src, commit = framework_commit(p)
    materialize(p, out, True, framework=False)
    g = lambda *a: sh(['git'] + list(a), cwd=out, capture=True)
    g('init', '-q')
    # The submodule's repository is cloned from a local one that has the commit; .gitmodules records the URL.
    fwd = os.path.join(out, FW)
    sh(['git', 'clone', '-q', '--no-hardlinks', '--no-checkout', src, fwd], capture=True)
    sh(['git', '-C', fwd, 'checkout', '-q', '--detach', commit], capture=True)
    sh(['git', '-C', fwd, 'remote', 'set-url', 'origin', SITE['QP_FRAMEWORK_URL']], capture=True)
    g('-c', 'protocol.file.allow=always', 'submodule', 'add', '-q', SITE['QP_FRAMEWORK_URL'], FW)
    sh([FW + '/tools/clight.sh', CONF], cwd=out, coq=True, capture=True)
    sh(['python3', FW + '/tools/new_contract.py', CONF, p.logical, '--suite-exclude', ','.join(p.broken)],
       cwd=out, capture=True)
    open(os.path.join(out, '_CoqProject'), 'w').write(
        '-Q %s/coq/QuickProof QuickProof\n-R src %s\n%s/coq/QuickProof\nsrc\n' % (FW, p.logical, FW))
    open(os.path.join(out, '.gitignore'), 'w').write(GITIGNORE)
    hs = p.harnesses()
    templates = templates or SITE['QP_TEMPLATES']
    if templates:
        write_templates(p, out, templates, hs)
    reused = []
    if reuse:
        reused = reuse_proof(p, reuse, out)
    g('add', '-A')
    g('-c', 'user.name=quickproof', '-c', 'user.email=quickproof@localhost', 'commit', '-q', '-m',
      'Contract: %s, %d theorems (%s), upstream %s, quickproof %s%s' % (
          p.name, len(hs), ', '.join(h for h in hs if h not in reused) + ' Admitted', p.commit[:12], commit[:12],
          '; reused from proofs/%s: %s' % (reuse, ', '.join(reused)) if reuse else ''))
    g('tag', 'contract')
    return hs, reused


def toolchain_paths():
    """The toolchain's directories, for templates: VST's and CompCert's Coq libraries, the bin directory of coqc."""
    where = sh(['coqc', '-where'], coq=True, capture=True).stdout.strip().splitlines()[-1]
    coqc = shutil.which('coqc', path=opam_env().get('PATH', os.environ.get('PATH', '')))
    return dict(VST=os.path.join(where, 'user-contrib', 'VST'), COMPCERT=os.path.join(where, 'user-contrib', 'compcert'),
                OPAM_BIN=os.path.dirname(coqc) if coqc else '')


def template_values(p, out, hs):
    """The {KEY}s of templates for the proof repository `out` of p: PROJECT, LOGICAL, THEOREMS (each law
    with the first comment of its harness), CODE and NOT_COVERED (notes.md's sections), UNITS, CODE_FILES,
    UNIT_FILES, UNITS_GLOB, FROZEN_CONTRACTS (the contract files' declarations, JSON lines), FRAMEWORK (the
    framework's directory), REPO, WIKI, VST, COMPCERT, OPAM_BIN; and KEY for every QP_TEMPLATE_KEY in the
    environment."""
    b = notes_sections(p)
    fw = os.path.join(out, FW)
    units = [os.path.relpath(s, out) if not s.startswith(fw) else FW + '/' + os.path.relpath(s, fw)
             for s in conf_of_repo(out, fw)]
    frozen = frozen_units(out)
    for h in hs:
        c = open(os.path.join(out, 'src', 'contracts', h + '.v')).read()
        frozen.append('    "src/contracts/%s.v": %s' % (h, json.dumps(contract_decls(c))))
    vals = dict(
        PROJECT=p.name, LOGICAL=p.logical, FRAMEWORK=FW, REPO=out, WIKI=os.path.join(out, 'wiki'),
        THEOREMS='\n'.join('- `%s`: %s' % (h, wrap(harness_claim(os.path.join(out, 'harness', h + '.c')) or '(see the harness file)'))
                           for h in hs),
        CODE=b.get('code', '').strip() or '(see the upstream sources)',
        NOT_COVERED=b.get('not covered', '').strip() or '- other configurations than the flags of `%s`;' % CONF,
        UNITS=', '.join('`%s`' % u for u in units),
        CODE_FILES=', '.join('`%s`' % c for c in (p.code or ['everything outside %s/, harness/, src/' % FW])),
        FROZEN_CONTRACTS=',\n' + ',\n'.join(frozen),
        UNIT_FILES=unit_files_text(out)[0], UNITS_GLOB=unit_files_text(out)[1],
    )
    vals.update(toolchain_paths())
    vals.update({k[len('QP_TEMPLATE_'):]: v for k, v in os.environ.items() if k.startswith('QP_TEMPLATE_')})
    return vals


def write_templates(p, out, tdir, hs):
    """Copy every file of the template directory tdir to the same path in the proof repository `out`, with the
    {KEY}s of template_values filled in text files.  A placeholder left unfilled is reported."""
    tdir = os.path.realpath(os.path.expanduser(tdir))
    if not os.path.isdir(tdir):
        die('no template directory %s' % tdir)
    vals = template_values(p, out, hs)
    for d, _, fs in os.walk(tdir):
        for f in sorted(fs):
            rel = os.path.relpath(os.path.join(d, f), tdir)
            dst = os.path.join(out, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            data = open(os.path.join(d, f), 'rb').read()
            try:
                text = fill(data.decode(), vals)
            except UnicodeDecodeError:
                open(dst, 'wb').write(data)
                continue
            open(dst, 'w').write(text)
            shutil.copymode(os.path.join(d, f), dst)
            left = sorted(set(re.findall(r'\{([A-Z][A-Z0-9_]*)\}', text)))
            if left:
                print('qp: warning: %s: placeholders not filled: %s' % (rel, ', '.join(left)), file=sys.stderr)


def notes_sections(p):
    path = os.path.join(p.dir, 'notes.md')
    secs = {}
    if os.path.exists(path):
        cur = None
        for line in open(path):
            m = re.match(r'^## (.*)', line)
            if m:
                cur = m.group(1).strip().lower(); secs[cur] = ''
            elif cur:
                secs[cur] += line
    return {k: v.strip() for k, v in secs.items()}


def harness_claim(path):
    """The first comment of a harness file, joined into one paragraph, without a leading "Law:" or "Law NAME:"."""
    s = open(path).read()
    m = re.match(r'\s*((?://[^\n]*\n\s*)+|/\*.*?\*/)', s, re.S)
    if not m:
        return ''
    text = re.sub(r'^\s*(//|/\*+|\*/|\*)', '', m.group(1), flags=re.M)
    text = re.sub(r'\*/\s*$', '', text)
    lines = [l.strip() for l in text.split('\n')]
    text = ' '.join(l for l in lines if l)
    return re.sub(r'^(Harness|Law)(\s+\w+)?\s*:\s*', '', text)


def fill(text, vals):
    for k, v in vals.items():
        text = text.replace('{%s}' % k, v)
    return text


def wrap(text, indent='  ', width=110):
    out, line = [], ''
    for w in text.split():
        if line and len(line) + 1 + len(w) > width:
            out.append(line); line = indent + w
        else:
            line = (line + ' ' + w) if line else w
    return '\n'.join(out + [line])


def conf_of_repo(repo, fw):
    v = source(os.path.join(repo, CONF), ['UNITS'], fw)
    return [os.path.realpath(os.path.join(repo, u.split('=', 1)[0])) if not u.startswith(fw) else u.split('=', 1)[0]
            for u in v['UNITS'] if not u.split('=', 1)[1].startswith('src/harness/')]


def reuse_proof(p, label, out):
    """Copy an exported proof (proofs/LABEL), or a work-in-progress proof (a directory: another proving
    repository's work tree, unverified), into a freshly assembled repository: its proof files, and the contracts it
    proved, when their statement part is unchanged."""
    d = label if os.path.isdir(label) else os.path.join(p.dir, 'proofs', label)
    if not os.path.isdir(d):
        die('no exported proof %s' % d)
    seed = os.path.isdir(label)          # a work-in-progress seed proves nothing yet
    proved = set()
    if not seed and os.path.exists(os.path.join(d, 'PROOF.md')):
        m = re.search(r'Proved \(.*?\): (.*?)\.\n', open(os.path.join(d, 'PROOF.md')).read())
        proved = set(re.findall(r'`(\w+)`', m.group(1))) if m else set()
    reused = []
    for f in glob.glob(os.path.join(d, 'src', '**', '*.v'), recursive=True):
        rel = os.path.relpath(f, d)
        dst = os.path.join(out, rel)
        if rel.endswith('/code.v') or UNITS_FILE.match(rel):
            continue
        if rel.startswith('src/contracts/'):
            name = os.path.basename(rel)[:-2]
            if not os.path.exists(dst) or not keeps_statement(open(f).read(), open(dst).read()):
                print('not reused (contract changed): %s' % rel)
                continue
            if not seed and name not in proved:
                continue                 # an Admitted contract of the export: keep the fresh one
            if not seed:
                reused.append(name)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy(f, dst)
    wd = os.path.join(d, 'wiki')
    if os.path.isdir(wd):
        shutil.copytree(wd, os.path.join(out, 'wiki'), dirs_exist_ok=True)
    return reused


# The contract's unit files: src/units.v (LINK=all, one module per unit) or src/units/<Unit>.v (LINK=per-law,
# one file per unit; docs/LINKING.md).  Generated with the contract and frozen like it.
UNITS_FILE = re.compile(r'^src/units(\.v|/[^/]+\.v)$')


def unit_files(repo):
    """The contract's unit files of a repository (repository-relative), sorted."""
    out = ['src/units.v'] if os.path.exists(os.path.join(repo, 'src', 'units.v')) else []
    return out + sorted(os.path.relpath(f, repo) for f in glob.glob(os.path.join(repo, 'src', 'units', '*.v')))


def frozen_units(repo):
    """toolchain.json frozen_decls lines for the unit files."""
    out = []
    for rel in unit_files(repo):
        text = open(os.path.join(repo, rel)).read()
        decls = re.findall(r'^Module (\w+)\.', text, re.M) if rel == 'src/units.v' else \
            re.findall(r'^(?:#\[local\] Instance|Definition) (\w+)\b', text, re.M)
        out.append('    "%s": %s' % (rel, json.dumps(decls)))
    return out


def unit_files_text(repo):
    """The templates' name of the unit files ({UNIT_FILES}) and toolchain.json's glob of them ({UNITS_GLOB})."""
    if os.path.exists(os.path.join(repo, 'src', 'units.v')):
        return '`src/units.v`', '"src/units.v"'
    return ('`src/units/*.v` (one file per unit; per-law linking: each law\'s program links only the units its '
            'contract lists, and its `whole_prog_undefined` checks the link)', '"src/units/*.v"')


def contract_decls(text):
    """The declarations of a law's contract that a proof must not change, by name (for templates that list them, e.g.
    for a checker that finds declarations by name): the module Harness and what it declares (its CS and qp: a checker
    that does not parse a Module would freeze nothing by the name Harness alone), the links, whole_prog and
    (LINK=per-law) its check whole_prog_undefined."""
    m = re.search(r'^Module Harness\.\s*$(.*?)^End Harness\.', text, re.M | re.S)
    inner = re.findall(r'^\s*(?:#\[\w+\]\s*)?(?:Instance|Definition) (\w+)\b', m.group(1), re.M) if m else []
    return ['Harness'] + inner + re.findall(r'^(?:Definition|Lemma) (link_\w+|whole_prog|whole_prog_undefined)\b',
                                            text, re.M)


def keeps_statement(proof_text, fresh_text):
    """A contract with a proof keeps the fresh contract's statement part: its lines, in order (a proof
    may add Require lines and lemmas before the theorem).  `qp verify` checks the elaborated statement."""
    want = [l for l in (statement_part(fresh_text) or '').split('\n') if l.strip()]
    have = iter(proof_text.split('\n'))
    return bool(want) and all(any(l == h for h in have) for l in want)


def statement_part(text):
    """A contract up to and including its `Theorem ... .` line: everything but the proof."""
    m = re.search(r'^Theorem \w+ : harness_safe whole_prog\.\s*$', text, re.M)
    return text[:m.end()] if m else None


def statement_code(text):
    """The statement part of a contract as Coq reads it (coq_code), without its Require, Import and Export lines:
    a proof that proves its law in the contract file adds such lines for its lemmas.  For the warning of qp rebuild;
    qp verify compares the elaborated statements, which also catches an Import that changes what a name means."""
    part = statement_part(text)
    if part is None:
        return None
    return coq_code('\n'.join(l for l in blank_comments(part).split('\n')
                              if not re.match(r'\s*(From\s+\S+\s+)?(Require|Import|Export)\b', l)))


def program_part(text):
    """A contract up to and including its `Definition whole_prog` line: the program its law is about; with
    per-law linking also the check that follows it (`Lemma whole_prog_undefined ... Qed.`)."""
    m = re.search(r'^Definition whole_prog\b.*$', text, re.M)
    if not m:
        return None
    check = re.match(r'\s*(Local Open Scope string_scope\.\s*)?Lemma whole_prog_undefined\b.*?\bQed\.',
                     blank_comments(text[m.end():]), re.S)
    return text[:m.end() + (check.end() if check else 0)]


def suite_statement(text):
    """The `Theorem suite : ... .` of a suite contract (None for other files)."""
    m = re.search(r'^Theorem suite\s*:.*?\.\s*$', text, re.M | re.S)
    return m.group(0) if m else None


