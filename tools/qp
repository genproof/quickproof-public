    logical = re.sub(r'[^A-Za-z0-9]', '', name.title()) or 'Project'
    if not logical[0].isalpha():
        logical = 'P' + logical
    open(os.path.join(d, 'project.conf'), 'w').write(
        '# project %s (tools/qp, docs/QP.md)\nUPSTREAM=%s\nCOMMIT=%s   # %s\nFRAMEWORK=%s   # %s\n'
        'LOGICAL=%s\nCODE=""        # upstream paths the proof needs (empty: all)\nPATCH=""       # e.g. "python3 patch/idioms.py"\n'
        % (name, shlex.quote(url), commit, ref, fw, fw_note, logical))
    cs = sh(['git', '-C', repo, 'ls-tree', '-r', '--name-only', commit], capture=True).stdout.split()
    cfiles = [f for f in cs if f.endswith('.c') and not re.search(r'(^|/)(tests?|examples?|fuzz|bench\w*|contrib|programs?)/', f)]
    open(os.path.join(d, CONF), 'w').write(
        '# quickproof config for %s (quickproof/tools/clight.sh): the library units.  qp adds one unit per harness/*.c.\n'
        '# Per-law linking: each law\'s program links only the units its harness needs (docs/LINKING.md).\n'
        'LINK=per-law\n'
        'INC=(-I. -isystem "$(gcc -print-file-name=include)")\nDEFS=()\nUNITS=(\n%s  "$GP/libc/libc.c=src/libc"\n'
        '  "$GP/libc/malloc_unit.c=src/malloc"\n)\n' % (name, ''.join('#  "%s=src/%s"\n' % (f, re.sub(r'\W', '_', os.path.basename(f)[:-2])) for f in cfiles[:40])))
    open(os.path.join(d, 'STATUS.md'), 'w').write(
        '# %s: laws and their status\n\nUpstream %s (%s).\n\n| law (harness) | what it says | status |\n|---|---|---|\n'
        % (name, commit[:12], ref))
    print('created %s: upstream %s at %s (%s), framework %s' % (d, url, ref, commit[:12], fw[:7] or 'checkout'))
    print('next: CODE/PATCH in project.conf, UNITS in %s, laws in harness/, then `qp check %s`' % (CONF, name))


def _strip_c(s):
    s = re.sub(r'/\*.*?\*/', lambda m: re.sub(r'[^\n]', ' ', m.group(0)), s, flags=re.S)
    s = re.sub(r'//[^\n]*', lambda m: ' ' * len(m.group(0)), s)
    s = re.sub(r'"(\\.|[^"\\\n])*"', lambda m: '"' + ' ' * (len(m.group(0)) - 2) + '"', s)
    s = re.sub(r"'(\\.|[^'\\\n])'", lambda m: "'" + ' ' * (len(m.group(0)) - 2) + "'", s)
    return s
ALLOC_DEFS = ['-Dmalloc=quickproof_malloc', '-Dfree=quickproof_free']   # as quickproof/tools/clight.sh


def _line_of(lines, n, src):
    """(file, line) of line n (0-based) of a preprocessed unit, through its line markers."""
    for j in range(n, -1, -1):
        m = re.match(r'# (\d+) "([^"]+)"', lines[j])
        if m:
            return m.group(2), int(m.group(1)) + (n - j - 1)
    return src, n + 1


def clight_bitfield_composites(v_text):
    """{composite name: [bitfield members]} of a clightgen output (code.v): the composites of the unit that
    have Member_bitfield members.  clightgen emits only the composites the unit uses."""
    comp = v_text.split('Definition composites', 1)
    if len(comp) < 2:
        return {}
    comp = re.split(r'\nDefinition ', comp[1], 1)[0]
    out = {}
    for m in re.finditer(r'Composite (\w+) (?:Struct|Union)(.*?)(?=Composite \w+ (?:Struct|Union)|\Z)', comp, re.S):
        bs = re.findall(r'Member_bitfield (\w+)', m.group(2))
        if bs:
            out[m.group(1)] = bs
    return out


def vst_lint_unit(tree, src, inc, defs):
    """qp's VST lint of one unit, as clightgen sees it (preprocessed as quickproof/tools/clight.sh does: macros
    such as an error-return macro expanded, typedef'd anonymous composites tagged by tools/tag_anon.py).
    Returns (switches, decls, composites, error):
    - switches: 'file:line: ...' for every switch whose last case can fall off the end (switch_lint);
    - decls: [(file, line, tag)] for every struct/union declared with bitfield members in the project's
      sources (the preprocessed text; system headers excluded);
    - composites: {tag: [members]} for the composites with bitfield members in the generated Clight;
    - error: clightgen's first error line, or None.
    Locations are mapped back through the line markers."""
    gp = os.path.join(tree, FW)
    tmpd = tempfile.mkdtemp(prefix='qp-lint-')
    try:
        # stdout only: the preprocessor's warnings on stderr are not part of the unit
        r = subprocess.run(['clightgen', '-E'] + ALLOC_DEFS + defs + inc + ['-I' + os.path.join(gp, 'include'), src],
                           cwd=tree, env=dict(os.environ, **opam_env()), text=True, errors='replace',
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if r.returncode:
            err = next((l for l in r.stderr.splitlines() if 'rror' in l), r.stderr.strip()[:160])
            return [], [], {}, 'not preprocessed: %s' % err.strip()[:200]
        i_path = os.path.join(tmpd, 'unit.i')
        open(i_path, 'w').write(r.stdout)
        tag_anon = os.path.join(gp, 'tools', 'tag_anon.py')
        if os.path.exists(tag_anon):
            sh([sys.executable, tag_anon, i_path], check=False, capture=True)
        text = open(i_path, errors='replace').read()
        lines = text.split('\n')
        rel = lambda f: os.path.relpath(f, tree) if f.startswith('/') else f
        mine = lambda f: not f.startswith(('/usr', '<'))
        switches = []
        for msg, k in switch_lint(i_path):
            n = text[:k].count('\n')
            # the switch's own line: from the message
            n = int(msg.rsplit(':', 2)[-2]) - 1 if msg.count(':') >= 2 else n
            f, ln = _line_of(lines, n, src)
            if mine(f):
                switches.append('%s:%d: the last case of this switch does not end with break/return' % (rel(f), ln))
        decls = []
        for m in re.finditer(r'\b(struct|union)\b[^;{}()]*\{', text):
            depth, i = 0, m.end() - 1
            while i < len(text):
                depth += {'{': 1, '}': -1}.get(text[i], 0)
                if depth == 0:
                    break
                i += 1
            if re.search(r'[A-Za-z_]\w*\s*:\s*\d+\s*[;,]', _strip_c(text[m.end():i])):
                f, ln = _line_of(lines, text[:m.start()].count('\n'), src)
                t = re.match(r'(?:struct|union)\s+([A-Za-z_]\w*)', m.group(0))   # None: an anonymous one
                if mine(f):
                    decls.append((rel(f), ln, t.group(1) if t else None))
        v_path = os.path.join(tmpd, 'code.v')
        r = sh(['clightgen', '-normalize', i_path, '-o', v_path], cwd=tmpd, check=False, capture=True, coq=True)
        if r.returncode or not os.path.exists(v_path):
            err = next((l for l in (r.stdout or '').splitlines() if 'rror' in l), (r.stdout or '').strip()[:160])
            return switches, decls, {}, 'clightgen cannot translate it (as quickproof/tools/clight.sh runs it): %s' % \
                err.strip().replace(i_path, 'unit')[:200]
        comps = {c[1:] if c.startswith('_') else c: [b[1:] if b.startswith('_') else b for b in bs]
                 for c, bs in clight_bitfield_composites(open(v_path, errors='replace').read()).items()}
        return switches, decls, comps, None
    finally:
        shutil.rmtree(tmpd, ignore_errors=True)


def vst_lint(tree, units, inc, defs):
    """qp's VST lint of the units (library units and harnesses): (lint, info), lists of lines.
    lint, each to be fixed before proving (in the harness, or by an idiom patch in the code under test):
    - switches whose last case can fall off the end (VST's switch rule cannot prove them; lz4);
    - composites with bitfield members in the generated Clight (VST 2.15 has no bitfields: make_compspecs fails
      on the program);
    - units that clightgen cannot translate as quickproof/tools/clight.sh runs it (`-normalize`, no other option):
      the contract build would fail on them.
    info: the bitfield declarations in the project's sources.  CompCert drops the types a unit does not use, so a
    declaration that never reaches the Clight is harmless (for example a bitfield struct of a header); the source
    count is kept for reference only."""
    lint, decls, comps = set(), set(), {}
    for u in units:
        sw, ds, cs, err = vst_lint_unit(tree, u, inc, defs)
        lint |= set(sw)
        decls |= set(ds)
        if err:
            lint.add('%s: %s' % (u, err))
        for c, bs in cs.items():
            e = comps.setdefault(c, [set(), set()])
            e[0] |= set(bs); e[1].add(u)
    where = {}
    for f, ln, t in sorted(decls, key=lambda d: (d[0], d[1])):
        if t:
            where.setdefault(t, '%s:%d' % (f, ln))
    for c in sorted(comps):
        bs, us = comps[c]
        lint.add('%s: composite `%s` has bitfield members (%s) in the Clight of %s (VST has no bitfields: '
                 'make_compspecs fails)' % (where.get(c, sorted(us)[0]), c, ', '.join(sorted(bs)), ', '.join(sorted(us))))
    info = []
    if decls:
        unplaced = any(c not in where for c in comps)   # a composite with no tagged declaration: an anonymous one
        def fate(t):
            if t in comps:
                return 'in the Clight (lint above)'
            return 'anonymous: see the lint above' if t is None and unplaced else 'not in the Clight'
        info.append('%d bitfield declaration(s) in the sources, %d of them in the Clight. CompCert drops the types a '
                    'unit does not use, so a declaration not in the Clight needs nothing:'
                    % (len(decls), sum(1 for d in decls if d[2] in comps)))
        info += ['%s:%d: %s (%s)' % (f, ln, t or 'anonymous struct/union', fate(t))
                 for f, ln, t in sorted(decls, key=lambda d: (d[0], d[1]))]
    return sorted(lint), info


def lint_cmd(p, hs):
    """qp lint NAME [H..]: only the VST lint of `qp check` (library units + the harnesses), printed."""
    tree = materialize(p, tree_path(p, True, private=True), True)
    inc, defs, libs = conf_of(tree)
    harn = [os.path.relpath(h, tree) for h in sorted(glob.glob(tree + '/harness/*.c'))
            if not hs or os.path.basename(h)[:-2] in hs]
    lint, info = vst_lint(tree, libs + harn, inc, defs)
    lint += cone_lint(p, tree, p.harnesses(hs))
    print('== VST lint'); print('\n'.join(lint) or 'clean')
    if info:
        print('== info'); print('\n'.join(info))
    return 0 if not lint else 1


def switch_lint(path):
    """Switches whose last case can fall off the end: VST's switch rule cannot prove them (RA_normal of
    switch_ret_assert is FF), although CompCert defines them (found on lz4)."""
    s = _strip_c(open(path, errors='replace').read())
    out = []
    for m in re.finditer(r'\bswitch\s*\(', s):
        # find the body brace
        i = m.end(); depth = 1
        while depth: 
            if s[i] == '(': depth += 1
            elif s[i] == ')': depth -= 1
            i += 1
        j = s.index('{', i); depth = 0; k = j
        while True:
            if s[k] == '{': depth += 1
            elif s[k] == '}':
                depth -= 1
                if depth == 0: break
            k += 1
        body = s[j+1:k]
        # last label at depth 0 of body
        d = 0; last = None
        for mm in re.finditer(r'[{}]|\b(case\b[^:]*|default\s*):', body):
            t = mm.group(0)
            if t == '{': d += 1
            elif t == '}': d -= 1
            elif d == 0: last = mm.end()
        if last is None: continue
        tail = body[last:].strip()
        tail = re.sub(r'^\{(.*)\}$', r'\1', tail, flags=re.S).strip()
        if not re.search(r'(\bbreak|\breturn\b[^;]*|\bcontinue|\bgoto\s+\w+|\bcheck_failed\s*\(\s*\)|\babort\s*\(\s*\)|\bexit\s*\([^)]*\))\s*;\s*\}?\s*$', tail):
            line = s[:m.start()].count('\n') + 1
            out.append(('%s:%d: the last case of this switch does not end with break/return' % (path, line), k))
    return out


def clight_audit_module():
    """tools/clight_audit.py (the audit of a law's cone on the generated Clight)."""
    import importlib.util
    sys.dont_write_bytecode = True
    spec = importlib.util.spec_from_file_location('clight_audit', os.path.join(TOOLS, 'clight_audit.py'))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def clight_audit_tree(tree, laws):
    """{law: audit result} on a tree after quickproof/tools/clight.sh (each law: the library units + its harness)."""
    ca = clight_audit_module()
    gp = os.path.realpath(os.path.join(tree, FW))
    units = [u.split('=', 1) for u in source(os.path.join(tree, CONF), ['UNITS'], gp)['UNITS']]
    libs = [o for _, o in units if not o.startswith('src/harness/')]
    out = {os.path.basename(s_)[:-2]: o for s_, o in units if o.startswith('src/harness/')}
    return {law: ca.audit_law(tree, out.get(law, 'src/harness/' + law), libs) for law in laws}


def clight_blockers(tree, laws):
    """Lint lines for the blockers in the laws' cones (tools/clight.sh must have run in the tree)."""
    ca = clight_audit_module()
    res = clight_audit_tree(tree, laws)
    lines = []
    for law in sorted(res):
        for kind, cat, f, unit, txt in ca.blockers(res[law]):
            lines.append('%s, function %s (cone of law %s): %s' % (unit, f, law, cat))
    return sorted(set(lines))


def cone_lint(p, tree, laws=None):
    """The Clight part of the VST lint: in every law's cone, what VST cannot prove whatever the values (a switch on
    a long, goto, struct copies, parameters and results, builtins, externals outside the environment, byte copies
    of pointer-holding memory).  `tools/qp audit` lists them with the review items."""
    r = sh([FW + '/tools/clight.sh', CONF], cwd=tree, coq=True, check=False, capture=True)
    if r.returncode:
        return ['clightgen failed (tools/clight.sh): ' +
                ' '.join(l for l in (r.stdout or '').splitlines() if 'error' in l.lower())[:300]]
    return clight_blockers(tree, laws or p.harnesses())


def audit(p, laws, verbose, md):
    """`qp audit`: the Clight audit of every law's cone (tools/clight_audit.py), on the patched tree."""
    tree = materialize(p, tree_path(p, True, private=True), True)
    r = sh([FW + '/tools/clight.sh', CONF], cwd=tree, coq=True, check=False, capture=True)
    if r.returncode:
        die('clightgen failed:\n' + '\n'.join(l for l in (r.stdout or '').splitlines() if 'error' in l.lower())[:3000])
    ca = clight_audit_module()
    res = clight_audit_tree(tree, laws)
    text = ca.summary(res, verbose)
    print(text)
    if md:
        open(md, 'w').write('# %s: Clight audit of the laws\' cones\n\nBy `tools/qp audit` on upstream %s%s, quickproof %s.\n\n'
                            '```\n%s\n```\n' % (p.name, p.commit[:12], ' + patch' if p.patch else '', p.framework_label(), text))
        print('wrote %s' % md)
    return res


def check(p, hs, runs, iruns, k, mruns, itimeout):
    now = datetime.datetime.now().strftime('%Y-%m-%d %H:%M')
    tree = materialize(p, tree_path(p, True, private=True), True)
    inc, defs, libs = conf_of(tree)
    lint, lint_info = vst_lint(tree, libs + sorted(os.path.relpath(h, tree) for h in glob.glob(tree + '/harness/*.c')),
                               inc, defs)
    lint += cone_lint(p, tree)
    print('== VST lint'); print('\n'.join(lint) or 'clean')
    if lint_info:
        print('info: ' + '\n'.join(lint_info))
    print('== native runs'); f = fuzz(p, hs, runs)
    print('== interpreter'); i = interp(p, hs, iruns, itimeout)
    print('== mutants'); m = mutants(p, hs, k, mruns)
    s = mutant_summary(m)
    print(s)
    lines = ['# %s: harness check' % p.name, '', 'By `tools/qp check` on %s: upstream %s%s, quickproof %s.' % (
        now, p.commit[:12], ' + patch' if p.patch else '', p.framework_label()), '',
        '## Native runs (ASan/UBSan, %d runs per harness)' % runs, '',
        'A failure on the unmodified code is a candidate finding; on the patched code only, a patch problem.', '',
        '| harness | code | result |', '|---|---|---|']
    lines += ['| `%s` | %s | %s |' % r for r in f]
    lines += ['', '## CompCert interpreter (%d runs per harness)' % iruns, '',
              'A stop is undefined behaviour in the semantics of the theorem: a finding or an idiom to patch.', '',
              '| harness | result |', '|---|---|']
    lines += ['| `%s` | %s |' % (r[0], r[2]) for r in i]
    lines += ['', '## Mutants (%d runs per harness and mutant)' % mruns, '', s, '']
    lines += ['## VST lint', '', 'Constructs that are defined C but that VST cannot prove (switches falling off their end, composites with',
              'bitfield members in the generated Clight; and in the Clight of each law\'s cone, tools/clight_audit.py: switches on a',
              'non-int, goto, struct copies, parameters and results, builtins, externals outside the environment, byte copies of',
              'pointer-holding memory) (fix in the harness, or by an idiom patch in the code under test):', ''] + \
        (['- ' + l for l in lint] or ['clean']) + ['']
    if lint_info:
        lines += ['Info (not a lint failure): ' + lint_info[0], ''] + ['- ' + l for l in lint_info[1:]] + ['']
    open(os.path.join(p.dir, 'CHECK.md'), 'w').write('\n'.join(lines))
    print('wrote %s' % os.path.join(p.dir, 'CHECK.md'))


