def njobs(build=False):
    """The parallel jobs of a Coq build (build=True) or of the native runs of qp mutants and qp fidelity: QP_JOBS
    when it is set, else half the CPUs (at least 2) for a build and a quarter for runs."""
    if SITE['QP_JOBS']:
        if not SITE['QP_JOBS'].isdigit() or int(SITE['QP_JOBS']) < 1:
            die('QP_JOBS=%s: not a number of jobs; set it to a positive integer or leave it empty' % SITE['QP_JOBS'])
        return int(SITE['QP_JOBS'])
    n = os.cpu_count() or 4
    return max(2, n // 2) if build else max(1, n // 4)


