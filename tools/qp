        sp.choices[sys.argv[1]].print_usage()
        print('The options are described in docs/%s.md.'
              % {'import-fuzz': 'FUZZ-IMPORT', 'import-cbmc': 'IMPORT-CBMC', 'import-svcomp': 'SVCOMP'}[sys.argv[1]])
        sys.exit(0)
    a = ap.parse_args()
    if a.cmd == 'verify':
        if not os.path.isdir(os.path.join(a.repo, '.git')) and not os.path.isfile(os.path.join(a.repo, '.git')):
            die('%s: not a git repository (qp verify checks a commit of a proof repository)' % a.repo)
        brief = a.brief if a.brief is not None else sys.stdout.isatty() and sys.stderr.isatty()
        if a.jobs is not None:
            if a.jobs < 1:
                die('--jobs %d: not a number of jobs' % a.jobs)
            SITE['QP_JOBS'] = str(a.jobs)
        _, ok, res = verify(a.repo, a.rev, a.base, verbose=a.v, keep_going=a.keep_going, do_coqchk=a.coqchk, brief=brief,
                            fresh=a.fresh)
        sys.exit(0 if verdict(ok, res) else 1)
    if a.cmd == 'examples':
        sys.exit(examples(a.names, a.v))
    WORKSPACE = find_workspace(a.workspace, create=a.cmd == 'new')
    if a.cmd == 'new':
        return new(a.name, a.url, a.ref, a.framework)
    p = Project(a.name)
    if a.cmd == 'tree':
        print(materialize(p, os.path.realpath(a.out) if a.out else tree_path(p, not a.orig), not a.orig))
    elif a.cmd == 'fuzz' and a.libfuzzer:
        sys.exit(fuzz_libfuzzer(p, p.harnesses(a.harness), a.patched, a.nondet, a.seconds, a.out, a.build_only,
                                a.replay, a.lf_arg, cflags=a.lf_cflag))
    elif a.cmd == 'fuzz':
        fuzz(p, p.harnesses(a.harness), a.runs)
    elif a.cmd == 'interp':
        interp(p, p.harnesses(a.harness), a.runs, a.timeout)
    elif a.cmd == 'mutants':
        print(mutant_summary(mutants(p, p.harnesses(a.harness), a.k, a.runs)))
    elif a.cmd == 'lint':
        sys.exit(lint_cmd(p, a.harness))
    elif a.cmd == 'check':
        check(p, p.harnesses(a.harness), a.runs, a.interp_runs, a.k, a.mutant_runs, a.timeout)
    elif a.cmd == 'assemble':
        assemble(p, os.path.realpath(a.out), a.reuse, a.templates)
        print('assembled %s' % a.out)
    elif a.cmd == 'export':
        export(p, a.repo, a.rev, a.label, a.base, a.v)
    elif a.cmd == 'rebuild':
        rebuild(p, a.label)
    elif a.cmd == 'audit':
        res = audit(p, p.harnesses(a.harness), a.v, a.md)
        sys.exit(1 if any(clight_audit_module().blockers(r) for r in res.values()) else 0)
    elif a.cmd == 'import-fuzz':
        import_fuzz(p, a.target, a.opts)
    elif a.cmd == 'import-svcomp':     # tools/importers/svcomp.py
        sys.dont_write_bytecode = True
        sys.path.insert(0, os.path.join(TOOLS, 'importers'))
        import svcomp
        svcomp.main(sys.modules[__name__], p, a.opts)
    elif a.cmd == 'import-cbmc':      # tools/importers/cbmc.py, given this module as its interface to qp
        import importlib.util
        sys.dont_write_bytecode = True
        spec = importlib.util.spec_from_file_location('qp_import_cbmc', os.path.join(TOOLS, 'importers', 'cbmc.py'))
        m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
        sys.exit(m.main(sys.modules[__name__], p, a.proof, a.opts))
    elif a.cmd == 'replay':
        replay(p, a.law, a.inputs, a.interp, 'orig' if a.orig else 'patched', a.sequence, a.timeout)
    elif a.cmd == 'fidelity':
        fidelity(p, a.law, os.path.realpath(a.corpus), a.interp, a.interp_max_bytes, a.interp_timeout, a.fault,
                 a.out or os.path.join(p.dir, 'FIDELITY.md'), a.jobs or njobs())


if __name__ == '__main__':
    main()
