def find_workspace(arg=None, create=False):
    """The workspace: `arg` (--workspace), else QP_WORKSPACE, else the nearest ancestor of the current directory
    that has a projects/ directory.  create=True (qp new): the workspace gets projects/ if it has none, and
    without any workspace the current directory becomes one."""
    ws = arg or SITE['QP_WORKSPACE']
    if not ws:
        d = os.path.realpath(os.getcwd())
        while not os.path.isdir(os.path.join(d, 'projects')):
            if os.path.dirname(d) == d:
                if not create:
                    die('no workspace: pass --workspace DIR, set QP_WORKSPACE, or work in a directory with projects/ '
                        '(`qp new` makes one)')
                print('qp: no workspace found; the current directory becomes one (projects/)', file=sys.stderr)
                ws = os.getcwd()
                break
            d = os.path.dirname(d)
        else:
            return d
    ws = os.path.realpath(os.path.expanduser(ws))
    if not os.path.isdir(os.path.join(ws, 'projects')):
        if not create:
            die('%s is not a workspace (no projects/ directory)' % ws)
        os.makedirs(os.path.join(ws, 'projects'))
    return ws


class Project:
    def __init__(self, name):
        self.name = name
        self.dir = os.path.join(WORKSPACE, 'projects', name)
        conf = os.path.join(self.dir, 'project.conf')
        if not os.path.exists(conf):
            die('no project %s (%s missing)' % (name, conf))
        v = source(conf, ['UPSTREAM', 'COMMIT', 'FRAMEWORK', 'LOGICAL', 'CODE', 'PATCH', 'BROKEN', 'MUTATE'])
        one = lambda k: v[k][0] if v[k] else ''
        self.upstream, self.commit, self.framework, self.logical = one('UPSTREAM'), one('COMMIT'), one('FRAMEWORK'), one('LOGICAL')
        self.upstream_conf = self.upstream          # as written (recorded in provenance lines)
        self.code = ' '.join(v['CODE']).split()
        self.patch = one('PATCH')
        # laws known to be false (a finding): not counted by mutants, left out of the suite
        self.broken = ' '.join(v['BROKEN']).split()
        # files of the code under test to mutate besides the library units (headers with the implementation)
        self.mutate = ' '.join(v['MUTATE']).split()
        for k in ('upstream', 'commit', 'logical'):
            if not getattr(self, k):
                die('%s: %s not set' % (conf, k.upper()))
        if not is_url(self.upstream):
            # a local path (a git repository), relative to the project's directory
            self.upstream = os.path.realpath(os.path.join(self.dir, os.path.expanduser(self.upstream)))

    def harnesses(self, only=None):
        hs = sorted(os.path.basename(h)[:-2] for h in glob.glob(self.dir + '/harness/*.c'))
        if only:
            bad = [h for h in only if h not in hs]
            if bad:
                die('no harness %s in %s/harness' % (', '.join(bad), self.dir))
            hs = [h for h in hs if h in only]
        return hs

    def framework_label(self):
        """The framework of the project, for reports: the pin, or the checkout's HEAD."""
        if self.framework:
            return self.framework[:7] if re.fullmatch(r'[0-9a-f]{7,40}', self.framework) else self.framework
        d = SITE['QP_FRAMEWORK_DIR'] or FRAMEWORK_HOME
        head = git_head(d)
        return '%s (checkout)' % head[:7] if head else 'checkout'


def is_url(s):
    """s is a git URL (scheme://... or user@host:path), not a local path."""
    return re.match(r'^\w[\w+.-]*://|^[\w.-]+@[\w.-]+:', s) is not None


# Local clones copy the objects (`git clone --no-hardlinks`, or a file:// URL where git does the cloning itself,
# as `git submodule update` does): a plain local clone hard-links them, and git refuses the hard links that
# overlayfs makes for files of a lower layer ("hardlink different from source"), as in a Docker container.
def file_url(path):
    """A file:// URL of a local repository: git clones it through its transport, without hard links."""
    return 'file://' + os.path.abspath(path)


def cached_clone(url):
    """The path of the cache's clone of `url` (it may not exist yet)."""
    base = re.sub(r'\.git$', '', url.rstrip('/').split('/')[-1]) or 'repo'
    return os.path.join(CACHE, 'upstream', '%s-%s' % (base, hashlib.sha256(url.encode()).hexdigest()[:8]))


def upstream_repo(url, commit=None):
    """A clone of `url` in the cache, fetched again when it lacks `commit`."""
    repo = cached_clone(url)
    if not os.path.isdir(repo):
        os.makedirs(os.path.dirname(repo), exist_ok=True)
        sh(['git', 'clone', '-q', '--no-hardlinks', url, repo])
    elif commit is None or sh(['git', '-C', repo, 'cat-file', '-e', commit + '^{commit}'], check=False, capture=True).returncode:
        sh(['git', '-C', repo, 'fetch', '-q', '--tags', 'origin'])
    return repo


def git_head(d):
    """The HEAD commit of d when d is the top of a git working tree (not a directory inside another repository)."""
    if not d or not os.path.isdir(d):
        return None
    r = sh(['git', '-C', d, 'rev-parse', '--show-toplevel', 'HEAD'], check=False, capture=True)
    out = (r.stdout or '').split()
    if r.returncode or len(out) != 2 or os.path.realpath(out[0]) != os.path.realpath(d):
        return None
    return out[1]


def resolve_commit(repo, rev):
    r = sh(['git', '-C', repo, 'rev-parse', '-q', '--verify', rev + '^{commit}'], check=False, capture=True)
    return r.stdout.strip() if r.returncode == 0 else None


def framework_repo(rev):
    """(a local git repository of the framework that has `rev`, the commit): QP_FRAMEWORK_DIR or the framework
    qp belongs to when they have it, else a clone of QP_FRAMEWORK_URL in the cache."""
    for d in (SITE['QP_FRAMEWORK_DIR'], FRAMEWORK_HOME):
        if git_head(d):
            c = resolve_commit(d, rev)
            if c:
                return d, c
    repo = upstream_repo(SITE['QP_FRAMEWORK_URL'], rev)
    c = resolve_commit(repo, rev)
    if not c:
        die('framework %s: not found in %s' % (rev, SITE['QP_FRAMEWORK_URL']))
    return repo, c


def framework_commit(p):
    """(a local repository, the commit) of the framework that a proof repository of p gets as its submodule:
    the FRAMEWORK pin, or, when it is empty, the HEAD of the framework checkout (QP_FRAMEWORK_DIR, else the one
    qp belongs to)."""
    if p.framework:
        return framework_repo(p.framework)
    d = SITE['QP_FRAMEWORK_DIR'] or FRAMEWORK_HOME
    head = git_head(d)
    if not head:
        die('FRAMEWORK is empty in %s/project.conf and %s is not a git checkout: pin a framework commit'
            % (p.dir, d))
    if sh(['git', '-C', d, 'status', '--porcelain', '--untracked-files=no'], capture=True).stdout.strip():
        print('qp: warning: %s has uncommitted changes; the submodule is its HEAD %s' % (d, head[:12]),
              file=sys.stderr)
    return d, head


def framework_dir(pin):
    """The framework checkout of a tree: QP_FRAMEWORK_DIR (framework development), else, for an empty pin, the
    framework qp belongs to, else the files of the pinned commit (extracted once into the cache)."""
    if SITE['QP_FRAMEWORK_DIR']:
        return SITE['QP_FRAMEWORK_DIR']
    if not pin:
        return FRAMEWORK_HOME
    repo, commit = framework_repo(pin)
    d = os.path.join(CACHE, 'framework', commit[:12])
    if not os.path.isdir(d):
        os.makedirs(os.path.dirname(d), exist_ok=True)
        tmp = tempfile.mkdtemp(prefix=commit[:12] + '.', dir=os.path.dirname(d))
        sh('git -C %s archive %s | tar -x -C %s' % (shlex.quote(repo), commit, shlex.quote(tmp)))
        try:
            os.rename(tmp, d)
        except OSError:          # extracted by a concurrent qp
            shutil.rmtree(tmp, ignore_errors=True)
    return d


def harness_units(tree):
    return ['harness/%s=src/harness/%s' % (os.path.basename(h), os.path.basename(h)[:-2])
            for h in sorted(glob.glob(tree + '/harness/*.c'))]


def materialize(p, out, patched=True, commit=None, framework=None, project_files=None):
    """upstream at commit + the project's files (+ PATCH) in `out`, with quickproof/ -> the framework."""
    commit = commit or p.commit
    repo = upstream_repo(p.upstream, commit)
    if os.path.exists(out):
        shutil.rmtree(out)
    os.makedirs(out)
    sh('git -C %s archive %s -- %s | tar -x -C %s' % (shlex.quote(repo), commit, ' '.join(map(shlex.quote, p.code)),
                                                      shlex.quote(out)))
    src = project_files or p.dir
    for f in (CONF, 'env.c', 'env', 'harness', 'patch'):
        s = os.path.join(src, f)
        if os.path.isdir(s):
            shutil.copytree(s, os.path.join(out, f), dirs_exist_ok=True)
        elif os.path.exists(s):
            shutil.copy(s, out)
    conf = os.path.join(out, CONF)
    if not os.path.exists(conf):
        die('%s: no %s' % (src, CONF))
    listed = open(conf).read()
    extra = [u for u in harness_units(out) if u.split('=')[0] not in listed]
    if extra:
        with open(conf, 'a') as f:
            f.write('\n# one unit per harness/*.c (added by tools/qp)\nUNITS+=(\n%s\n)\n'
                    % '\n'.join('  "%s"' % u for u in extra))
    if framework is not False:
        os.symlink(framework or framework_dir(p.framework), os.path.join(out, FW))
    if patched and p.patch:
        sh(p.patch, cwd=out, capture=True)
    return out


def tree_path(p, patched, private=False):
    """The cached tree of a project; private=True: one for this process only (removed at exit), so that
    concurrent qp commands on one project do not rebuild each other's tree."""
    d = os.path.join(CACHE, 'trees', '%s-%s' % (p.name, hashlib.sha256(p.dir.encode()).hexdigest()[:8]),
                     'patched' if patched else 'orig')
    if private:
        d += '.%d' % os.getpid()
        import atexit
        atexit.register(shutil.rmtree, d, True)
    return d


def conf_of(tree):
    gp = os.path.realpath(os.path.join(tree, FW))
    v = source(os.path.join(tree, CONF), ['INC', 'DEFS', 'UNITS'], gp)
    units = [u.split('=', 1) for u in v['UNITS']]
    libs = [s for s, o in units if not o.startswith('src/harness/') and not os.path.realpath(os.path.join(tree, s)).startswith(gp + '/')]
    return v['INC'], v['DEFS'], libs


def variants(p):
    return [('patched', True), ('orig', False)] if p.patch else [('upstream', True)]

# ----------------------------------------------------------------------------------------------
# native runs, interpreter, mutants
# ----------------------------------------------------------------------------------------------

def env_file(tree, h):
    """The value distributions of law h in a tree: env/<h>.c, else env.c, else None (relative to the tree).
    env/<h>.c is used through a copy at the tree's root, env_<h>.c, so that its #include "..." resolve as
    env.c's do (relative to the root)."""
    src = os.path.join(tree, 'env', h + '.c')
    if os.path.exists(src):
        dst = os.path.join(tree, 'env_%s.c' % h)
        if not os.path.exists(dst) or open(dst, 'rb').read() != open(src, 'rb').read():
            shutil.copy(src, dst)
        return 'env_%s.c' % h
    return 'env.c' if os.path.exists(os.path.join(tree, 'env.c')) else None


# the provenance line of a law written by qp import-cbmc (tools/importers/cbmc.py)
CBMC_LAW = re.compile(r'^ \*   importer: +tools/qp import-cbmc\b', re.M)


def cbmc_law(tree, h):
    """Law h of a tree was imported from a CBMC proof harness (qp import-cbmc): its provenance says so."""
    try:
        with open(os.path.join(tree, 'harness', h + '.c'), errors='replace') as f:
            return CBMC_LAW.search(f.read(16384)) is not None
    except OSError:
        return False


class Native:
    """Native ASan/UBSan builds of a tree: library objects once, one binary per harness."""

    def __init__(self, tree):
        self.tree = tree
        self.inc, self.defs, self.libs = conf_of(tree)
        self.b = os.path.join(tree, 'build', 'qp')
        os.makedirs(self.b, exist_ok=True)
        self.env_objs = {}
        self.unresolved = {}     # law -> the functions defined nowhere that its link left unresolved
        gp = os.path.join(tree, FW)
        self.drv = self.cc(os.path.join(gp, 'runtime', 'fuzz_driver.c'), 'fuzz_driver.o', opt='-O1')

    def env_o(self, h):
        """The object of the law's env/<h>.c, or of the project's env.c (None: the framework's nondet_*)."""
        f = env_file(self.tree, h)
        if f and f not in self.env_objs:
            self.env_objs[f] = self.cc(f, f[:-2] + '.o', opt='-O1', extra=['-I' + FW + '/include'])
            if self.env_objs[f] is None:
                print('qp: warning: %s does not compile; %s runs with the framework\'s nondet_*' % (f, h), file=sys.stderr)
        return self.env_objs.get(f)

    def cc(self, src, obj, opt='-O1', extra=(), b=None):
        o = os.path.join(b or self.b, obj)
        r = sh(['gcc', opt, '-g', '-w'] + SAN + list(extra) + self.defs + self.inc + ['-c', src, '-o', o],
               cwd=self.tree, check=False, capture=True)
        return o if r.returncode == 0 else None

    def lib_objs(self, b=None, cwd=None):
        objs = []
        for i, s in enumerate(self.libs):
            o = os.path.join(b or self.b, 'lib%d.o' % i)
            r = sh(['gcc', '-O1', '-g', '-w'] + SAN + self.defs + self.inc + ['-c', s, '-o', o],
                   cwd=cwd or self.tree, check=False, capture=True)
            if r.returncode:
                return None, r.stdout
            objs.append(o)
        return objs, ''

    def harness_obj(self, h):
        return self.cc('harness/%s.c' % h, 'h_%s.o' % h, opt='-O0',
                       extra=['-fno-delete-null-pointer-checks', '-I' + FW + '/include', '-Iharness', '-Dmain=harness_main'])

    def link(self, hobj, objs, out, h):
        env = self.env_o(h)
        cmd = ['gcc'] + SAN + [hobj] + objs + [self.drv] + ([env] if env else []) + ['-o', out]
        r = sh(cmd, check=False, capture=True)
        if r.returncode and cbmc_law(self.tree, h):
            # As the native gate of qp import-cbmc links the law: functions that the harness code refers to and
            # nothing defines (CBMC tolerates them; stubs often refer to such functions without calling them) are
            # left unresolved, and a run that calls one fails.
            undefined = sorted(set(re.findall(r"undefined reference to `([^']+)'", r.stdout or '')))
            r = sh(cmd + ['-Wl,--unresolved-symbols=ignore-all'], check=False, capture=True)
            if r.returncode == 0:
                self.unresolved[h] = undefined
        return r.returncode == 0

    def unresolved_note(self, h):
        """'' or a note for the report of law h: the functions its link left unresolved."""
        u = self.unresolved.get(h)
        if not u:
            return ''
        return '; unresolved (defined nowhere, as CBMC allows): %s%s' % (', '.join(u[:4]), ', ...' if len(u) > 4 else '')

    def run(self, exe, runs, first=1, timeout_s=10, wall=900):
        r = sh([exe, str(runs), str(first), '0', str(timeout_s)], check=False, capture=True, timeout=wall,
               env=NATIVE_ENV)
        out = r.stdout or ''
        m = re.search(r'runs (\d+): ok (\d+), FAILED (\d+)', out)
        seeds = re.findall(r'^seed (\d+): (.*)$', out, re.M)
        if not m:
            return dict(runs=runs, failed=None, seeds=seeds, note='no summary (exit %d)' % r.returncode)
        return dict(runs=int(m.group(1)), failed=int(m.group(3)), seeds=seeds, note='')


def fuzz(p, hs, runs, quiet=False):
    rows = []
    for label, patched in variants(p):
        tree = materialize(p, tree_path(p, patched, private=True), patched)
        n = Native(tree)
        objs, err = n.lib_objs()
        if objs is None:
            rows += [(h, label, 'library build failed: ' + err.strip().splitlines()[-1][:80]) for h in hs]
            continue
        for h in hs:
            ho = n.harness_obj(h)
            exe = os.path.join(n.b, h)
            if not ho or not n.link(ho, objs, exe, h):
                res = 'build failed'
            else:
                r = n.run(exe, runs)
                res = r['note'] or ('ok (%d runs)' % r['runs'] if r['failed'] == 0 else
                                    'FAILED %d/%d, first: seed %s (%s)' % (r['failed'], r['runs'], r['seeds'][0][0], r['seeds'][0][1][:60])
                                    if r['seeds'] else 'FAILED %d/%d' % (r['failed'], r['runs']))
                res += n.unresolved_note(h)
            rows.append((h, label, res))
            if not quiet:
                print('%-20s %-9s %s' % rows[-1], flush=True)
    return rows


# ----------------------------------------------------------------------------------------------
# laws as libFuzzer targets (qp fuzz --libfuzzer; tools/fuzz/law_libfuzzer.c)
# ----------------------------------------------------------------------------------------------

LF_DRIVER = os.path.join(TOOLS, 'fuzz', 'law_libfuzzer.c')
# the law's entry points wrapped in the link of law.so: its heap is freed between inputs, exit ends a run
LF_WRAP = ('malloc', 'calloc', 'realloc', 'free', 'strdup', 'strndup', 'exit', '_exit', '_Exit')
LF_SAN = ['-fsanitize=address,undefined', '-fno-sanitize-recover=all']
# clang refuses by default some C that gcc only warns about (older code, shims): back to warnings, which -w hides
LF_CFLAGS = ['-fPIC', '-fsanitize=fuzzer-no-link'] + LF_SAN + [
    '-Wno-error=implicit-function-declaration', '-Wno-error=implicit-int', '-Wno-error=int-conversion',
    '-Wno-error=incompatible-pointer-types', '-Wno-error=incompatible-function-pointer-types']
# --nondet direct: the env file compiled with its nondet_* renamed (its other functions stay: hooks, knobs)
LF_RENAME = ['-D%s=qp_env_unused_%s' % (f, f) for f in ('nondet_u8', 'nondet_u32', 'nondet_size', 'nondet_bytes')]
# -malloc_limit_mb above the driver's max_allocation_size_mb (1024): a larger malloc returns NULL first
LF_ARGS = ['-rss_limit_mb=2048', '-malloc_limit_mb=4096', '-timeout=60', '-detect_leaks=0', '-print_final_stats=1']


def lf_env():
    """The environment of libFuzzer runs and replays: the native runs' (NATIVE_ENV), a symbolizer for clang's
    sanitizers, and the driver's per-process tally (QP_LF_STATS)."""
    e = dict(NATIVE_ENV, QP_LF_STATS='1')
    s = shutil.which('llvm-symbolizer') or (sorted(glob.glob('/usr/lib/llvm-*/bin/llvm-symbolizer')) or [None])[-1]
    if s:
        e['ASAN_SYMBOLIZER_PATH'] = s
    return e


class LibFuzzerBuild:
    """Laws of a tree as libFuzzer targets: for law h, OUT/fuzz and OUT/law.so built with clang (coverage, ASan,
    UBSan) from the units, flags and env file that `qp fuzz` builds natively (class Native), and OUT/replay, the
    standalone replay of tools/fuzz/law_libfuzzer.c built natively (gcc): one fresh process per input."""

    def __init__(self, tree, nondet, cflags=()):
        self.tree, self.nondet, self.cflags = tree, nondet, list(cflags)
        self.n = Native(tree)
        self.b = os.path.join(self.n.b, 'libfuzzer')
        os.makedirs(self.b, exist_ok=True)
        self.libs = None
        self.err = ''

    def clang(self, src, obj, opt, extra=()):
        o = os.path.join(self.b, obj)
        r = sh(['clang', opt, '-g', '-w'] + LF_CFLAGS + self.cflags + list(extra) + self.n.defs + self.n.inc + ['-c', src, '-o', o],
               cwd=self.tree, check=False, capture=True)
        if r.returncode:
            self.err = '%s: %s' % (src, ((r.stdout or '').strip().splitlines() or ['?'])[-1][:200])
            return None
        return o

    def common(self):
        """The library objects (clang and gcc) and the two drivers, once per tree."""
        if self.libs is not None:
            return self.libs_err
        self.libs, self.libs_err = [], ''
        for i, s in enumerate(self.n.libs):
            o = self.clang(s, 'lib%d.o' % i, '-O1')
            if not o:
                self.libs_err = 'library build failed (clang): ' + self.err
                return self.libs_err
            self.libs.append(o)
        self.glibs, err = self.n.lib_objs()
        if self.glibs is None:
            self.libs_err = 'library build failed (gcc): ' + (err.strip().splitlines() or ['?'])[-1][:200]
            return self.libs_err
        self.drv = os.path.join(self.b, 'law_libfuzzer.o')
        if sh(['clang', '-O1', '-g', '-c', LF_DRIVER, '-o', self.drv], check=False, capture=True).returncode:
            self.libs_err = 'driver build failed (clang)'
        self.gdrv = self.n.cc(LF_DRIVER, 'law_libfuzzer_standalone.o', opt='-O1', extra=['-DQP_LF_STANDALONE'])
        if not self.gdrv:
            self.libs_err = 'driver build failed (gcc)'
        return self.libs_err

    def build(self, h, out):
        """Builds law h into the directory out; returns an error message, or '' when built."""
        err = self.common()
        if err:
            return err
        os.makedirs(out, exist_ok=True)
        hflags = ['-fno-delete-null-pointer-checks', '-I' + FW + '/include', '-Iharness', '-Dmain=harness_main']
        ho = self.clang('harness/%s.c' % h, 'h_%s.o' % h, '-O0', hflags)
        if not ho:
            return 'harness build failed (clang): ' + self.err
        objs = [ho] + self.libs
        gobjs = [self.n.harness_obj(h)] + self.glibs
        if gobjs[0] is None:
            return 'harness build failed (gcc)'
        envf = env_file(self.tree, h)
        if envf:
            ren = LF_RENAME if self.nondet == 'direct' else []
            eo = self.clang(envf, 'env_%s.o' % h, '-O1', ['-I' + FW + '/include'] + ren)
            geo = self.n.cc(envf, 'lfenv_%s.o' % h, opt='-O1', extra=['-I' + FW + '/include'] + ren)
            if not eo or not geo:
                return 'env file build failed: ' + self.err
            objs.append(eo)
            gobjs.append(geo)
        so, exe, rep = (os.path.join(out, f) for f in ('law.so', 'fuzz', 'replay'))
        # law.so exports harness_main only: a shim's own calloc, strlen, ... (an allocation-failure knob can be a
        # calloc) must not interpose on the sanitizers, libFuzzer and the C library, as in a static link
        vs = os.path.join(self.b, 'law.map')
        open(vs, 'w').write('{ global: harness_main; local: *; };\n')
        # a name the law defines itself (a shim's calloc with an allocation-failure knob, or its own realloc) is not
        # wrapped: --wrap would send the law's calls past its own definition
        defined = set(sh(['nm', '--defined-only'] + objs, check=False, capture=True).stdout.split())
        wrap = [f for f in LF_WRAP if f not in defined]
        steps = [(['clang', '-shared'] + LF_SAN + objs + ['-o', so, '-Wl,-soname,law.so', '-Wl,-Bsymbolic', '-Wl,-z,now',
                   '-Wl,--version-script=' + vs] + ['-Wl,--wrap=' + f for f in wrap], 'law.so'),
                 (['clang', '-fsanitize=fuzzer,address,undefined', self.drv, so, '-Wl,-rpath,$ORIGIN', '-o', exe], 'fuzz'),
                 (['gcc'] + SAN + gobjs + [self.gdrv, '-o', rep], 'replay')]
        for cmd, what in steps:
            r = sh(cmd, cwd=self.tree, check=False, capture=True)
            if r.returncode:
                return 'link of %s failed: %s' % (what, ((r.stdout or '').strip().splitlines() or ['?'])[-1][:200])
        lf_name_links(out, h)
        return ''


def lf_name_links(out, h):
    """OUT/bin/LAW -> ../fuzz and OUT/native/LAW -> ../replay: the binaries are run under the law's name, as the
    native runs name theirs (an env file may read the program's name)."""
    for d, target in (('bin', 'fuzz'), ('native', 'replay')):
        os.makedirs(os.path.join(out, d), exist_ok=True)
        link = os.path.join(out, d, h)
        if os.path.lexists(link):
            os.remove(link)
        os.symlink(os.path.join('..', target), link)


def lf_bin(d, native=False):
    """The fuzzer (or the native replay) of the law built in d, by its law-named link (lf_name_links)."""
    return os.path.join(d, 'native' if native else 'bin', os.path.basename(os.path.normpath(d)))


def lf_stats(out):
    """execs, exec/s, cov, ft, corpus and the driver's tally, from a libFuzzer log."""
    st = {}
    m = re.search(r'stat::number_of_executed_units: (\d+)', out)
    st['execs'] = int(m.group(1)) if m else None
    m = re.search(r'stat::average_exec_per_sec: +(\d+)', out)
    st['rate'] = int(m.group(1)) if m else None
    m = re.findall(r'cov: (\d+) ft: (\d+) corp: (\d+)/', out)
    st['cov'], st['ft'], st['corp'] = (int(x) for x in m[-1]) if m else (None, None, None)
    m = re.search(r'^qp-libfuzzer: runs .*$', out, re.M)
    st['tally'] = m.group(0)[len('qp-libfuzzer: '):] if m else ''
    return st


LF_NOT_LAW = re.compile(r'^(gp_assert|qp_\w+|abort|raise|pthread_kill|__pthread_kill\w*|__sanitizer\w*|__asan\w*|__ubsan\w*|'
                        r'fuzzer::.*|__interceptor_\w+|___interceptor_\w+|main|__libc_\w+|_start|LLVMFuzzer\w+|check_failed)$')


def lf_verdict(rc, out):
    """(verdict, where) of one run of the fuzzer binary or of the standalone replay on an input: 'pass',
    'not covered (gp_assume)', 'abandoned (input exhausted)', or 'FAIL: <kind>'; where: the first stack frame in
    the law's code (function file:line), or ''."""
    where = ''
    for fn, loc in re.findall(r'#\d+ 0x[0-9a-f]+ in (\S+) (\S+:\d+)', out):
        if not LF_NOT_LAW.match(fn) and 'law_libfuzzer.c' not in loc and not loc.startswith(('/usr/', 'nptl/', 'stdlib/', 'signal/')):
            where = '%s %s' % (fn, os.path.basename(loc))
            break
    m = re.search(r'ERROR: AddressSanitizer: ([\w-]+)', out)
    if 'qp-libfuzzer: gp_assert failed' in out:
        v = 'FAIL: gp_assert'
    elif m:
        v = 'FAIL: ASan %s' % m.group(1)
        if m.group(1) == 'SEGV' and re.search(r'SEGV on unknown address 0x0+ ', out) and 'WRITE memory access' in out:
            v += ' (null store: a failed check?)'
    elif re.search(r'runtime error: ', out):
        v = 'FAIL: UBSan ' + re.search(r'runtime error: ([^\n]{0,90})', out).group(1)
    elif re.search(r'ERROR: libFuzzer: ([\w-]+)', out):
        v = 'FAIL: libFuzzer ' + re.search(r'ERROR: libFuzzer: ([\w-]+(?: [\w-]+)?)', out).group(1)
    elif re.search(r'Assertion .* failed', out):
        v = 'FAIL: assert()'
    elif ': not covered' in out or re.search(r'qp-libfuzzer: runs 1: completed 0, rejected by gp_assume 1', out):
        v = 'not covered (gp_assume)'
    elif ': abandoned' in out or re.search(r'qp-libfuzzer: runs 1: .*input exhausted 1', out):
        v = 'abandoned (input exhausted)'
    elif rc == 124:
        v = 'FAIL: timeout (replay)'
    elif rc == 0:
        v = 'pass'
    else:
        v = 'FAIL: exit %d' % rc
    return v, where


def lf_replay(d, inputs, timeout=120):
    """Each input replayed by the fuzzer binary (in-process, clang) and by the standalone replay (a fresh process,
    gcc, as the native runs): [(input, (verdict, where) of fuzz, (verdict, where) of replay)]."""
    rows = []
    for f in inputs:
        r1 = sh([lf_bin(d), f] + LF_ARGS, check=False, capture=True, timeout=timeout, env=lf_env())
        r2 = sh([lf_bin(d, native=True), f], check=False, capture=True, timeout=timeout, env=lf_env())
        rows.append((f, lf_verdict(r1.returncode, r1.stdout or ''), lf_verdict(r2.returncode, r2.stdout or '')))
    return rows


def lf_run(d, seconds, extra=()):
    """libFuzzer on the law built in d for `seconds`: corpus d/corpus, crashes in d/crashes, log appended to
    d/fuzz.log.  Returns (stats, new crash files)."""
    corpus, crashes = os.path.join(d, 'corpus'), os.path.join(d, 'crashes')
    os.makedirs(corpus, exist_ok=True)
    os.makedirs(crashes, exist_ok=True)
    before = set(os.listdir(crashes))
    cmd = [lf_bin(d), corpus, '-artifact_prefix=' + crashes + '/', '-max_total_time=%d' % seconds] + \
        LF_ARGS + list(extra)
    r = sh(cmd, check=False, capture=True, env=lf_env(), timeout=seconds + 900)
    out = r.stdout or ''
    with open(os.path.join(d, 'fuzz.log'), 'a') as f:
        f.write('$ %s\n%s\n' % (' '.join(map(shlex.quote, cmd)), out))
    return lf_stats(out), [os.path.join(crashes, c) for c in sorted(set(os.listdir(crashes)) - before)]


def fuzz_libfuzzer(p, hs, patched=False, nondet='env', seconds=60, out=None, build_only=False, replay=None,
                   extra=(), quiet=False, cflags=()):
    """qp fuzz --libfuzzer: each law as a coverage-guided libFuzzer target (tools/fuzz/law_libfuzzer.c) on the
    unmodified upstream (patched=True: the patched code), built in OUT/LAW/; then `seconds` of fuzzing per law, or
    with replay=[inputs] the replay of those inputs (one law).  Prints one line per law; returns 1 if a law failed."""
    variant = ('patched' if patched else 'orig') if p.patch else 'upstream'
    out = os.path.realpath(out) if out else os.path.join(
        CACHE, 'libfuzzer', '%s-%s' % (p.name, hashlib.sha256(p.dir.encode()).hexdigest()[:8]), '%s-%s' % (variant, nondet))
    tree = materialize(p, tree_path(p, patched or not p.patch, private=True), patched or not p.patch)
    lb = LibFuzzerBuild(tree, nondet, cflags)
    if replay and len(hs) != 1:
        die('--replay: name exactly one law')
    if not quiet:
        print('# %s (%s, --nondet %s): %s' % (p.name, variant, nondet, out), flush=True)
    failed = 0
    for h in hs:
        d = os.path.join(out, h)
        err = lb.build(h, d)
        if err:
            failed = 1
            print('%-20s %-9s %s' % (h, variant, err), flush=True)
            continue
        if build_only:
            print('%-20s %-9s built: %s' % (h, variant, lf_bin(d)), flush=True)
            continue
        if replay:
            for f, (v1, w1), (v2, w2) in lf_replay(d, [os.path.realpath(x) for x in replay]):
                failed |= v1.startswith('FAIL') or v2.startswith('FAIL')
                print('%s\n  libFuzzer build: %s%s\n  native replay:   %s%s' % (f, v1, ' at ' + w1 if w1 else '',
                                                                          v2, ' at ' + w2 if w2 else ''), flush=True)
            continue
        st, crashes = lf_run(d, seconds, extra)
        line = '%s execs (%s/s), cov %s, ft %s, corpus %s' % (st['execs'], st['rate'], st['cov'], st['ft'], st['corp'])
        if crashes:
            failed = 1
            (f, (v1, w1), (v2, w2)), = lf_replay(d, crashes[:1])
            line += '; CRASH %s: %s%s; native replay: %s' % (os.path.relpath(f, out), v1, ' at ' + w1 if w1 else '', v2)
        else:
            line += '; clean'
        print('%-20s %-9s %s' % (h, variant, line), flush=True)
        if st['tally'] and not quiet:
            print('%-20s %-9s   %s' % ('', '', st['tally']), flush=True)
    return failed


def interp(p, hs, runs, timeout, quiet=False):
    tree = materialize(p, tree_path(p, True, private=True), True)
    rows = []
    for h in hs:
        env = {'GP_ENV': os.path.join(tree, env_file(tree, h))} if env_file(tree, h) else {}
        r = sh([FW + '/tools/interp.sh', CONF, 'harness/%s.c' % h, '1', str(runs)], cwd=tree,
               check=False, capture=True, env=env, timeout=timeout, coq=True)
        out = r.stdout or ''
        if r.returncode == 124:
            seeds = re.findall(r'^seed (\d+)', out, re.M)
            res = 'timeout after %ds (%d runs started)' % (timeout, len(seeds))
        elif re.search(r'runs \d+: no stop', out):
            sk = re.search(r'runs \d+: no stop \((\d+) skipped', out)   # interp.sh: seeds that timed out (or a false gp_assume)
            res = 'ok (%d runs, no stop%s)' % (runs, '; %s timed out' % sk.group(1) if sk and sk.group(1) != '0' else '')
        else:
            seeds = re.findall(r'^seed (\d+)', out, re.M)
            stuck = re.search(r'(Stuck state.*(?:\n.*)?|ERROR.*|error.*)', out)
            res = 'STOP at seed %s: %s' % (seeds[-1] if seeds else '?', (' '.join(stuck.group(1).split()) if stuck else out.strip().splitlines()[-1] if out.strip() else 'exit %d' % r.returncode)[:160])
        rows.append((h, 'interp', res))
        if not quiet:
            print('%-20s %-9s %s' % rows[-1], flush=True)
    return rows


MUTATIONS = [(r'(?<![<>=!\-])<(?![<=])', '<='), (r'(?<![<])<=', '<'), (r'(?<![<>=\-])>(?![>=])', '>='),
             (r'(?<![>])>=', '>'), (r'==', '!='), (r'!=', '=='), (r'&&', '||'), (r'\|\|', '&&'),
             (r'(?<= )\+ 1(?![\w.])', '+ 0'), (r'(?<= )- 1(?![\w.])', '- 0')]
# integer literals: n -> n + 1 and n - 1 (off-by-one in constants, table sizes, shift amounts)
LITERAL = re.compile(r'(?<![\w.])(\d+)(?![\w.])')


def mutation_sites(tree, libs):
    sites = []
    for f in libs:
        path = os.path.join(tree, f)
        lines = open(path, errors='replace').read().split('\n')
        func, in_comment, pp = '?', False, False
        for i, line in enumerate(lines):
            if pp or line.lstrip().startswith('#'):
                pp = line.rstrip().endswith('\\')
                continue
            m = re.match(r'^(?:[A-Za-z_][\w \*]*?[\s\*])?(\w+)\s*\([^;]*$', line)
            if m and m.group(1) not in ('if', 'while', 'for', 'switch', 'return'):
                nxt = '\n'.join(lines[i:i + 40])
                if nxt.find('{') != -1 and (nxt.find(';') == -1 or nxt.find('{') < nxt.find(';')):
                    func = m.group(1)
            code = line
            if in_comment:
                if '*/' not in code:
                    continue
                code, in_comment = code.split('*/', 1)[1], False
            code = re.sub(r'/\*.*?\*/', '', code)
            if '/*' in code:
                code, in_comment = code.split('/*', 1)[0], True
            code = code.split('//', 1)[0]
            if code.lstrip().startswith('#') or not code.strip():
                continue
            code = re.sub(r'"(\\.|[^"\\])*"', lambda s: ' ' * len(s.group(0)), code)
            for k, (pat, rep) in enumerate(MUTATIONS):
                for m in re.finditer(pat, code):
                    sites.append((f, i, m.start(), m.end(), rep, func))
            for m in LITERAL.finditer(code):
                n = int(m.group(1))
                for v in ([n + 1, n - 1] if n > 0 else [1]):
                    sites.append((f, i, m.start(), m.end(), str(v), func))
    return sites


def mutants(p, hs, k, runs, seed=1, quiet=False):
    """k live mutants (compiled code differs), each run against every harness."""
    tree = materialize(p, tree_path(p, True, private=True), True)
    base = Native(tree)
    base_objs, err = base.lib_objs()
    if base_objs is None:
        die('library build failed:\n' + err)
    hs = [h for h in hs if h not in p.broken]
    hobjs = {h: base.harness_obj(h) for h in hs}
    # A harness that already fails on the unmutated code (a known finding) kills a mutant only on a
    # seed where the unmutated code passes.
    known = {}
    for h in hs:
        exe = os.path.join(base.b, 'base_' + h)
        if not (hobjs[h] and base.link(hobjs[h], base_objs, exe, h)):
            continue
        r = base.run(exe, runs, timeout_s=1, wall=600)
        if r['failed'] is None:      # no summary: the driver was killed (a loaded machine, or a crash); one lenient retry
            r = base.run(exe, min(runs, 50), timeout_s=10, wall=900)
        if r['failed'] is None:      # still no complete baseline: not usable (reported as excluded below)
            continue
        # the seeds where the unmutated code fails with a signal: a harness that fails there kills a mutant only on
        # a seed where the unmutated code passes.  A seed that times out ran slowly, for example on a loaded
        # machine; it is left out here, so a baseline whose every seed times out stays usable.
        known[h] = set(int(sd) for sd, note in r['seeds'] if '(timeout)' not in note)
        if len(known[h]) >= r['runs']:   # a real finding on every seed: cannot tell mutants apart
            del known[h]
    excluded = [h for h in hs if h not in known]
    if not quiet and any(known.values()):
        print('failing on the unmutated code (seeds ignored): %s' % ', '.join(
            '%s (%d)' % (h, len(v)) for h, v in known.items() if v), flush=True)
    hs = [h for h in hs if h in known]
    sites = mutation_sites(tree, base.libs + [f for f in p.mutate if f not in base.libs])
    random.Random(seed).shuffle(sites)
    jobs = njobs()
    work = os.path.join(CACHE, 'mutants', '%s.%d' % (p.name, os.getpid()))
    shutil.rmtree(work, ignore_errors=True)
    copies = []
    for j in range(jobs):
        c = os.path.join(work, 'w%d' % j)
        shutil.copytree(tree, c, symlinks=True, ignore=shutil.ignore_patterns('build'))
        os.makedirs(os.path.join(c, 'build'), exist_ok=True)
        copies.append(c)

    def stripped(copy, f, tag):
        o = os.path.join(copy, 'build', tag + '.o')
        r = sh(['gcc', '-O0', '-g0', '-w'] + base.defs + base.inc + ['-c', f, '-o', o], cwd=copy, check=False, capture=True)
        if r.returncode:
            return None
        sh(['strip', '--strip-all', '-R', '.comment', o])
        return open(o, 'rb').read()

    def stripped_all(copy, tag):
        # every library unit: a mutation of a header shows up in the units that include it
        out = b''
        for i, f in enumerate(base.libs):
            o = stripped(copy, f, '%s%d' % (tag, i))
            if o is None:
                return None
            out += o
        return out

    ref = {c: stripped_all(c, 'ref') for c in copies}

    def one(site, copy):
        f, i, a, b, rep, func = site
        path = os.path.join(copy, f)
        orig = open(path).read()
        lines = orig.split('\n')
        old = lines[i]
        lines[i] = old[:a] + rep + old[b:]
        open(path, 'w').write('\n'.join(lines))
        try:
            obj = stripped_all(copy, 'mut')
            if obj is None:
                return dict(site=site, status='nobuild')
            if obj == ref[copy]:
                return dict(site=site, status='dead')
            bdir = os.path.join(copy, 'build')
            objs, _ = base.lib_objs(b=bdir, cwd=copy)
            if objs is None:
                return dict(site=site, status='nobuild')
            killed = {}
            for h in hs:
                exe = os.path.join(bdir, 'm_' + h)
                if not hobjs[h] or not base.link(hobjs[h], objs, exe, h):
                    continue
                killed[h] = kill_run(base, exe, runs, ignore=known[h])
            return dict(site=site, status='live', killed={h: v == 'killed' for h, v in killed.items()},
                        hang=any(v == 'hang' for v in killed.values()), text=old.strip()[:90], new=rep)
        finally:
            open(path, 'w').write(orig)

    results, live = [], 0
    it = iter(sites)
    with cf.ThreadPoolExecutor(jobs) as ex:
        free = list(copies)
        pending = {}
        while live < k:
            while free and live + len(pending) < k:
                s = next(it, None)
                if s is None:
                    break
                c = free.pop()
                pending[ex.submit(one, s, c)] = c
            if not pending:
                break
            done, _ = cf.wait(pending, return_when=cf.FIRST_COMPLETED)
            for d in done:
                free.append(pending.pop(d))
                r = d.result()
                results.append(r)
                if r['status'] == 'live':
                    live += 1
                    if not quiet:
                        f, i, _, _, rep, func = r['site']
                        ks = [h for h, v in r['killed'].items() if v]
                        print('mutant %2d %s:%d %s  %s  -> %s' % (live, os.path.basename(f), i + 1, func,
                              'killed by ' + ','.join(ks) if ks else 'hang' if r['hang'] else 'SURVIVED', r['text'][:60]), flush=True)
    shutil.rmtree(work, ignore_errors=True)
    return dict(sites=len(sites), results=results, harnesses=hs, excluded=excluded)


def kill_run(native, exe, runs, chunk=25, ignore=frozenset()):
    """Run a mutant in chunks of seeds until a check fails: 'killed', 'hang' (only timeouts: the
    harnesses do not claim termination, so a hang is not a kill) or 'survived'."""
    timeouts = 0
    for first in range(1, runs + 1, chunk):
        r = native.run(exe, min(chunk, runs + 1 - first), first=first, timeout_s=1, wall=120)
        if r['failed'] is None:
            return 'killed'
        real = [sd for sd in r['seeds'] if '(timeout)' not in sd[1] and int(sd[0]) not in ignore]
        if real:
            return 'killed'
        timeouts += sum(1 for sd in r['seeds'] if int(sd[0]) not in ignore)
        if timeouts >= 3:
            return 'hang'
    return 'survived'


def mutant_summary(m):
    live = [r for r in m['results'] if r['status'] == 'live']
    lines = ['%d mutation sites in the code under test; %d mutants run (%d skipped as dead code, %d not compiling).'
             % (m['sites'], len(live), sum(r['status'] == 'dead' for r in m['results']),
                sum(r['status'] == 'nobuild' for r in m['results']))]
    if not live:
        return '\n'.join(lines)
    if m.get('excluded'):
        lines.append('Not counted (no usable baseline: did not build, or fails on every seed): %s.' % ', '.join('`%s`' % h for h in m['excluded']))
    anyk = sum(any(r['killed'].values()) for r in live)
    lines.append('Killed by some harness: **%d/%d**; %d of the others only hang (the laws do not claim termination).'
                 % (anyk, len(live), sum(r.get('hang', False) and not any(r['killed'].values()) for r in live)))
    lines.append('')
    lines.append('| harness | killed |')
    lines.append('|---|---|')
    for h in m['harnesses']:
        lines.append('| `%s` | %d/%d |' % (h, sum(r['killed'].get(h, False) for r in live), len(live)))
    surv = [r for r in live if not any(r['killed'].values()) and not r.get('hang')]
    if surv:
        lines += ['', 'Survivors (an equivalent mutant, behaviour no law checks, or a failure the native runs did not reach):', '']
        for r in surv:
            f, i, _, _, rep, func = r['site']
            lines.append('- `%s:%d` in `%s`: `%s` with `%s`' % (f, i + 1, func, r['text'].replace('`', "'"), rep))
    return '\n'.join(lines)


