def logical_of(repo):
    m = re.search(r'^-R src (\S+)', open(os.path.join(repo, '_CoqProject')).read(), re.M)
    return m.group(1) if m else die('no "-R src LOGICAL" in _CoqProject')


def module_of(repo, rel):
    """The Coq module of src/... file `rel` of a repository."""
    return logical_of(repo) + '.' + os.path.relpath(rel, 'src')[:-2].replace('/', '.')


def theorems_of(repo):
    """{theorem: (contract file, [whole_prog constants its statement is about])} for the contracts of a
    repository.  A law is `Theorem X : harness_safe whole_prog.` (that file's whole_prog): in src/contracts/
    (the new_contract layout), or in any src/**.v when there is no src/contracts/.  In src/contracts/ a law
    may also be stated on another contract's program, `Theorem X : harness_safe LOGICAL.contracts.M.whole_prog.`,
    e.g. in a laws.v that proves the laws from `suite`: the proof Requires each contract file for its
    whole_prog, so a law cannot be proved in its own file.  `suite` (src/contracts/suite.v) is about every
    program of its conjunction."""
    out = {}
    cp = os.path.join(repo, '_CoqProject')
    m = re.search(r'^-R src (\S+)', open(cp).read(), re.M) if os.path.exists(cp) else None
    logical = m.group(1) if m else None      # none: build_and_probe stops (no Coq root for the modules)
    lg = re.escape(logical) if logical else '(?!)'
    contracts = os.path.isdir(os.path.join(repo, 'src', 'contracts'))
    law = re.compile(r'^Theorem (\w+)\s*:\s*harness_safe\s+(?:(%s\.contracts\.\w+)\.)?whole_prog\s*\.' % lg, re.M)

    def add(t, rel, progs):
        if t in out:
            die('theorem %s is stated twice, in %s and in %s: one statement per law' % (t, out[t][0], rel))
        out[t] = (rel, progs)
    for f in sorted(glob.glob(os.path.join(repo, 'src', '**', '*.v'), recursive=True)):
        if f.endswith('/code.v'):
            continue
        if contracts and '/src/contracts/' not in f:   # theorems of the proof itself are not contracts
            continue
        rel = os.path.relpath(f, repo)
        text = open(f, errors='replace').read()
        for t, prog in law.findall(text):
            if prog and not contracts:
                continue
            add(t, rel, [(prog or (module_of(repo, rel) if logical else rel)) + '.whole_prog'])
        if f.endswith('/src/contracts/suite.v'):
            m = re.search(r'^Theorem suite\s*:(.*?)\.\s*$', text, re.M | re.S)
            if m:
                add('suite', rel, [p + '.whole_prog' for p in
                                   re.findall(r'harness_safe\s+(%s\.contracts\.\w+)\.whole_prog' % lg, m.group(1))])
    return out


# repositories whose theorems' assumptions were probed jointly (build_and_probe), for the report
JOINT_ASSUMPTIONS = {}
PROGRESS_EVERY = 300     # seconds: the longest wait between two progress lines of a build in a log (not a terminal)


class Progress:
    """The progress lines of qp verify, on stderr (the report goes to stdout): `[m:ss] stage: detail`.  The
    files of a build are counted as make starts them; on a terminal the count is updated in place.  Elsewhere (a
    log) a build that is over within a minute prints only its final line, and a longer one its count at every
    tenth and at least every PROGRESS_EVERY seconds."""

    def __init__(self):
        self.t0 = time.time()
        self.tty = sys.stderr.isatty()
        self.open = False        # an in-place line is on the screen
        self.last = (0, -1)      # (time, tenth) of the last count printed
        self.build_t0 = None     # when the running build's count began

    def stamp(self):
        t = int(time.time() - self.t0)
        return '[%d:%02d]' % (t // 60, t % 60)

    def __call__(self, msg):
        if self.open:
            sys.stderr.write('\n')
            self.open = False
        sys.stderr.write('%s %s\n' % (self.stamp(), msg))
        sys.stderr.flush()

    def count(self, label, n, total):
        line = '%s: %d/%s files' % (label, n, total if total else '?')
        if self.tty:
            sys.stderr.write('\r%s %s\x1b[K' % (self.stamp(), line))
            sys.stderr.flush()
            self.open = True
            return
        now = time.time()
        if self.build_t0 is None:
            self.build_t0 = now
            self.last = (now, -1)
        tenth = n * 10 // total if total else -1
        if (tenth > self.last[1] and now - self.build_t0 >= 60) or now - self.last[0] >= PROGRESS_EVERY:
            self.last = (now, tenth)
            self(line)

    def done(self, label, n, total, t0):
        self.last = (0, -1)
        self.build_t0 = None
        msg = '%s: %d/%s files, %d s' % (label, n, total if total else '?', time.time() - t0)
        if self.open:            # the running count, replaced by the final line
            sys.stderr.write('\r%s %s\x1b[K\n' % (self.stamp(), msg))
            sys.stderr.flush()
            self.open = False
        else:
            self(msg)


def run_make(cmd, cwd, prog=None, label='build'):
    """make in cwd with the toolchain's environment; its output is returned (CompletedProcess) as sh(capture=True)
    returns it.  With prog (Progress): first a dry run (make -n) gives the number of files to compile, then each
    COQC line of the build is counted in progress lines."""
    t0, total = time.time(), None
    if prog is not None:
        dry = sh(cmd + ['-n'], cwd=cwd, coq=True, check=False, capture=True).stdout or ''
        total = len(re.findall(r'^(?:echo "*)?COQC ', dry, re.M))
        prog.count(label, 0, total)
    e = dict(os.environ)
    e.update(opam_env())
    pr = subprocess.Popen(cmd, cwd=cwd, env=e, text=True, errors='replace', stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT)
    out, n = [], 0
    for line in pr.stdout:
        out.append(line)
        if prog is not None and line.startswith('COQC '):
            n += 1
            prog.count(label, n, total)
    pr.wait()
    if prog is not None:
        prog.done(label, n, total, t0)
    return subprocess.CompletedProcess(cmd, pr.returncode, ''.join(out))


def build_and_probe(repo, theorems, prog=None, label='build'):
    """Build the contracts' .vo and probe each theorem: {thm: (status, axioms, statement)}.  prog: a Progress
    for the progress lines of qp verify (the build's files counted under `label`).  The statement
    is the theorem's type as Coq elaborates it (Set Printing All; the theorem's own name left out, so that
    a law keeps its statement wherever it is proved) and the sha256 of each whole_prog it is about, printed
    in full (no depth limit) in a probe that loads only that program's contract module."""
    sh('coq_makefile -f _CoqProject -o CoqMakefile', cwd=repo, coq=True, capture=True)
    targets = sorted(set(f[:-2] + '.vo' for f, _ in theorems.values()))
    # -k: one contract that does not build (e.g. a regenerated contract of a law the suite leaves out, at the
    # contract commit) must not keep make from building the others; it is reported as BUILD FAILED below.
    r = run_make(['make', '-k', '-f', 'CoqMakefile', '-j%d' % njobs(build=True)] + targets, repo, prog, label)
    open(os.path.join(repo, 'build.log'), 'w').write(r.stdout or '')
    flags = shlex.split(' '.join(l for l in open(os.path.join(repo, '_CoqProject')) if l.startswith('-')))

    def coq(text, tag):
        probe = os.path.join(repo, 'QpProbe_%s.v' % re.sub(r'\W', '_', tag))
        open(probe, 'w').write(text)
        out = sh(['coqc', '-q'] + flags + [probe], cwd=repo, coq=True, check=False, capture=True).stdout or ''
        for ext in ('.v', '.vo', '.vok', '.vos', '.glob'):
            try:
                os.remove(probe[:-2] + ext)
            except OSError:
                pass
        return out
    full = 'Set Printing All. Set Printing Width 100000. Set Printing Depth 1000000000.\n'
    shas = {}

    def prog_sha(prog):
        """sha256 of `Print prog` (its body and type, not its printed name), or None."""
        if prog not in shas:
            out = coq('Require %s.\nCheck tt.\n%sPrint %s.\nCheck tt.\n' % (prog.rsplit('.', 1)[0], full, prog), 'w_' + prog)
            parts = re.split(r'^tt\s*:\s*unit\s*$', out, flags=re.M)      # [loading, the program, '']
            body = re.sub(r'^\s*\S+\s*=', '', parts[1].strip(), count=1).strip() if len(parts) == 3 else ''
            shas[prog] = hashlib.sha256(body.encode()).hexdigest() if body else None   # "<name> =\n<body>\n : <type>"
        return shas[prog]
    res = {}
    # Loading a large proof takes minutes, and `Print Assumptions` traverses every proof term the theorem
    # depends on, with no memory across commands (a large suite: hours per theorem).  So, first, ONE
    # probe loads every module once, checks every statement, and prints the assumptions of one definition
    # that names every theorem: their union, an upper bound of each theorem's.  If the union holds only
    # allowed axioms, every theorem is proved with those.  Otherwise (an Admitted theorem, an unexpected
    # axiom, an error), each theorem's own Print Assumptions is probed, as before: in one coqc, or one
    # coqc per theorem (each with its own Locate) if that stops on an error.  Each whole_prog is still
    # printed in a probe that loads only its own contract module.
    items = []
    for t, (f, progs) in sorted(theorems.items()):
        if not os.path.exists(os.path.join(repo, f[:-2] + '.vo')):
            res[t] = ('BUILD FAILED', [], None)
        else:
            items.append((t, module_of(repo, f), progs))
    mods = sorted(set(m for _, m, _ in items))

    def not_harness_safe():
        """Law theorems whose statement is not `QuickProof.Contract.harness_safe <program>` of the trusted
        framework: a typed ascription against the fully qualified name type-checks only for the real
        harness_safe, so a repository-defined harness_safe (even one printed as `Contract.harness_safe`) is
        caught.  Only single-program law theorems are checked, not `suite` (a conjunction of harness_safe).  One
        joint probe, then one per theorem if it reports an error, to name the offenders."""
        laws = [it for it in items if it[0] != 'suite' and len(it[2]) == 1]
        if not laws:
            return set()
        def check(sub):
            text = 'Require QuickProof.Contract.\nRequire %s.\n' % ' '.join(sorted(set(m for _, m, _ in sub)))
            text += ''.join('Check tt.\nDefinition qp_hs_%d := (%s.%s : QuickProof.Contract.harness_safe _).\n'
                            % (i, mod, t) for i, (t, mod, _) in enumerate(sub)) + 'Check tt.\n'
            out = coq(text, 'hs')
            oks = len(re.split(r'^tt\s*:\s*unit\s*$', out, flags=re.M)) - 1
            return 'Error' not in out and oks > len(sub)
        if check(laws):
            return set()
        bad = set()
        for it in laws:
            if not check([it]):
                bad.add(it[0])
        return bad
    not_hs = not_harness_safe()

    def finalize(result):
        for t in not_hs:
            if t in result and result[t][0].startswith('PROVED'):
                result[t] = ('NOT QuickProof.Contract.harness_safe (the statement uses a different harness_safe)',
                             result[t][1], result[t][2])
        return result
    if prog is not None:
        prog('statements and axioms%s: %d theorem%s probed%s'
             % (label[len('build'):] if label.startswith('build') else ' (%s)' % label, len(items),
                '' if len(items) == 1 else 's',
                '; not built: ' + ', '.join(sorted(set(theorems) - set(t for t, _, _ in items))) if len(items) < len(theorems) else ''))

    def assumptions(tail):
        """(axioms, unsafe flags) of a Print Assumptions output, or None."""
        if 'Closed under the global context' in tail:
            return [], []
        if 'Axioms:' not in tail:
            return None
        body = tail.split('Axioms:', 1)[1]
        # anything else at column 0 is an unsafe flag (e.g. "loop is assumed to be guarded.")
        return (re.findall(r"^([A-Za-z_][\w.']*) :", body, re.M),
                [l for l in body.split('\n') if l and not l[0].isspace() and not re.match(r"[A-Za-z_][\w.']* :", l)])

    def locate(names):
        """{name: fully qualified name} by Locate in the context of all modules, one segment per name; a name
        counts only if Locate gives exactly one constant."""
        out = {}
        if names:
            parts = re.split(r'^tt\s*:\s*unit\s*$', coq('Require %s.\nCheck tt.\n' % ' '.join(mods)
                                                        + ''.join('Locate %s.\nCheck tt.\n' % a for a in names), 'locate'), flags=re.M)
            if len(parts) == 2 + len(names):
                for i, a in enumerate(names):
                    found = re.findall(r'^(?:Constant|Axiom|Parameter)\s+(\S+)', parts[1 + i], re.M)
                    if len(found) == 1:
                        out[a] = found[0]
        return out
    JOINT_ASSUMPTIONS.pop(repo, None)
    if items:
        text = 'Require %s.\nCheck tt.\n%s' % (' '.join(mods), full)
        text += ''.join('Check %s.%s.\nCheck tt.\n' % (mod, t) for t, mod, _ in items)
        # conj t1 (conj t2 (... (conj tn I))): a term that names every theorem (they are propositions)
        text += ('Unset Printing All.\nDefinition qp_probe_all :=\n%s I%s.\nPrint Assumptions qp_probe_all.\nCheck tt.\n'
                 % (''.join('  conj %s.%s (\n' % (mod, t) for t, mod, _ in items), ')' * len(items)))
        parts = re.split(r'^tt\s*:\s*unit\s*$', coq(text, 'joint'), flags=re.M)
        union = assumptions(parts[1 + len(items)]) if len(parts) == 3 + len(items) else None
        if union is not None and not union[1]:
            fq = locate(sorted(set(union[0])))
            if all(fq.get(a) in ALLOWED_AXIOMS for a in union[0]):
                for i, (t, mod, progs) in enumerate(items):
                    sums = [prog_sha(p) for p in progs]
                    if None in sums:
                        res[t] = ('PROBE FAILED: whole_prog of %s' % ', '.join(p for p, s in zip(progs, sums) if s is None), [], None)
                        continue
                    typ = re.match(r'\s*\S+\s+:\s', parts[1 + i])     # "<name>\n     : <type>": keep the type
                    stmt = (parts[1 + i][typ.end():] if typ else parts[1 + i]).strip()
                    res[t] = ('PROVED', union[0], stmt + ''.join('\n--- whole_prog sha256 ' + s for s in sums))
                JOINT_ASSUMPTIONS[repo] = True
                return finalize(res)
    batch = {}
    if items:
        text = 'Require %s.\nCheck tt.\n' % ' '.join(mods)
        for t, mod, _ in items:
            text += '%sCheck %s.%s.\nCheck tt.\nUnset Printing All.\nPrint Assumptions %s.%s.\nCheck tt.\n' % (full, mod, t, mod, t)
        parts = re.split(r'^tt\s*:\s*unit\s*$', coq(text, 'all'), flags=re.M)
        if len(parts) == 2 + 2 * len(items):
            batch = {t: [parts[1 + 2 * i], parts[2 + 2 * i]] for i, (t, _, _) in enumerate(items)}
    # fully qualified names of the batch's axioms (Locate in the batch's context)
    fq_batch = locate(sorted(set(a for t in batch for a in ((assumptions(batch[t][1]) or ([], []))[0]))))
    for t, mod, progs in items:
        if t in batch:
            parts = batch[t]
        else:
            # the statement, then the assumptions; then the programs it is about
            out = coq('Require %s.\nCheck tt.\n%sCheck %s.%s.\nCheck tt.\nUnset Printing All.\nPrint Assumptions %s.%s.\n'
                      % (mod, full, mod, t, mod, t), 'p_' + t)
            parts = re.split(r'^tt\s*:\s*unit\s*$', out, flags=re.M)[1:]  # [the statement, the assumptions]
            if len(parts) != 2:
                res[t] = ('PROBE FAILED: ' + out.strip()[-200:], [], None)
                continue
        sums = [prog_sha(p) for p in progs]
        if None in sums:
            res[t] = ('PROBE FAILED: whole_prog of %s' % ', '.join(p for p, s in zip(progs, sums) if s is None), [], None)
            continue
        typ = re.match(r'\s*\S+\s+:\s', parts[0])     # "<name>\n     : <type>": keep the type
        stmt = (parts[0][typ.end():] if typ else parts[0]).strip()
        stmt += ''.join('\n--- whole_prog sha256 ' + s for s in sums)
        got = assumptions(parts[1])
        if got is None:
            res[t] = ('PROBE FAILED: ' + parts[1].strip()[-200:], [], None)
            continue
        axioms, unsafe = got
        if unsafe:
            res[t] = ('UNSAFE: ' + '; '.join(unsafe)[:200], axioms, stmt)
            continue
        if any(a.split('.')[-1] == t for a in axioms):
            res[t] = ('not proved (Admitted)', axioms, stmt)
            continue
        # fully qualified names (Locate), compared exactly: a project file cannot pose as an allowed axiom
        if t in batch:
            fq = {a: fq_batch[a] for a in axioms if a in fq_batch}
        else:
            fq = {}
            if axioms:
                loc = coq('Require %s.\n' % mod + ''.join('Locate %s.\n' % a for a in axioms), 'l_' + t)
                found = re.findall(r'^(?:Constant|Axiom|Parameter)\s+(\S+)', loc, re.M)
                fq = dict(zip(axioms, found)) if len(found) == len(axioms) else {}
        bad = [a for a in axioms if fq.get(a) not in ALLOWED_AXIOMS]
        res[t] = (('PROVED' if not bad else 'UNEXPECTED AXIOMS: ' + ', '.join('%s (%s)' % (a, fq.get(a, '?')) for a in bad)),
                  axioms, stmt)
    return finalize(res)


def blank_comments(text):
    """Coq text with its (nested) comments blanked out, line structure kept."""
    out, depth, i = [], 0, 0
    while i < len(text):
        two = text[i:i + 2]
        if two == '(*':
            depth += 1; out.append('  '); i += 2
        elif two == '*)' and depth:
            depth -= 1; out.append('  '); i += 2
        else:
            out.append(text[i] if not depth or text[i] == '\n' else ' '); i += 1
    return ''.join(out)


def coq_code(text):
    """Coq text without comments, whitespace normalised (None stays None): what Coq reads."""
    return None if text is None else ' '.join(blank_comments(text).split())


def source_admits(d):
    """`Admitted`, `admit`, `Axiom`, `Parameter`, `Conjecture` in the Coq sources of the proof (src/**, the
    other files of _CoqProject, the prebuild projects; comments excluded): [(file:line, word)]."""
    hits = []
    for f in coq_sources(d):
        for n, line in enumerate(blank_comments(open(f, errors='replace').read()).split('\n'), 1):
            for w in re.findall(r'\b(Admitted|admit)\b|^\s*(?:#\[[^]]*\]\s*)?(?:Local\s+|Global\s+)?'
                                r'(Axioms?|Parameters?|Conjectures?)\b', line):
                hits.append(('%s:%d' % (os.path.relpath(f, d), n), w[0] or w[1]))
    return hits


# Changes allowed after the contract: proof sources (src/**.v), notes (wiki/, docs/, *.md) and the metadata of the
# proving process (run/, .subtasks/, scripts/fuzz/, result.json, .gitignore).  Everything else (harness/, the code,
# quickproof.conf, _CoqProject, the framework submodule, generated code.v and the unit files) is frozen.
FROZEN_OK = re.compile(r'^(src/.*\.v|wiki/.*|\.subtasks/.*|.*\.md|docs/.*|run/.*|scripts/fuzz/.*|result\.json|\.gitignore)$')

# The prebuild: Coq projects that a proof repository declares in run/prebuild and that qp verify and qp
# rebuild build from source, in order, before the main build.  For a library the main _CoqProject maps with
# -Q/-R but does not compile, e.g. a vendored fiat-crypto: one directory per line (`#` starts a comment), each
# with its own _CoqProject.  qp runs `coq_makefile -f _CoqProject -o CoqMakefile` and `make -f CoqMakefile`
# there and nothing else, so what it builds is compiled from source by coqc; no command of the repository runs.
# A directory must lie outside the proof area (not FROZEN_OK, not src/ or quickproof/): its sources are frozen
# by the contract.
PREBUILD = 'run/prebuild'


def prebuild_dirs(d):
    """The directories of run/prebuild, checked (ValueError when one is not acceptable)."""
    f = os.path.join(d, PREBUILD)
    if not os.path.exists(f):
        return []
    out = []
    for line in open(f):
        p = line.split('#', 1)[0].strip().rstrip('/')
        if not p:
            continue
        if (os.path.isabs(p) or '..' in p.split('/') or p.split('/')[0] in ('src', FW)
                or FROZEN_OK.match(p + '/x.v')):
            raise ValueError('%s: not a directory outside the proof area' % p)
        if not os.path.isfile(os.path.join(d, p, '_CoqProject')):
            raise ValueError('%s: no _CoqProject' % p)
        out.append(p)
    return out


def main_sources(d, framework=True):
    """The .v files of the main build: src/**, the files and directories listed in _CoqProject and, with
    framework=True, quickproof/**."""
    out = set(glob.glob(os.path.join(d, 'src', '**', '*.v'), recursive=True))
    for line in open(os.path.join(d, '_CoqProject')):
        line = line.split('#', 1)[0].strip()
        if not line or line.startswith('-') or (not framework and line.split('/')[0] == FW):
            continue
        p = os.path.join(d, line)
        out |= set(glob.glob(os.path.join(p, '**', '*.v'), recursive=True)) if os.path.isdir(p) else {p}
    if framework:
        out |= set(glob.glob(os.path.join(d, FW, '**', '*.v'), recursive=True))
    return out


def prebuild(d, git=True):
    """Build the projects of run/prebuild from source (coq_makefile and make in each, in order).  Then the
    tracked files must be unchanged (git=True) and the prebuild must not have built anything for a source of the
    main build, so that it cannot stand in for the main build.  Build products that were there before it ran (a
    resumed qp verify keeps what its interrupted run built) count only if the prebuild changed them.  Returns
    (ok, report line or None)."""
    try:
        dirs = prebuild_dirs(d)
    except ValueError as e:
        return False, '- prebuild (`%s`): **refused**: %s' % (PREBUILD, e)
    if not dirs:
        return True, None
    def products():
        return {f[:-2] + ext: os.stat(f[:-2] + ext).st_mtime_ns for f in main_sources(d, framework=git)
                for ext in ('.vo', '.vos', '.vok', '.glob') if os.path.exists(f[:-2] + ext)}
    before = products()
    t0, done = time.time(), []
    for p in dirs:
        r = sh('coq_makefile -f _CoqProject -o CoqMakefile > /dev/null && make -f CoqMakefile -j%d' % njobs(build=True),
               cwd=os.path.join(d, p), coq=True, check=False, capture=True)
        open(os.path.join(d, p, 'prebuild.log'), 'w').write(r.stdout or '')
        if r.returncode:
            return False, '- prebuild (`%s`): **FAILED** in `%s` (exit %d, see %s/prebuild.log)' % (PREBUILD, p, r.returncode, p)
        done.append('`%s` (%d .vo)' % (p, len(glob.glob(os.path.join(d, p, '**', '*.vo'), recursive=True))))
    changed = []
    if git:
        changed = [l for l in sh(['git', '-C', d, 'status', '--porcelain', '--untracked-files=no'],
                                 capture=True).stdout.split('\n') if l.strip()]
    planted = sorted(os.path.relpath(f, d) for f, mtime in products().items() if before.get(f) != mtime)
    if changed or planted:
        return False, '- prebuild (`%s`): **changed the tree**: %s' % (PREBUILD, ', '.join((changed + planted)[:20]))
    return True, ('- prebuild (`%s`): built from source (coq_makefile, make) before the main build: %s, in %d s'
                  % (PREBUILD, ', '.join(done), time.time() - t0))


def other_sources(d):
    """The proof's files outside src/ that qp export carries and qp rebuild puts back (repository-relative):
    the files _CoqProject lists outside src/ and quickproof/, and run/prebuild with its projects (their tracked
    files, and the files of the directories above them: pins, licences)."""
    tracked = sh(['git', '-C', d, 'ls-files'], capture=True).stdout.split('\n')
    out = set()
    for line in open(os.path.join(d, '_CoqProject')):
        line = line.split('#', 1)[0].strip().rstrip('/')
        if line and not line.startswith('-') and line.split('/')[0] not in ('src', FW):
            out |= {f for f in tracked if f == line or f.startswith(line + '/')}
    dirs = prebuild_dirs(d)
    if dirs:
        out.add(PREBUILD)
    for p in dirs:
        out |= {f for f in tracked if f.startswith(p + '/')}
        parts = p.split('/')
        out |= {f for i in range(1, len(parts)) for f in tracked if os.path.dirname(f) == '/'.join(parts[:i])}
    return sorted(f for f in out if f)


def coq_sources(d):
    """The Coq sources of the proof, for the Admitted scan: src/**, the other files of _CoqProject (not the
    framework's) and the projects of run/prebuild."""
    out = main_sources(d, framework=False)
    try:
        for p in prebuild_dirs(d):
            out |= set(glob.glob(os.path.join(d, p, '**', '*.v'), recursive=True))
    except ValueError:
        pass
    return sorted(f for f in out if os.path.isfile(f))


def local_framework(commit):
    """A local git repository of the framework that has `commit` (QP_FRAMEWORK_DIR, the framework qp belongs to,
    the cache's clone of QP_FRAMEWORK_URL), or None."""
    for d in (SITE['QP_FRAMEWORK_DIR'], FRAMEWORK_HOME, cached_clone(SITE['QP_FRAMEWORK_URL'])):
        if git_head(d) and resolve_commit(d, commit):
            return d
    return None


def init_submodules(d):
    """`git submodule update --init` in a clone d, with the framework's submodule (path quickproof/, or the URL
    QP_FRAMEWORK_URL) fetched from a local repository that has its commit when there is one (local_framework, as
    a file:// URL: no hard links): the gitlink fixes the commit, so where it is fetched from does not change what
    is checked out."""
    if not os.path.exists(os.path.join(d, '.gitmodules')):
        return
    sh(['git', '-C', d, 'submodule', 'init', '-q'], capture=True)
    paths = sh(['git', '-C', d, 'config', '-f', '.gitmodules', '--get-regexp', r'^submodule\..*\.path$'],
               check=False, capture=True).stdout
    for line in paths.splitlines():
        key, path = line.split(' ', 1)
        name = key[len('submodule.'):-len('.path')]
        url = sh(['git', '-C', d, 'config', '-f', '.gitmodules', 'submodule.%s.url' % name], check=False,
                 capture=True).stdout.strip()
        tree = sh(['git', '-C', d, 'ls-tree', 'HEAD', '--', path], check=False, capture=True).stdout.split()
        if (path == FW or url == SITE['QP_FRAMEWORK_URL']) and len(tree) >= 3 and tree[1] == 'commit':
            local = local_framework(tree[2])
            if local:
                sh(['git', '-C', d, 'config', 'submodule.%s.url' % name, file_url(local)], capture=True)
    sh(['git', '-C', d, '-c', 'protocol.file.allow=always', 'submodule', 'update', '-q', '--init'], capture=True)


def verifier_id():
    """What a resumed run must share with the run it continues: this verifier, its qp and its trusted files."""
    h = hashlib.sha256()
    for rel in ['tools/qp'] + TRUSTED_FRAMEWORK_FILES:
        h.update(rel.encode() + b'\0' + (open(os.path.join(FRAMEWORK_HOME, rel), 'rb').read()
                                          if os.path.exists(os.path.join(FRAMEWORK_HOME, rel)) else b'-'))
    return h.hexdigest()


def toolchain_id():
    """The versions of coqc and ccomp, which built the files a resumed run keeps."""
    out = []
    for cmd in (['coqc', '--version'], ['ccomp', '-version']):
        r = sh(cmd, coq=True, check=False, capture=True)
        out.append(' '.join((r.stdout or '').split()))
    return ' | '.join(out)


def read_state(d):
    try:
        return json.load(open(d + '.qp-verify.json'))
    except (OSError, ValueError):
        return None


def write_state(d, st):
    tmp = d + '.qp-verify.json.tmp'
    json.dump(st, open(tmp, 'w'), indent=1)
    os.replace(tmp, d + '.qp-verify.json')


def resume_state(d, ident):
    """The start time of an interrupted run to resume in the clone d, or None.  A run is resumed only when it did
    not finish, was made by this very verifier (qp and trusted files) with the same coqc and ccomp, on the same
    commit and contract, and its clone is still at that commit.  The resumed run makes every check again; it keeps
    only what the earlier run built in its own clone, so make does not build it twice.  qp verify --fresh, or a
    finished run, starts from a new clone."""
    st = read_state(d)
    if not st or st.get('finished') or not os.path.isdir(os.path.join(d, '.git')):
        return None
    if any(st.get(k) != v for k, v in ident.items()) or git_head(d) != ident['rev']:
        return None
    return st.get('started') or '?'


_VERIFY_LOCKS = []


def lock_verify(d):
    """One qp verify at a time per clone."""
    import fcntl
    f = open(d + '.lock', 'w')
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die('another qp verify is running in %s' % d)
    _VERIFY_LOCKS.append(f)


def regenerate_clight(dd):
    """tools/clight.sh in the clone dd.  A code.v that comes out as it was, or different only in the recorded
    source path (which regenerated_diff ignores too), keeps its earlier content and modification time, so that
    make does not rebuild what depends on it when a run is resumed."""
    before = {}
    for f in glob.glob(os.path.join(dd, 'src', '**', 'code.v'), recursive=True):
        before[f] = (open(f, 'rb').read(), os.stat(f).st_mtime_ns)
    sh([FW + '/tools/clight.sh', CONF], cwd=dd, coq=True, capture=True)
    strip = lambda b: re.sub(rb'(?m)^  Definition source_file := ".*"\.$', b'', b)
    for f, (old, mtime) in before.items():
        if os.path.exists(f) and strip(open(f, 'rb').read()) == strip(old):
            open(f, 'wb').write(old)
            os.utime(f, ns=(mtime, mtime))


def verify(repo, rev, base='contract', keep=None, verbose=False, keep_going=False, do_coqchk=False, brief=False,
           fresh=False):
    """The acceptance check of docs/QP.md on a fresh clone of repo at rev: preconditions(), the frozen files, the
    regenerated Clight, the build, the statements against the contract, the axioms.  The report goes to stdout and
    VERIFY.md, progress to stderr.  An interrupted run is resumed (see resume_state) unless fresh.  Returns (the
    clone, ok, {theorem: (status, axioms, statement)})."""
    prog = Progress()
    t_start, load_start = time.time(), os.getloadavg()[0]
    repo = os.path.realpath(repo)
    rev_full = sh(['git', '-C', repo, 'rev-parse', rev + '^{commit}'], capture=True).stdout.strip()
    d = keep or os.path.join(CACHE, 'verify', '%s-%s' % (os.path.basename(repo), rev_full[:10]))
    os.makedirs(os.path.dirname(d), exist_ok=True)
    lock_verify(d)
    ident = {'rev': rev_full, 'base': base, 'verifier': verifier_id(), 'toolchain': toolchain_id()}
    resumed = None if fresh else resume_state(d, ident)
    if resumed:
        prog('qp verify: resuming the interrupted run of %s in %s (--fresh starts again from a new clone)'
             % (resumed, d))
    else:
        prog('qp verify: a fresh clone of %s at %s' % (repo, rev_full[:12]))
        shutil.rmtree(d, ignore_errors=True)
        shutil.rmtree(d + '.base', ignore_errors=True)
        sh(['git', 'clone', '-q', '--no-hardlinks', '--no-checkout', repo, d])
        sh(['git', '-C', d, 'checkout', '-q', rev_full])
        init_submodules(d)
    artifacts = remove_build_artifacts(d)
    if not resumed:
        write_state(d, dict(ident, started=datetime.datetime.now().strftime('%Y-%m-%d %H:%M'), finished=False))
    fw = git_head(os.path.join(d, FW))
    rep = ['# Verification of %s at %s' % (repo, rev_full[:12]), '', '- date: %s' % datetime.datetime.now().strftime('%Y-%m-%d %H:%M'),
           '- framework: %s' % ('%s/ at %s (%s)' % (FW, fw[:12], release_of(fw)) if fw else 'no %s/ submodule' % FW)]
    if resumed:
        rep.append('- resumed: this run continued the build of an interrupted run of this verifier on the same commit, '
                   'in the same clone (started %s); every check before the build was made again' % resumed)
    if os.path.realpath(FRAMEWORK_HOME).startswith(repo + os.sep):
        rep.append('- the verifier: the repository\'s own %s/, which this check compares with itself; check a proof '
                   'you did not make with a QuickProof checkout of your own' % FW)
        prog('note: the verifier is the repository\'s own %s/; use a QuickProof checkout of your own' % FW)
    if artifacts:
        rep.append('- build artifacts committed in the repository (removed before building): %d files' % len(artifacts))
    # a QuickProof proof repository on this verifier's framework, nothing that loads code (docs/QP.md)
    lines, refusals = preconditions(d)
    rep += lines + ['- **%s**' % x for x in refusals]
    for x in lines:
        prog('framework: the %d trusted files are identical to this verifier\'s' % len(TRUSTED_FRAMEWORK_FILES)
             if x.startswith('- framework trusted files') else x[2:])
    for x in refusals:
        prog(x)
    if refusals:
        return verify_report(d, rep, False, {}, verbose, brief)
    ok = True
    has_base = sh(['git', '-C', d, 'rev-parse', '-q', '--verify', base + '^{commit}'], check=False, capture=True).returncode == 0
    if has_base:
        base_full = sh(['git', '-C', d, 'rev-parse', base + '^{commit}'], capture=True).stdout.strip()
        rep.append('- contract commit: %s (`%s`)' % (base_full[:12], base))
        changed = sh(['git', '-C', d, 'diff', '--name-only', base_full, rev_full], capture=True).stdout.split()
        bad = [f for f in changed if (not FROZEN_OK.match(f) or f.endswith('/code.v') or UNITS_FILE.match(f))
               and not BUILD_ARTIFACT.search(f)]
        rep.append('- files changed since the contract: %d; frozen files changed: %s' % (len(changed), ', '.join(bad) or 'none'))
        ok &= not bad
        if not bad:
            prog('frozen files: %d file%s changed since the contract (`%s`), none of them frozen'
                 % (len(changed), '' if len(changed) == 1 else 's', base))
        elif not keep_going:
            prog('frozen files changed since the contract: %s' % ', '.join(bad))
            prog('FAIL: a frozen file changed; stopping before the build (--keep-going runs every check)')
            rep.append('- stopped before the build: a frozen file changed since the contract, so the verdict is FAIL '
                       'whatever the proof shows (`qp verify --keep-going` runs every check anyway)')
            return verify_report(d, rep, ok, {}, verbose, brief)
        else:
            prog('frozen files changed since the contract: %s (FAIL; going on: --keep-going)' % ', '.join(bad))
    else:
        rep.append('- UNVERIFIED: no contract commit `%s`, so the statements cannot be compared with the ones generated '
                   'from the harnesses.  Pass --base COMMIT of the contract.' % base)
        prog('UNVERIFIED: no contract commit `%s`; pass --base COMMIT of the contract' % base)
        ok = False
    # before the Clight is regenerated: the prebuild must leave every tracked file as committed
    if os.path.exists(os.path.join(d, PREBUILD)):
        prog('prebuild: the projects of %s' % PREBUILD)
    pre_ok, line = prebuild(d)
    if line:
        rep.append(line)
        prog(line[2:].replace('**', ''))
    ok &= pre_ok
    regenerate_clight(d)
    fw_changed = framework_changed(d)
    dirty = regenerated_diff(d)
    rep.append('- regenerated code.v: %s' % ('identical to the committed files' if not dirty else '**DIFFERENT**: ' + ', '.join(dirty)))
    prog('Clight generated again: %s' % ('identical to the committed files' if not dirty else 'DIFFERENT: ' + ', '.join(dirty)))
    ok &= not dirty
    thms = theorems_of(d)
    t_build = time.time()
    res = build_and_probe(d, thms, prog=prog)
    t_base = time.time()
    fw_changed = fw_changed or framework_changed(d)
    if has_base:
        # The statement as Coq elaborates it (Set Printing All) and its whole_prog, at the contract commit and now.
        prog('the contract commit %s: a clone, its statements built without the proof' % base_full[:12])
        bd = d + '.base'
        if not (resumed and os.path.isdir(bd) and git_head(bd) == base_full):
            shutil.rmtree(bd, ignore_errors=True)
            sh(['git', 'clone', '-q', '--no-hardlinks', '--no-checkout', d, bd])
            sh(['git', '-C', bd, 'checkout', '-q', base_full])
            sh(['git', '-C', bd, 'remote', 'set-url', 'origin', repo])
            init_submodules(bd)
        remove_build_artifacts(bd)
        bconf = conf_refusal(os.path.join(bd, CONF)) if os.path.exists(os.path.join(bd, CONF)) else None
        if bconf:
            rep.append('- the contract commit: **refused** (runs commands): %s' % bconf)
            prog('the contract commit: refused (runs commands): %s' % bconf)
            ok = False
        elif os.path.exists(os.path.join(bd, CONF)):   # repositories that do not commit code.v
            regenerate_clight(bd)
        as_committed, generated, not_generated = pristine_contracts(bd)
        if not_generated:
            rep.append('- contract files whose program is not the one generated from their harness: **%s**'
                       % ', '.join(not_generated))
            prog('contract files whose program is not the generator\'s (FAIL): %s' % ', '.join(not_generated))
            ok = False
        rep.append('- the statements compared with: the contract commit\'s own files with no proof in them (%s) and '
                   'its unit files (src/units.v or src/units/*.v); generated again: %s'
                   % (', '.join('src/contracts/%s.v' % c for c in as_committed) or 'none', ', '.join(generated) or 'none'))
        bthms = theorems_of(bd)
        bres = build_and_probe(bd, bthms, prog=prog, label='build of the contract commit')
        lines, res, same = reconcile(res, thms, bres, bthms)
        rep += lines
        ok &= same
        prog('statements compared with the contract: %s' % ('identical' if same else 'DIFFERENT or missing'))
        shutil.rmtree(bd, ignore_errors=True)
    # A delivered proof has no Admitted, admit, Axiom, Parameter or Conjecture in its own sources, not even in a
    # lemma that no theorem uses.  In a run/prebuild project (a vendored library) they are only listed: Print
    # Assumptions shows whether a theorem depends on them.
    admits = source_admits(d)
    try:
        vendored = tuple(x + '/' for x in prebuild_dirs(d))
    except ValueError:
        vendored = ()
    own = [h for h in admits if not (vendored and h[0].startswith(vendored))]
    rep.append('- `Admitted`/`admit`/`Axiom`/`Parameter`/`Conjecture` in the Coq sources of the proof (src/ and the '
               'other files of _CoqProject; comments excluded): %s'
               % ('none' if not own else '**%d** (a proof is delivered without them): %s'
                  % (len(own), ', '.join('%s (%s)' % h for h in own[:40]))))
    if len(admits) > len(own):
        rep.append('- the same in the run/prebuild projects (vendored; Print Assumptions decides whether a theorem '
                   'depends on them): %d' % (len(admits) - len(own)))
    ok &= not own
    prog('Admitted, admit, Axiom, Parameter, Conjecture in the sources of the proof: %s'
         % ('none' if not own else '%d (FAIL)' % len(own)))
    if JOINT_ASSUMPTIONS.get(d):
        rep.append('- `Print Assumptions` was printed once for all theorems together (of a definition that names each of '
                   'them): the axioms given for each theorem are those of all of them, an upper bound of its own')
    if do_coqchk:
        prog('coqchk: the kernel re-checks the theorems\' modules')
        line, ck_ok = coqchk(d)
        rep.append(line)
        prog(line[2:].replace('**', ''))
        ok &= ck_ok
    # Nothing of the repository runs code (preconditions: no plugins, and a quickproof.conf that is data), so the
    # framework cannot change after it was compared with this verifier's.  Check that anyway.
    fw_changed = fw_changed or framework_changed(d)
    rep.append('- the framework after the translation and the builds: %s'
               % ('unchanged' if not fw_changed else '**CHANGED**: ' + fw_changed))
    if fw_changed:
        prog('the framework changed during the check (FAIL): %s' % fw_changed)
    ok &= not fw_changed
    mins = lambda a, b: '%d min' % round((b - a) / 60)
    rep.append('- the run: %d build jobs on %d CPUs, load %.1f at the start; checks before the build %s, the build '
               'and probes %s, the contract commit %s, in all %s'
               % (njobs(build=True), os.cpu_count() or 0, load_start, mins(t_start, t_build), mins(t_build, t_base),
                  mins(t_base, time.time()), mins(t_start, time.time())))
    return verify_report(d, rep, ok, res, verbose, brief)


def verify_report(d, rep, ok, res, verbose, brief=False):
    """The end of qp verify: the table of theorems and the verdict after the report lines `rep`, written to
    VERIFY.md (each theorem's axioms in full) and printed (their number; all of it with verbose).  With brief, only
    the table and the verdict are printed: the progress lines have already shown each check, the failed ones too.
    Returns
    (d, ok, res)."""
    short = list(rep)
    if res:
        short += ['', '| theorem | result | axioms |', '|---|---|---|']
        rep = rep + ['', '| theorem | result | Print Assumptions |', '|---|---|---|']
    for t, (st, ax, _) in sorted(res.items()):
        rep.append('| `%s` | %s | %s |' % (t, st, ', '.join(ax) if ax else ('closed' if st.startswith('PROVED') else '-')))
        short.append('| `%s` | %s | %s |' % (t, st, axioms_summary(st, ax)))
    passed = verdict(ok, res)
    st = read_state(d)
    if st is not None:
        write_state(d, dict(st, finished=True))
    v = 'Verdict: %s.' % ('PASS (exit 0)' if passed else 'FAIL (exit 1)')
    end = ['', '**%s**' % v]
    meaning = (['', 'PASS means: the frozen files, the regenerated Clight and every statement are those of the contract, '
                'every statement is QuickProof.Contract.harness_safe on this verifier\'s framework, and every claimed '
                'theorem is proved.'] if passed else [])
    text = '\n'.join(rep + meaning + end) + '\n'
    open(os.path.join(d, 'VERIFY.md'), 'w').write(text)
    # On the screen the verdict is plain text, in bold green or red on a terminal (unless NO_COLOR is set).
    shown = (('\033[1;%sm%s\033[0m' % ('32' if passed else '31', v))
             if sys.stdout.isatty() and not os.environ.get('NO_COLOR') else v)
    if brief and not verbose:
        rows = [('theorem', 'result', 'axioms')] + [(t, st, axioms_summary(st, ax)) for t, (st, ax, _) in sorted(res.items())]
        w = [max(len(r[i]) for r in rows) for i in (0, 1)]
        table = '\n' + '\n'.join('%-*s  %-*s  %s' % (w[0], r[0], w[1], r[1], r[2]) for r in rows) + '\n' if res else ''
        print('%s\nThe full report: %s\n%s\n' % (table, os.path.join(d, 'VERIFY.md'), shown), flush=True)
        return d, ok, res
    out = text[:-1] if verbose else '\n'.join(short + (['', 'Each theorem\'s `Print Assumptions` in full: %s'
                                                      % os.path.join(d, 'VERIFY.md')] if res else []) + end)
    print(out[:out.rindex(end[1])] + shown + '\n', flush=True)
    return d, ok, res


def axioms_summary(st, ax):
    """The axioms of one theorem in the printed table of qp verify: their number, and for a proved theorem (whose
    axioms build_and_probe has checked against ALLOWED_AXIOMS, fully qualified) which of the allowed kinds they are:
    standard logical axioms, and the parameters of VST's abstract malloc library (VST.floyd.library)."""
    if not ax:
        return 'closed' if st.startswith('PROVED') else '-'
    if not st.startswith('PROVED'):
        return '%d (listed in VERIFY.md)' % len(ax)
    malloc = [a for a in ax if any(f.startswith('VST.floyd.library.') and (f == a or f.endswith('.' + a))
                                   for f in ALLOWED_AXIOMS)]
    return '%d: %s' % (len(ax), 'standard + VST malloc' if malloc else 'standard')


OUTSIDE_SUITE = 'not claimed (left out of the suite by the contract)'


def reconcile(res, thms, bres, bthms):
    """Match the theorems of the proof (res, thms) with the contract theorems of the contract commit (bres,
    bthms), by name.  A contract theorem keeps its elaborated statement and the whole_prog it is about
    (printed in full, sha256), wherever it is now stated (its generated file, or another contract file such
    as laws.v).  A law with no theorem of its own is proved when `suite` is proved, keeps its statement, and
    has the law's whole_prog as a conjunct (as `qp export` counts it).  A law that the contract's suite
    leaves out (a known-false law) may be absent: it is then not claimed.  Any other contract theorem
    missing from the proof fails.  Returns (report lines, {theorem: (status, axioms, statement)}, ok)."""
    rep, rows, ok = [], dict(res), True
    suite_ok = ('suite' in res and 'suite' in bres and res['suite'][0] == 'PROVED'
                and bres['suite'][2] is not None and res['suite'][2] == bres['suite'][2])
    suite_progs = thms['suite'][1] if 'suite' in thms else []
    base_suite_progs = bthms['suite'][1] if 'suite' in bthms else None
    for t in sorted(set(res) | set(bres)):
        if t not in bres:            # a helper theorem added by the proof, not a contract
            rep.append('- `%s`: not a contract theorem (added by the proof)' % t)
            continue
        progs = bthms[t][1]
        in_suite = t != 'suite' and len(progs) == 1 and progs[0] in suite_progs
        if t in res:
            same = bres[t][2] is not None and bres[t][2] == res[t][2]
            where = '' if thms[t][0] == bthms[t][0] else ' (stated in %s; generated in %s)' % (thms[t][0], bthms[t][0])
            rep.append('- elaborated statement and whole_prog of `%s`%s: %s'
                       % (t, where, 'identical to the contract' if same else '**DIFFERENT or missing**'))
            if not same and res[t][0] == 'PROVED':
                rows[t] = ('STATEMENT CHANGED', res[t][1], res[t][2])
            elif same and not res[t][0].startswith('PROVED') and suite_ok and in_suite:
                rep.append('  - `%s` is a conjunct of the proved `suite`, but its own theorem is not proved' % t)
            ok &= same
        elif suite_ok and in_suite:
            rep.append('- `%s`: no theorem of its own; proved as its conjunct of `suite` (statement and whole_prog '
                       'compared with the suite\'s)' % t)
            rows[t] = ('PROVED (by `suite`)', res['suite'][1], None)
        elif t != 'suite' and base_suite_progs is not None and not set(progs) & set(base_suite_progs):
            rep.append('- `%s`: not claimed: the contract leaves it out of `suite` (a law known to be false, or a '
                       'separate target); no theorem in the proof' % t)
            rows[t] = (OUTSIDE_SUITE, [], None)
        else:
            rep.append('- `%s`: contract theorem **missing** from the proof' % t)
            rows[t] = ('MISSING', [], None)
            ok = False
    return rep, rows, ok


def verdict(ok, rows):
    """The exit status of `qp verify`: every check holds, every theorem is proved (a known-false law that
    the contract leaves out of the suite may be absent), and at least one is."""
    sts = [r[0] for r in rows.values()]
    return bool(ok and any(s.startswith('PROVED') for s in sts)
                and all(s.startswith('PROVED') or s == OUTSIDE_SUITE for s in sts))


BUILD_ARTIFACT = re.compile(r'\.(vo|vos|vok|vio|vof|vof\.meta|glob|aux|cache)$|(^|/)(CoqMakefile\S*|\.CoqMakefile\.d)$')


def remove_build_artifacts(d):
    """Committed .vo/.glob/... files must not be trusted: a checkout makes them look up to date."""
    out = [f for f in sh(['git', '-C', d, 'ls-files'], capture=True).stdout.split() if BUILD_ARTIFACT.search(f)]
    for f in out:
        if os.path.lexists(os.path.join(d, f)):   # a resumed run removed them before
            os.remove(os.path.join(d, f))
    return out


def program_only_contract(text, logical):
    """A contract file that holds only its program (no `Theorem law`), its law stated in a laws.v: kept as
    committed by pristine_contracts, since regenerating it would clash with laws.v."""
    pp = program_part(text)
    if pp is None or re.search(r'\b%s\.proof\.' % re.escape(logical), coq_code(pp)):
        return False
    return not coq_code(text[len(pp):]).strip()


def pristine_contracts(bd):
    """The statements to compare against, elaborated without the proof, at the contract commit `bd`: every law's
    contract file and suite.v generated again from the harnesses by the trusted new_contract.py, so that a committed
    program or statement that is not the generator's shows up as a changed statement; kept as committed are only the
    unit files (src/units.v, or src/units/*.v), the program-only contract files of laws stated in a laws.v, and that
    laws.v (a file of src/contracts/ that Requires no module of the proof).  The proof sources are dropped:
    src/proof/, and the other files of src/contracts/ that Require a module of the proof.
    A kept program-only file must still hold the program the generator writes for its harness (its program part,
    comments aside, equal to that of the regenerated file); those that do not are returned as the third element.
    Returns (files kept as committed, contract files generated again, kept files whose program is not the
    generator's)."""
    gen = os.path.join(bd, FW, 'tools', 'new_contract.py')
    if not (os.path.exists(gen) and os.path.exists(os.path.join(bd, CONF))):
        return [], [], []
    logical = logical_of(bd)
    committed = {f: open(f).read() for f in glob.glob(os.path.join(bd, 'src', 'contracts', '*.v'))}
    units_text = {rel: open(os.path.join(bd, rel)).read() for rel in unit_files(bd)}
    suite = os.path.join(bd, 'src', 'contracts', 'suite.v')
    harnesses = [os.path.basename(h)[:-2] for h in glob.glob(os.path.join(bd, 'harness', '*.c'))]
    excl = []
    if os.path.exists(suite):
        text = open(suite).read()
        excl = [h for h in harnesses if '.contracts.%s.whole_prog' % h not in text]
    sh(['python3', gen, CONF, logical, '--force', '--suite-exclude', ','.join(excl)],
       cwd=bd, capture=True, check=False)
    # Only the program-only contract files (whose law is stated in a laws.v) are kept as committed: regenerating
    # them would add a second `Theorem law` and clash with laws.v.  A bare contract that holds its own
    # `Theorem law : harness_safe whole_prog. Admitted.` is regenerated from the harness by the trusted generator
    # and left so, and the committed one (program and statement) is compared against it in build_and_probe: a
    # committed whole_prog that is not the one the harness generates then shows up as a changed statement.
    kept = sorted(f for f, text in committed.items() if f != suite and program_only_contract(text, logical))
    norm = lambda t: ' '.join(coq_code(t or '').split())
    not_generated = []
    for f in kept:
        generated = open(f).read() if os.path.exists(f) else ''
        if norm(program_part(generated)) != norm(program_part(committed[f])):
            not_generated.append(os.path.relpath(f, bd))
        open(f, 'w').write(committed[f])
    # Another file of src/contracts (laws.v: the laws stated as projections of suite, on the programs of the
    # program-only contract files kept above) stays as committed when it Requires no module of the proof; one
    # that does is a proof file and goes with the other proof sources.
    for f in glob.glob(os.path.join(bd, 'src', 'contracts', '*.v')):
        if os.path.basename(f)[:-2] not in harnesses + ['suite'] and f not in kept:
            if re.search(r'\b%s\.proof\.' % re.escape(logical), coq_code(committed.get(f, ''))):
                os.remove(f)
            else:
                open(f, 'w').write(committed[f])
                kept.append(f)
    for rel, text in units_text.items():
        open(os.path.join(bd, rel), 'w').write(text)
    shutil.rmtree(os.path.join(bd, 'src', 'proof'), ignore_errors=True)
    regenerated = sorted(os.path.relpath(f, bd) for f in glob.glob(os.path.join(bd, 'src', 'contracts', '*.v'))
                         if f not in kept)
    return [os.path.basename(f)[:-2] for f in kept], regenerated, not_generated


def regenerated_diff(d):
    """Files under src/ whose regeneration differs from the committed version, ignoring the recorded
    absolute path of the source (Info.source_file)."""
    out = []
    for f in sh(['git', '-C', d, 'diff', '--name-only', '--', 'src'], capture=True).stdout.split():
        diff = sh(['git', '-C', d, 'diff', '-U0', '--', f], capture=True).stdout
        changes = [l for l in diff.split('\n') if l and l[0] in '+-' and not l.startswith(('+++', '---'))]
        if any('Definition source_file :=' not in l for l in changes):
            out.append(f)
    out += sh(['git', '-C', d, 'ls-files', '--others', '--exclude-standard', '--', 'src'], capture=True).stdout.split()
    return [f for f in out if not BUILD_ARTIFACT.search(f)]


QUALIFIERS = """
## What "proved" means here

- The theorem is `harness_safe whole_prog`: VST's `semax_prog` for the harness linked with the code under
  test, the framework's plain-C libc and malloc unit, in the honest environment `QuickProof.Env`. The step
  from `semax_prog` to "no execution has undefined behaviour in CompCert's Clight semantics" is VST's
  adequacy theorem. It is not yet instantiated mechanically for this environment, and the abstract
  malloc library of VST (`mem_mgr`, `malloc_token`) remains a parameter.
- The code under test is the upstream code plus the idiom patch in `code.patch`, in the configuration of
  `quickproof.conf`, for CompCert's 64-bit x86 model. The patch is checked equivalent by differential
  testing, not by proof.
- The claim is exactly the harness, including its size bounds and its stated exclusions. It is partial
  correctness: an execution that never returns is not a counterexample.
- Trusted: Coq, VST, CompCert's Clight semantics and clightgen, the framework's rewriting of clightgen's
  output (per-unit renaming, tags of typedef'd anonymous composites), and `qp verify`.
"""


def workspace_git():
    """(the git top level of the workspace, its HEAD), or (None, None) when the workspace is not in a git repository."""
    r = sh(['git', '-C', WORKSPACE, 'rev-parse', '--show-toplevel', 'HEAD'], check=False, capture=True)
    out = (r.stdout or '').split()
    return (out[0], out[1]) if r.returncode == 0 and len(out) == 2 else (None, None)


def tree_files(root, paths):
    """The files at or under `paths` (files or directories, relative) of a tree, relative to it, sorted."""
    out = set()
    for c in paths:
        f = os.path.join(root, c)
        if os.path.islink(f):
            continue
        if os.path.isfile(f):
            out.add(os.path.normpath(c))
        elif os.path.isdir(f):
            for dp, _, fns in os.walk(f):
                out |= {os.path.relpath(os.path.join(dp, n), root) for n in fns if os.path.isfile(os.path.join(dp, n))}
    return sorted(out)


def export(p, repo, rev, label, base='contract', verbose=False):
    d, ok, res = verify(repo, rev, base, verbose=verbose)
    proved = [t for t, (st, _, _) in res.items() if st.startswith('PROVED')]
    if 'suite' in proved:   # every law of the suite's conjunction is proved by it
        stext = open(os.path.join(d, 'src', 'contracts', 'suite.v')).read()
        proved += [l for l in re.findall(r'harness_safe \w+\.contracts\.(\w+)\.whole_prog', stext) if l not in proved]
    if not ok or not proved:
        die('not exported: %s' % ('frozen-file check failed' if not ok else 'no theorem proved'))
    rev_full = sh(['git', '-C', d, 'rev-parse', 'HEAD'], capture=True).stdout.strip()
    label = label or '%s-%s' % (datetime.date.today().isoformat(), rev_full[:8])
    out = os.path.join(p.dir, 'proofs', label)
    if os.path.exists(out):
        die('%s exists' % out)
    # before writing the export, which would otherwise count as an uncommitted change itself
    # (a runs/ directory holds logs, not inputs of the proof)
    top, ws_rev = workspace_git()
    rel = top and os.path.relpath(os.path.realpath(p.dir), os.path.realpath(top))
    dirty = top and sh(['git', '-C', top, 'status', '--porcelain', '--', rel, ':!' + os.path.join(rel, 'runs')],
                       capture=True).stdout.strip()
    os.makedirs(out)
    n = 0
    for f in glob.glob(os.path.join(d, 'src', '**', '*.v'), recursive=True):
        rel = os.path.relpath(f, d)
        if rel.endswith('/code.v'):      # the unit files are carried: contract files (frozen), not always generated
            continue
        os.makedirs(os.path.dirname(os.path.join(out, rel)), exist_ok=True)
        shutil.copy(f, os.path.join(out, rel)); n += 1
    shutil.copy(os.path.join(d, '_CoqProject'), out)
    for rel in other_sources(d):     # e.g. Coq files outside src/, vendored libraries and run/prebuild
        os.makedirs(os.path.dirname(os.path.join(out, rel)), exist_ok=True)
        shutil.copy(os.path.join(d, rel), os.path.join(out, rel)); n += 1
    if os.path.isdir(os.path.join(d, 'wiki')):
        shutil.copytree(os.path.join(d, 'wiki'), os.path.join(out, 'wiki'))
    shutil.copy(os.path.join(d, 'VERIFY.md'), out)
    fw = sh(['git', '-C', os.path.join(d, FW), 'rev-parse', 'HEAD'], capture=True).stdout.strip()
    # The code under test exactly as verified, as a patch against upstream at COMMIT: a rebuild does not
    # depend on the project's current PATCH.
    # The project files too (harness/, patch/, env.c, env/, quickproof.conf): a PATCH may change them as well (e.g. an
    # extracted function patched like the upstream code).
    orig = materialize(p, tree_path(p, False), False)
    proj = sorted(os.path.relpath(f, orig) for x in (CONF, 'env.c', 'env', 'harness', 'patch')
                  for f in ([os.path.join(orig, x)] if os.path.isfile(os.path.join(orig, x)) else
                            glob.glob(os.path.join(orig, x, '**', '*'), recursive=True))
                  if os.path.isfile(f) and os.path.isfile(os.path.join(d, os.path.relpath(f, orig))))
    # the files of the code under test: CODE's files and the files under its directories (empty CODE: the whole
    # upstream tree), as upstream has them and as verified (a file the patch adds is diffed against nothing)
    code_paths = p.code or [x for x in os.listdir(orig) if x not in (FW, CONF, 'env.c', 'env', 'harness', 'patch', 'build')]
    code = sorted(set(tree_files(orig, code_paths)) | set(tree_files(d, p.code)))
    diffs = []
    for c in code + [f for f in proj if f not in code]:
        r = sh(['diff', '-u', '-N', '--label', 'a/' + c, '--label', 'b/' + c, os.path.join(orig, c), os.path.join(d, c)],
               check=False, capture=True)
        diffs.append(r.stdout or '')
    if any(diffs):
        open(os.path.join(out, 'code.patch'), 'w').write(''.join(diffs))
    code_sha = ['CODE_SHA256 %s %s' % (hashlib.sha256(open(os.path.join(d, c), 'rb').read()).hexdigest(), c)
                for c in code if os.path.isfile(os.path.join(d, c))]
    contract_sha = []
    for pat in ('harness/*', 'env.c', 'env/*.c', CONF, 'src/**/code.v', 'src/units.v', 'src/units/*.v'):
        for f in sorted(glob.glob(os.path.join(d, pat), recursive=True)):
            if os.path.isfile(f):
                contract_sha.append('SHA256 %s %s' % (hashlib.sha256(open(f, 'rb').read()).hexdigest(), os.path.relpath(f, d)))
    open(os.path.join(out, 'PROOF.md'), 'w').write(
        '# Proof %s of %s\n\nProved (Qed, checked by `qp verify`, see VERIFY.md): %s.\n\n'
        'COMMIT=%s\nFRAMEWORK=%s\nWORKSPACE=%s%s\nSOURCE=%s@%s\n\n'
        'Rebuild from upstream and the workspace alone: `tools/qp rebuild %s %s`.\n'
        'The files here are the proof sources and the contract files (the unit files `src/units.v` or\n'
        '`src/units/*.v` among them): the Clight\n'
        '(`code.v`) is generated from upstream at COMMIT, the project files and the framework at FRAMEWORK.\n' % (
            label, p.name, ', '.join('`%s`' % t for t in sorted(proved)), p.commit, fw, ws_rev or '-',
            '  # project files had uncommitted changes at export' if dirty else
            '  # the workspace is not a git repository' if not top else '', repo, rev_full, p.name, label)
        + '\nThe code under test the proof was checked on (after the patch; `code.patch` is its diff against upstream\n'
        'and the project files):\n\n' + '\n'.join(code_sha) + '\n'
        + '\nThe contract inputs as verified (harnesses, configuration, generated Clight):\n\n' + '\n'.join(contract_sha) + '\n'
        + QUALIFIERS)
    print('exported %d files to %s' % (n, out))


def rebuild(p, label):
    d = os.path.join(p.dir, 'proofs', label)
    meta = dict(re.findall(r'^(\w+)=(\S+)', open(os.path.join(d, 'PROOF.md')).read(), re.M))
    out = os.path.join(CACHE, 'rebuild', '%s-%s' % (p.name, label))
    pf = None
    top, _ = workspace_git()
    if top and re.fullmatch(r'[0-9a-f]{40}', meta.get('WORKSPACE', '')) and \
            sh(['git', '-C', top, 'cat-file', '-e', meta['WORKSPACE'] + '^{commit}'], check=False, capture=True).returncode == 0:
        # the project files as committed at the export
        pf = os.path.join(CACHE, 'rebuild', 'project-files-%s' % p.name)
        shutil.rmtree(pf, ignore_errors=True); os.makedirs(pf)
        rel = os.path.relpath(os.path.realpath(p.dir), os.path.realpath(top))
        sh('git -C %s archive %s -- %s | tar -x -C %s --strip-components=%d' % (
            shlex.quote(top), meta['WORKSPACE'], shlex.quote(rel), shlex.quote(pf), len(rel.split('/'))))
    exact = os.path.exists(os.path.join(d, 'code.patch'))
    materialize(p, out, not exact, commit=meta['COMMIT'], framework=framework_dir(meta['FRAMEWORK']), project_files=pf)
    if exact:
        sh('patch -s -p1 < %s' % shlex.quote(os.path.join(d, 'code.patch')), cwd=out)
    for sha, c in re.findall(r'^CODE_SHA256 (\w+) (\S+)', open(os.path.join(d, 'PROOF.md')).read(), re.M):
        now = hashlib.sha256(open(os.path.join(out, c), 'rb').read()).hexdigest() if os.path.exists(os.path.join(out, c)) else None
        if now != sha:
            print('WARNING: %s differs from the file the proof was checked on (patch or pin changed)' % c)
    sh([FW + '/tools/clight.sh', CONF], cwd=out, coq=True, capture=True)
    shutil.copy(os.path.join(d, '_CoqProject'), out)
    if os.path.exists(os.path.join(out, 'src', 'contracts')) or glob.glob(os.path.join(d, 'src', 'contracts', '*.v')):
        sh(['python3', FW + '/tools/new_contract.py', CONF, logical_of(out), '--suite-exclude', ','.join(p.broken)],
           cwd=out, capture=True)
    fresh = {os.path.relpath(f, out): open(f).read() for f in glob.glob(os.path.join(out, 'src', 'contracts', '*.v'))}
    for rel in unit_files(d):
        if os.path.exists(os.path.join(out, rel)) and \
                coq_code(open(os.path.join(d, rel)).read()) != coq_code(open(os.path.join(out, rel)).read()):
            print('note: %s: the contract\'s own (in the export) differs from the one generated now; it is used' % rel)
    exported = set(os.path.relpath(f, d) for f in glob.glob(os.path.join(d, 'src', 'contracts', '*.v')))
    for rel in sorted(set(fresh) - exported) if exported else []:
        # generated for a harness whose law the export does not claim (a known-false law, left out of the suite)
        os.remove(os.path.join(out, rel))
        print('note: %s: generated, not in the export (a law it does not claim): removed' % rel)
    moved = {}
    for f in glob.glob(os.path.join(d, 'src', '**', '*.v'), recursive=True):
        rel = os.path.relpath(f, d)
        have = open(f).read()
        if rel in fresh:
            want = fresh[rel]
            if statement_part(want) is not None and statement_part(have) is None:
                # the law is stated in another contract file (laws.v): this one keeps the generated program
                moved[re.search(r'^Theorem (\w+)', want, re.M).group(1)] = rel
                if coq_code(program_part(want)) != coq_code(program_part(have)):
                    print('WARNING: %s: the program part differs from the one generated now' % rel)
            elif (statement_code(want) != statement_code(have)
                  or coq_code(suite_statement(want)) != coq_code(suite_statement(have))):
                # comments aside (the generated header names the framework's path, a symlink here), and the
                # Require lines a proof in the contract file adds
                print('WARNING: %s: the statement differs from the one generated now' % rel)
        os.makedirs(os.path.dirname(os.path.join(out, rel)), exist_ok=True)
        shutil.copy(f, os.path.join(out, rel))
    # the export's other files (qp export's other_sources: Coq files outside src/, run/prebuild and its projects)
    for f in glob.glob(os.path.join(d, '**', '*'), recursive=True):
        rel = os.path.relpath(f, d)
        if os.path.isdir(f) or rel.split('/')[0] in ('src', 'wiki') or rel in ('PROOF.md', 'VERIFY.md', 'code.patch', '_CoqProject'):
            continue
        os.makedirs(os.path.dirname(os.path.join(out, rel)), exist_ok=True)
        shutil.copy(f, os.path.join(out, rel))
    pre_ok, line = prebuild(out, git=False)
    if line:
        print(line.lstrip('- '))
    thms = theorems_of(out)
    for law, rel in sorted(moved.items()):
        if thms.get(law, (None, None))[1] != [module_of(out, rel) + '.whole_prog']:
            print('WARNING: %s: no theorem %s on its whole_prog in the export' % (rel, law))
    res = build_and_probe(out, thms)
    for t, (st, ax, _) in sorted(res.items()):
        print('%-24s %s' % (t, st))
    admits = source_admits(out)
    print('Admitted/admit/Axiom/Parameter/Conjecture in the Coq sources (comments excluded): %s'
          % ('none' if not admits else ', '.join('%s (%s)' % h for h in admits)))
    print('(tree: %s)' % out)


