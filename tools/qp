def fuzz_conf(p):
    """projects/NAME/fuzz.conf (optional): IMPORT_OPTS (defaults of import-fuzz) and the upstream build of
    the original targets for `qp fidelity` (ORIG_CC, ORIG_SANITIZE, ORIG_CFLAGS, ORIG_SOURCES)."""
    path = os.path.join(p.dir, 'fuzz.conf')
    keys = ['IMPORT_OPTS', 'ORIG_CC', 'ORIG_SANITIZE', 'ORIG_CFLAGS', 'ORIG_SOURCES', 'ORIG_RUN_OPTS']
    if not os.path.exists(path):
        return {k: [] for k in keys}
    return source(path, keys)


def import_parser():
    a = argparse.ArgumentParser(prog='qp import-fuzz', add_help=False)
    a.add_argument('--law')
    a.add_argument('--max-len', type=int)
    a.add_argument('--stateful', help='K (at most K calls) or "unbounded"')
    a.add_argument('--style', choices=['libfuzzer', 'afl', 'honggfuzz'], default='libfuzzer')
    a.add_argument('--entry', metavar='FN')
    a.add_argument('--alloc', choices=['limit', 'assume', 'may-fail'])      # default: limit (libfuzzer), else assume
    a.add_argument('--malloc-limit-mb', type=int, default=2048)
    a.add_argument('--leaks', dest='leaks', action='store_true', default=None)  # default: libfuzzer only
    a.add_argument('--no-leaks', dest='leaks', action='store_false')
    a.add_argument('--init', dest='init', nargs='?', const='yes', default='auto', metavar='FN')
    a.add_argument('--no-init', dest='init', action='store_const', const='no')
    a.add_argument('--cleanup', metavar='FN')
    a.add_argument('--define', action='append', default=[], metavar='NAME[=VALUE]')
    a.add_argument('--const-input', choices=['full', 'loose', 'off'])          # default: full (libfuzzer), else off
    a.add_argument('--support', action='append', default=[], metavar='FILE')
    a.add_argument('--alloc-hook', action='append', default=[], metavar='NAME=KIND')
    a.add_argument('--no-check', action='store_true')
    a.add_argument('--contract', action='store_true')
    return a


def law_name_of(target):
    stem = os.path.basename(target)
    stem = re.sub(r'\.c$', '', stem)
    stem = re.sub(r'(_fuzzer|_fuzz|_target)$', '', stem)
    stem = re.sub(r'^(fuzz_|fuzzer_)', '', stem)
    stem = re.sub(r'[^A-Za-z0-9_]', '_', stem)
    if not re.match(r'[A-Za-z_]', stem):
        stem = 'fz_' + stem
    return stem


def upstream_file(p, path):
    """The bytes of an upstream file at the pinned commit."""
    repo = upstream_repo(p.upstream, p.commit)
    r = subprocess.run(['git', '-C', repo, 'show', '%s:%s' % (p.commit, path)], capture_output=True)
    if r.returncode:
        die('%s: not in upstream %s at %s' % (path, p.upstream, p.commit[:12]))
    return r.stdout


def sha256(b):
    return hashlib.sha256(b).hexdigest()


def fuzz_options(p, argv):
    """The effective options of an import: fuzz.conf's IMPORT_OPTS, then the command line."""
    a = import_parser().parse_args(fuzz_conf(p)['IMPORT_OPTS'] + argv)
    if a.max_len is not None and a.max_len < 0:
        die('--max-len must be >= 0')
    stateful = None
    if a.stateful is not None:
        if a.stateful == 'unbounded':
            stateful = 'unbounded'
        elif re.fullmatch(r'[1-9]\d*', a.stateful):
            stateful = int(a.stateful)
        else:
            die('--stateful takes a positive number or "unbounded"')
    if a.malloc_limit_mb <= 0 or a.malloc_limit_mb >= 1 << 40:
        die('--malloc-limit-mb out of range')
    # the defaults of the engine: libFuzzer reports leaks, const-input writes and big mallocs; AFL++ and honggfuzz
    # (persistent mode) report none of them, and they set no memory limit
    lf = a.style == 'libfuzzer'
    a.alloc = a.alloc or ('limit' if lf else 'assume')
    a.leaks = lf if a.leaks is None else a.leaks
    a.const_input = a.const_input or ('full' if lf else 'off')
    for opt, fn in (('--entry', a.entry), ('--init', a.init if a.init not in ('auto', 'yes', 'no') else None),
                    ('--cleanup', a.cleanup)):
        if fn is not None and not re.fullmatch(r'[A-Za-z_]\w*', fn):
            die('%s %s: not a C identifier' % (opt, fn))
    defines = []
    for d in a.define:
        if not re.fullmatch(r'[A-Za-z_]\w*(=[^\s\'"\\]*)?', d):
            die('--define %s: expected NAME or NAME=VALUE (no spaces or quotes)' % d)
        if d not in defines:
            defines.append(d)
    a.define = defines
    hooks = []
    for h in a.alloc_hook:
        m = re.fullmatch(r'([A-Za-z_]\w*)=(malloc|calloc|free)', h)
        if not m:
            die('--alloc-hook %s: expected NAME=malloc|calloc|free' % h)
        if m.groups() not in hooks:
            hooks.append(m.groups())
    support = []
    for s in a.support:
        if s not in support:
            support.append(s)
    return a, stateful, hooks, support


def fuzz_claim(target, o):
    if o['style'] != 'libfuzzer' and o['main']:
        return fuzz_claim_main(target, o)
    e = o['entry']
    calls = {None: 'One call of %s' % e,
             'unbounded': 'Any number of calls of %s in one process (the state persists, as in a '
                          'long libFuzzer run), each' % e}.get(o['stateful'], 'Any sequence of 1 to %s calls of '
                          '%s in one process (the state persists, as in a long libFuzzer run), each'
                          % (o['stateful'], e))
    size = 'of any length' if o['max_len'] is None else 'of at most %d bytes' % o['max_len']
    hf = o['style'] == 'honggfuzz'
    t = ['Law imported from the libFuzzer target `%s`%s by tools/qp import-fuzz. %s, with an input %s (n nondet '
         'bytes in a buffer of exactly n bytes, as libFuzzer passes it)%s%s, does not crash in the sense of '
         '%s: no abort%s, no failing assert or FUZZ_ASSERT-style check, %sand no undefined behaviour '
         '(what ASan and UBSan report; CompCert\'s semantics and VST\'s type checks are stricter)'
         % (target, ' as honggfuzz runs it' if hf else '', calls, size,
            ', after one call of %s' % o['init_fn'] if o['init'] else '',
            ', and one call of %s after the last input' % o['cleanup'] if o['cleanup'] else '',
            'honggfuzz' if hf else 'libFuzzer', '' if hf else ' or exit',
            'no return value other than 0 (fatal under honggfuzz), ' if hf else '')]
    extra = []
    if o['const_input'] == 'full':
        extra.append('it does not modify its input (the whole buffer; libFuzzer compares 64 bytes)')
    elif o['const_input'] == 'loose':
        extra.append('it does not modify the first and last 32 bytes of its input (libFuzzer\'s check)')
    if o['leaks']:
        extra.append('every block it allocates is freed by the end of the run (LeakSanitizer; stronger: '
                     'a block kept reachable counts too)')
    if o['alloc'] == 'limit':
        extra.append('no allocation asks for %d MiB or more (libFuzzer\'s -malloc_limit_mb)' % o['malloc_limit_mb'])
    if o['alloc'] != 'may-fail':
        extra.append('calloc sizes do not overflow (ASan)')
    if extra:
        t.append('; ' + '; '.join(extra))
    t.append('. Assumed beyond the fuzzer: ')
    if o['alloc'] == 'limit':
        t.append('every allocation below the limit succeeds (under libFuzzer with ASan malloc never returns NULL)')
    elif o['alloc'] == 'assume':
        t.append('every allocation succeeds, whatever its size')
    else:
        t.append('nothing about allocation (it may fail anywhere, and the target must cope)')
    if o['max_len'] is None:
        t.append('; inputs of any length, also beyond what libFuzzer can hold')
    if hf:
        t.append('; exit() ends the run without error')
    t.append('. Not covered: termination (timeouts), stack and RSS exhaustion, output. A fuzz target is a weak '
             'law ("no crash") unless it checks results itself: strengthen it after import.')
    return ''.join(t)


def fuzz_claim_main(target, o):
    """The claim of a law from a harness with its own main: AFL++ persistent mode or honggfuzz's HF_ITER."""
    afl = o['style'] == 'afl'
    n = {None: 'one input, as in a reproduction run', 'unbounded': 'any number of inputs in one process (the state '
         'persists, as in a long run)'}.get(o['stateful'], 'any sequence of 1 to %s inputs in one process (the state '
                                                            'persists, as in a long run)' % o['stateful'])
    size = 'of any length' if o['max_len'] is None else 'of at most %d bytes' % o['max_len']
    if afl:
        buf = ('each input %s (n nondet bytes at the start of AFL++\'s test case buffer of %d bytes, which beyond them '
               'holds zeros or bytes of earlier inputs)' % ('of at most %d bytes' % o['afl_max'] if o['max_len'] is None
                                                             else size, o['afl_max']))
        t = ['Law imported from the AFL++ persistent-mode harness `%s` by tools/qp import-fuzz --style afl. Its main, '
             'run as in one AFL++ process with __AFL_LOOP giving %s, %s, does not crash in the sense of AFL++'
             % (target, n, buf)]
    else:
        t = ['Law imported from the honggfuzz persistent-mode harness `%s` by tools/qp import-fuzz --style honggfuzz. '
             'Its main, run as in one honggfuzz process with HF_ITER giving %s, each input %s (n nondet bytes in a '
             'buffer of exactly n bytes), does not crash in the sense of honggfuzz' % (target, n, size)]
    t.append(': no abort, no failing assert, and no undefined behaviour (what ASan and UBSan report; CompCert\'s '
             'semantics and VST\'s type checks are stricter); exit() and the end of the inputs end the run without error')
    extra = []
    if o['leaks']:
        extra.append('every block it allocates is freed by the end of the run (stronger than LeakSanitizer)')
    if o['alloc'] == 'limit':
        extra.append('no allocation asks for %d MiB or more' % o['malloc_limit_mb'])
    if o['alloc'] != 'may-fail':
        extra.append('calloc sizes do not overflow (ASan)')
    if extra:
        t.append('; ' + '; '.join(extra))
    t.append('. Assumed beyond the fuzzer: %s' % {
        'limit': 'every allocation below the limit succeeds',
        'assume': 'every allocation succeeds (no memory limit, as by default)',
        'may-fail': 'nothing about allocation (it may fail anywhere)'}[o['alloc']])
    if afl:
        t.append('. Not covered: termination (hangs), stack and RSS exhaustion, output, and reads past the input but '
                 'inside the buffer, which AFL++ does not detect either.')
    else:
        t.append('. Not covered: termination (hangs), stack and RSS exhaustion, output.')
    t.append(' A fuzz target is a weak law ("no crash") unless it checks results itself: strengthen it after import.')
    return ''.join(t)


def comment_block(text, width=104):
    out, line = [], ''
    for w in text.split():
        if line and len(line) + 1 + len(w) > width:
            out.append(line)
            line = w
        else:
            line = (line + ' ' + w) if line else w
    out.append(line)
    return '/* ' + '\n * '.join(out) + ' */'


def fuzz_canonical_command(name, target, o, hooks, support):
    args = ['tools/qp', 'import-fuzz', name, target, '--law', o['law']]
    if o['style'] != 'libfuzzer':
        args += ['--style', o['style']]
    if o['entry'] != 'LLVMFuzzerTestOneInput':
        args += ['--entry', o['entry']]
    if o['max_len'] is not None:
        args += ['--max-len', str(o['max_len'])]
    if o['stateful'] is not None:
        args += ['--stateful', str(o['stateful'])]
    args += ['--alloc', o['alloc']]
    if o['alloc'] == 'limit':
        args += ['--malloc-limit-mb', str(o['malloc_limit_mb'])]
    args.append('--leaks' if o['leaks'] else '--no-leaks')
    if o['init_given'] not in ('auto', 'yes', 'no'):
        args += ['--init', o['init_given']]
    elif o['init_given'] != 'auto':    # auto (the default): LLVMFuzzerInitialize is called iff the target defines it
        args.append('--init' if o['init'] else '--no-init')
    if o['cleanup']:
        args += ['--cleanup', o['cleanup']]
    args += ['--const-input', o['const_input']]
    for s in support:
        args += ['--support', s]
    for n, k in hooks:
        args += ['--alloc-hook', '%s=%s' % (n, k)]
    for d in o['defines']:
        args += ['--define', d]
    return ' '.join(args)


FUZZ_STYLE_SHIM = {'afl': 'afl_env.h', 'honggfuzz': 'honggfuzz_env.h'}   # after FUZZ_SHIM, for the other engines


def afl_live_text(text):
    """The text of an AFL++ harness without the regions that afl_env.h's macros switch off: `#ifndef __AFL_X` and
    the `#else` of `#ifdef __AFL_X` (the fallbacks for builds without afl-cc).  Other conditionals stay."""
    out, stack = [], []          # stack: True (live), False (dead), None (not about __AFL_)
    for line in text.splitlines():
        m = re.match(r'\s*#\s*(ifdef|ifndef|if|elif|else|endif)\b\s*(.*)', line)
        if m:
            d, arg = m.group(1), m.group(2)
            c = re.fullmatch(r'(!?)\s*defined\s*\(?\s*(__AFL_\w+)\s*\)?\s*', arg) if d == 'if' else None
            if d in ('ifdef', 'ifndef') and re.match(r'__AFL_\w+', arg):
                stack.append(d == 'ifdef')
            elif c:
                stack.append(c.group(1) != '!')
            elif d in ('ifdef', 'ifndef', 'if'):
                stack.append(None)
            elif d == 'else' and stack and stack[-1] is not None:
                stack[-1] = not stack[-1]
            elif d == 'elif' and stack and stack[-1] is not None:
                stack[-1] = False if stack[-1] else None
            elif d == 'endif' and stack:
                stack.pop()
            continue
        if False not in stack:
            out.append(line)
    return '\n'.join(out)


def main_params(code):
    """The parameters of `main` in C text (comments removed), or None if it defines no main."""
    m = re.search(r'(?m)^[\w \t*]*?\bmain\s*\(((?:[^()]|\([^()]*\))*)\)\s*\{', code)
    return None if m is None else ' '.join(m.group(1).split())


def fuzz_generate(p, target, argv):
    """The files of an imported law: {relative path in projects/NAME: bytes}, a pure function of the target
    and support files at the pinned commit, the options, the shims and FUZZ_VERSION."""
    a, stateful, hooks, support = fuzz_options(p, argv)
    tbytes = upstream_file(p, target)
    code = _strip_c(tbytes.decode('latin-1'))
    style = a.style
    entry = a.entry or 'LLVMFuzzerTestOneInput'
    # a harness with its own main: AFL++ persistent mode, honggfuzz's HF_ITER; else an entry function
    main = style == 'afl' or (style == 'honggfuzz' and re.search(r'\b(HF_ITER|HonggfuzzFetchData)\s*\(', code) is not None)
    if re.search(rb'\bFuzzedDataProvider\b|^\s*#\s*include\s*<(fuzzer/|c\+\+|iostream|string>|vector>)', tbytes, re.M) \
            or target.endswith(('.cc', '.cpp', '.cxx')):
        die('%s: C++ targets (FuzzedDataProvider, ...) are not supported (docs/FUZZ-IMPORT.md)' % target)
    params = None
    if main:
        if a.entry or a.init != 'auto' or a.cleanup:
            die('--entry, --init and --cleanup are for entry-function targets; %s runs its own main' % target)
        live = afl_live_text(code) if style == 'afl' else code
        if style == 'afl' and not re.search(r'\b(__AFL_LOOP|__AFL_FUZZ_TESTCASE_BUF|__AFL_FUZZ_TESTCASE_LEN|__AFL_INIT)\b', live):
            die('%s is not an AFL++ persistent or deferred-mode harness (no __AFL_LOOP, __AFL_FUZZ_TESTCASE_BUF/LEN or '
                '__AFL_INIT); a libFuzzer target needs no --style' % target)
        params = main_params(live)
        if params is None:
            die('%s does not define main (a %s harness runs its own main)' % (target, style))
        if params not in ('', 'void') and not re.fullmatch(r'int \w+ ?, ?(const )?char ?\*+ ?\w+(\[\])?', params):
            die('%s: main(%s) is not main(void) or main(argc, argv)' % (target, params))
        reads = re.search(r'\b(read|fread|fgets|getchar|getc|fgetc|scanf|fscanf|getline)\s*\([^;]*?\b(0|STDIN_FILENO|stdin)\b'
                          r'|\bgetchar\s*\(|\bfopen\s*\(\s*argv\b', live)
        if reads:
            die('%s reads its input itself (%s): harnesses on stdin or a file need a model of them, which import-fuzz '
                'does not have yet' % (target, ' '.join(reads.group(0).split())[:40]))
    elif not re.search(r'\b%s\s*\(' % entry, code):
        die('%s does not define %s' % (target, entry))
    defines_init = re.search(r'\bLLVMFuzzerInitialize\s*\(', code) is not None
    init_fn, init_args = None, True
    if not main:
        if a.init in ('auto', 'yes'):
            init_fn = 'LLVMFuzzerInitialize' if defines_init else None
            if a.init == 'yes' and not defines_init:
                die('--init: %s does not define LLVMFuzzerInitialize' % target)
        elif a.init != 'no':
            m = re.search(r'\b%s\s*\(([^()]*)\)' % a.init, code)
            if not m:
                die('--init %s: %s does not define it' % (a.init, target))
            sig = ' '.join(m.group(1).split())
            if sig in ('', 'void'):
                init_args = False
            elif not re.fullmatch(r'int ?\* ?\w* ?, ?char ?\* ?\* ?\* ?\w*', sig):
                die('--init %s(%s): expected (int *argc, char ***argv) or (void)' % (a.init, sig))
            init_fn = a.init
        if a.cleanup and not re.search(r'\b%s\s*\(\s*(void)?\s*\)' % a.cleanup, code):
            die('--cleanup %s: %s does not define it as a function without parameters' % (a.cleanup, target))
    init = init_fn is not None
    law = a.law or law_name_of(target)
    if not re.fullmatch(r'[A-Za-z_]\w*', law):
        die('law name %s is not a C identifier' % law)
    afl_max = a.max_len if a.max_len is not None else 1 << 20
    o = dict(law=law, max_len=a.max_len, stateful=stateful, alloc=a.alloc, malloc_limit_mb=a.malloc_limit_mb,
             leaks=a.leaks, init=init, init_given=a.init, const_input=a.const_input, style=style, entry=entry,
             init_fn=init_fn, cleanup=a.cleanup, defines=a.define, main=main, afl_max=afl_max)
    sbytes = [(s, upstream_file(p, s)) for s in support]

    def stamped(name):
        t = open(os.path.join(FUZZ_DIR, name), 'rb').read()
        return ('/* Generated by tools/qp import-fuzz (importer version %d): a copy of tools/fuzz/%s\n'
                ' * (sha256 %s); do not edit, any import into this project rewrites it. */\n'
                % (FUZZ_VERSION, name, sha256(t))).encode() + t
    shim = stamped(FUZZ_SHIM)
    sshim = stamped(FUZZ_STYLE_SHIM[style]) if style != 'libfuzzer' else None
    rel = lambda f: '../' + f          # harness/ is one level below the tree root
    opts = ' '.join([
        'law=%s' % law, 'max-len=%s' % ('none' if a.max_len is None else a.max_len),
        'stateful=%s' % ('no' if stateful is None else stateful), 'alloc=%s' % a.alloc,
        'malloc-limit-mb=%s' % (a.malloc_limit_mb if a.alloc == 'limit' else '-'),
        'leaks=%s' % ('yes' if a.leaks else 'no'),
        'init=%s%s' % (('yes' if init_fn == 'LLVMFuzzerInitialize' else init_fn or 'no') if not main else 'main',
                       ' (auto)' if a.init == 'auto' and not main else ''),
        'const-input=%s' % a.const_input,
        'alloc-hooks=%s' % (','.join('%s:%s' % h for h in hooks) or 'none')]
        + (['style=%s%s' % (style, '-main' if main else '-entry')] if style != 'libfuzzer' else [])
        + (['entry=%s' % entry] if entry != 'LLVMFuzzerTestOneInput' else [])
        + (['cleanup=%s' % a.cleanup] if a.cleanup else [])
        + (['defines=%s' % ','.join(a.define)] if a.define else []))
    L = [comment_block(fuzz_claim(target, o)), '',
         '/* %s (generated; do not edit; regenerate with the command below)' % FUZZ_MARK,
         ' *   importer:       tools/qp import-fuzz, version %d' % FUZZ_VERSION,
         ' *   command:        %s' % fuzz_canonical_command(p.name, target, o, hooks, support),
         ' *   upstream:       %s' % p.upstream_conf,
         ' *   commit:         %s' % p.commit,
         ' *   target:         %s' % target,
         ' *   target-sha256:  %s' % sha256(tbytes)]
    for s, b in sbytes:
        L.append(' *   support:        %s sha256 %s' % (s, sha256(b)))
    L.append(' *   shim:           harness/fuzz/%s sha256 %s' % (FUZZ_SHIM, sha256(shim)))
    if sshim:
        L.append(' *   style-shim:     harness/fuzz/%s sha256 %s' % (FUZZ_STYLE_SHIM[style], sha256(sshim)))
    L += [' *   options:        %s' % opts,
          ' * The sha256 are of the upstream files at the commit; the project\'s PATCH, if any, applies on top.',
          ' * Replay protocol (tools/qp replay): nondet_size() is the length of the next input, nondet_bytes its',
          ' * bytes, nondet_u8() is 1 when another input follows (--stateful). */']
    L += ['#define %s' % d.replace('=', ' ', 1) for d in a.define]
    L += ['#define QP_FUZZ_ALLOC %s' % {'limit': 'QP_FUZZ_ALLOC_LIMIT', 'assume': 'QP_FUZZ_ALLOC_ASSUME',
                                         'may-fail': 'QP_FUZZ_ALLOC_MAYFAIL'}[a.alloc]]
    if a.alloc == 'limit':
        L.append('#define QP_FUZZ_MALLOC_LIMIT ((size_t) %d << 20)   /* libFuzzer -malloc_limit_mb=%d */'
                 % (a.malloc_limit_mb, a.malloc_limit_mb))
    L.append('#define QP_FUZZ_LEAKS %d' % (1 if a.leaks else 0))
    nstate = 0 if stateful is None else -1 if stateful == 'unbounded' else stateful
    if style == 'afl':
        L += ['#define QP_AFL_MAX ((size_t) %d)%s' % (afl_max, '' if a.max_len is not None else
                                                     '          /* AFL++\'s test case buffer: 1 MiB */'),
              '#define QP_AFL_STATEFUL %d' % nstate]
    elif style == 'honggfuzz':
        konst = not re.search(r'\b(HF_ITER|HonggfuzzFetchData)\s*\(\s*(uint8_t|unsigned\s+char)\s*\*\s*\*', code)
        L += ['#define QP_HF_STATEFUL %d' % nstate, '#define QP_HF_ITER_CONST %d' % (1 if konst else 0)]
        if a.max_len is not None:
            L.append('#define QP_HF_MAX_LEN %d' % a.max_len)
    L.append('#include "fuzz/%s"' % FUZZ_SHIM)
    if sshim:
        L.append('#include "fuzz/%s"' % FUZZ_STYLE_SHIM[style])
    L.append('')
    if main:
        L += ['/* The %s harness, compiled as is%s: its main is renamed, the law\'s main calls it. */'
              % ('AFL++' if style == 'afl' else 'honggfuzz', ' with its support code' if support else ''),
              '#pragma push_macro("main")', '#undef main', '#define main qp_fuzz_target_main',
              '#include "%s"' % rel(target), '#pragma pop_macro("main")']
    else:
        L.append('/* The fuzz target%s, compiled as is, in one translation unit with the shim. */'
                 % (' and its support code' if support else ''))
        L.append('#include "%s"' % rel(target))
    for s in support:
        L.append('#include "%s"' % rel(s))
    if hooks:
        L += ['', '/* The library\'s allocation hooks, routed to the target\'s allocator (the allocation policy above). */']
        for n, k in hooks:
            sig, body = ALLOC_HOOK_KINDS[k]
            L += [sig % n, '{', '\t' + body, '}']
    if main:
        L += ['', 'int main(void)', '{']
        if params not in ('', 'void'):
            L += ['\tchar qp_fuzz_arg0[] = "qp-fuzz-law";', '\tchar *qp_fuzz_argv[2];',
                  '\tqp_fuzz_argv[0] = qp_fuzz_arg0;', '\tqp_fuzz_argv[1] = NULL;']
        L.append('\tqp_fuzz_live = 0;')
        if style == 'afl':
            L.append('\tqp_afl_setup();                          /* AFL++\'s test case buffer */')
        L.append('\t(void) qp_fuzz_target_main(%s);' % ('' if params in ('', 'void') else '1, qp_fuzz_argv'))
        if a.leaks:
            L.append('\tqp_assert(qp_fuzz_live == 0);              /* every block the harness allocated is freed */')
        L += ['\treturn 0;', '}', '']
        files = {'harness/%s.c' % law: '\n'.join(L).encode(), 'harness/fuzz/%s' % FUZZ_SHIM: shim,
                 'harness/fuzz/%s' % FUZZ_STYLE_SHIM[style]: sshim}
        return law, files, o
    if init:
        if init_fn == 'LLVMFuzzerInitialize':
            L += ['', 'int LLVMFuzzerInitialize(int *argc, char ***argv);']
        else:
            L.append('')
        if init_args:
            L.append('char qp_fuzz_arg0[] = "qp-fuzz-law";')
    L += ['', '/* One input, as %s passes it: a fresh buffer of exactly n bytes; %s. */'
          % ('honggfuzz' if style == 'honggfuzz' else 'libFuzzer',
             'a return value other than 0 is fatal' if style == 'honggfuzz' else 'the return value is ignored'),
          'static void qp_fuzz_one_input(void)', '{',
          '\tsize_t n = nondet_size();']
    if a.max_len is not None:
        L.append('\tqp_assume(n <= %d);' % a.max_len)
    L += ['\tuint8_t *data = qp_fuzz_raw_malloc(n);',
          '\tqp_assume(data != NULL);',
          '\tnondet_bytes(data, n);']
    if a.const_input != 'off':
        L += ['\tuint8_t *copy = qp_fuzz_raw_malloc(n);',
              '\tqp_assume(copy != NULL);',
              '\tmemcpy(copy, data, n);']
    if style == 'honggfuzz':
        L.append('\tqp_assert(%s(data, n) == 0);              /* honggfuzz: a non-zero return is fatal */' % entry)
    else:
        L.append('\t(void) %s(data, n);' % entry)
    if a.const_input == 'full':
        L.append('\tqp_assert(memcmp(copy, data, n) == 0);        /* the target does not modify its input */')
    elif a.const_input == 'loose':
        L += ['\tif (n <= 64) {',
              '\t\tqp_assert(memcmp(copy, data, n) == 0);    /* libFuzzer\'s LooseMemeq */',
              '\t} else {',
              '\t\tqp_assert(memcmp(copy, data, 32) == 0);',
              '\t\tqp_assert(memcmp(copy + (n - 32), data + (n - 32), 32) == 0);',
              '\t}']
    if a.const_input != 'off':
        L.append('\tqp_fuzz_raw_free(copy);')
    L += ['\tqp_fuzz_raw_free(data);', '}', '', 'int main(void)', '{']
    if isinstance(stateful, int):
        L.append('\tsize_t qp_fuzz_calls = 0;')
    L.append('\tqp_fuzz_live = 0;')
    if init and init_args:
        L += ['\tchar *qp_fuzz_argv[2];', '\tqp_fuzz_argv[0] = qp_fuzz_arg0;', '\tqp_fuzz_argv[1] = NULL;',
              '\tint qp_fuzz_argc = 1;', '\tchar **qp_fuzz_argvp = qp_fuzz_argv;',
              '\t(void) %s(&qp_fuzz_argc, &qp_fuzz_argvp);' % init_fn]
    elif init:
        L.append('\t(void) %s();' % init_fn)
    if stateful is None:
        L.append('\tqp_fuzz_one_input();')
    else:
        L += ['\tfor (;;) {', '\t\tqp_fuzz_one_input();']
        if isinstance(stateful, int):
            L += ['\t\tqp_fuzz_calls = qp_fuzz_calls + 1;', '\t\tif (qp_fuzz_calls == %d)' % stateful, '\t\t\tbreak;']
        L += ['\t\tif (nondet_u8() == 0)', '\t\t\tbreak;', '\t}']
    if a.cleanup:
        L.append('\t(void) %s();' % a.cleanup)
    if a.leaks:
        L.append('\tqp_assert(qp_fuzz_live == 0);              /* every block the target allocated is freed */')
    L += ['\treturn 0;', '}', '']
    files = {'harness/%s.c' % law: '\n'.join(L).encode(), 'harness/fuzz/%s' % FUZZ_SHIM: shim}
    if sshim:
        files['harness/fuzz/%s' % FUZZ_STYLE_SHIM[style]] = sshim
    return law, files, o


def fuzz_imported_laws(pdir):
    out = []
    for h in sorted(glob.glob(os.path.join(pdir, 'harness', '*.c'))):
        if FUZZ_MARK in open(h, errors='replace').read(4096):
            out.append(os.path.basename(h)[:-2])
    return out


def fuzz_conf_block(conf_text, laws):
    """quickproof.conf with the managed block of imported law units set to `laws`."""
    text = re.sub(r'\n?# >>> qp import-fuzz:[^\n]*\n.*?' + re.escape(FUZZ_CONF_END) + r'\n', '\n', conf_text, flags=re.S)
    text = text.rstrip('\n') + '\n'
    if laws:
        text += '\n%s\nUNITS+=(\n%s)\n%s\n' % (FUZZ_CONF_BEGIN, ''.join('  "harness/%s.c=src/harness/%s"\n' % (l, l)
                                                                       for l in laws), FUZZ_CONF_END)
    return text


def fuzz_header(path):
    """The provenance fields of an imported law."""
    text = open(path, errors='replace').read()
    if FUZZ_MARK not in text:
        die('%s is not a law of tools/qp import-fuzz' % path)
    block = text.split(FUZZ_MARK, 1)[1].split('*/', 1)[0]
    f = {}
    for m in re.finditer(r'^ \*   ([\w-]+):\s+(.*)$', block, re.M):
        if m.group(1) == 'support':
            f.setdefault('support', []).append(m.group(2).split()[0])
        else:
            f[m.group(1)] = m.group(2).strip()
    f['opts'] = dict(kv.split('=', 1) for kv in re.findall(r'[\w-]+=\S+', f.get('options', '')))
    return f


def fuzz_cone(p, law):
    """Translate the law's program with clightgen (tools/clight.sh) and list what it needs outside itself:
    external functions other than the framework environment, and global variables without a definition."""
    tree = materialize(p, tree_path(p, True, private=True), True)
    r = sh([FW + '/tools/clight.sh', CONF], cwd=tree, coq=True, check=False, capture=True)
    if r.returncode:
        return ['clightgen failed (an idiom to patch?):'] + [l for l in (r.stdout or '').splitlines()
                                                             if 'error' in l.lower()][:12]
    gp = os.path.realpath(os.path.join(tree, FW))
    v = source(os.path.join(tree, CONF), ['UNITS'], gp)
    outs = [u.split('=', 1)[1] for u in v['UNITS']]
    outs = [o for o in outs if not o.startswith('src/harness/') or o == 'src/harness/' + law]
    internal, external, gvars_undef, gvars_def = set(), set(), set(), set()
    for o in outs:
        c = open(os.path.join(tree, o, 'code.v'), errors='replace').read()
        internal |= set(re.findall(r'^Definition f_(\w+) := \{\|', c, re.M))
        external |= set(re.findall(r'EF_external "(\w+)"', c))
        for name, init in re.findall(r'^Definition v_(\w+) := \{\|\n\s*gvar_info := [^\n]*\n\s*gvar_init := (\S+)', c, re.M):
            (gvars_undef if init.startswith('nil') else gvars_def).add(name)
    # every unit declares CompCert's __builtin_debug as an external; builtins are not calls of the program
    missing = sorted(x for x in external - internal - ENV_EXTERNALS if not x.startswith('__builtin_'))
    undef = sorted(gvars_undef - gvars_def)
    out = ['VST blocker: ' + l for l in clight_blockers(tree, [law])
           if 'external outside the framework environment' not in l]
    if missing:
        out.append('external functions outside the framework environment (no specification in the theorem): '
                   + ', '.join(missing))
    if undef:
        out.append('global variables declared but not defined (e.g. stderr): ' + ', '.join(undef))
    return out


def import_fuzz(p, target, argv):
    law, files, o = fuzz_generate(p, target, argv)
    a = fuzz_options(p, argv)[0]
    # the tree must contain the target and its support files (CODE in project.conf)
    paths = [target] + fuzz_options(p, argv)[3]
    if p.code:
        uncovered = [f for f in paths if not any(f == c or f.startswith(c.rstrip('/') + '/') for c in p.code)]
        if uncovered:
            die('CODE in project.conf does not cover %s (add the files, or their directory)' % ', '.join(uncovered))
    for rel_, data in sorted(files.items()):
        dst = os.path.join(p.dir, rel_)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        old = open(dst, 'rb').read() if os.path.exists(dst) else None
        if old is not None and rel_.endswith('.c') and FUZZ_MARK.encode() not in old:
            die('%s exists and is not an imported law; choose another --law' % dst)
        if old != data:
            open(dst, 'wb').write(data)
        print('%s %s' % ('unchanged' if old == data else 'wrote', os.path.relpath(dst, WORKSPACE)))
    conf = os.path.join(p.dir, CONF)
    text = open(conf).read()
    new_text = fuzz_conf_block(text, fuzz_imported_laws(p.dir))
    if new_text != text:
        open(conf, 'w').write(new_text)
        print('updated %s (imported law units)' % os.path.relpath(conf, WORKSPACE))
    if a.no_check:
        return
    print('== the law\'s program (clightgen: externals and undefined globals)')
    cone = fuzz_cone(p, law)
    print('\n'.join(cone) if cone else 'ok: only the framework environment is external, no VST blocker in the cone')
    if a.contract:
        out = os.path.join(CACHE, 'fuzz-contract', '%s.%d' % (p.name, os.getpid()))
        shutil.rmtree(out, ignore_errors=True)
        assemble(p, out)
        sh('coq_makefile -f _CoqProject -o CoqMakefile', cwd=out, coq=True, capture=True)
        r = sh(['make', '-f', 'CoqMakefile', '-j%d' % njobs(build=True), 'src/contracts/%s.vo' % law], cwd=out,
               coq=True, check=False, capture=True)
        print('== contract src/contracts/%s.v: %s' % (law, 'builds' if r.returncode == 0 else 'FAILED\n' +
                                                      (r.stdout or '')[-2500:]))
        shutil.rmtree(out, ignore_errors=True)


# ---- replay: the law on concrete inputs, natively and under CompCert's interpreter ----

def classify_native(rc, out):
    if rc == 0:
        return 'pass', ''
    if rc == 3 and 'gp_assume failed' in out:
        return 'not covered', 'an assumption of the law is false (e.g. --max-len)'
    if rc == 124:
        return 'timeout', ''
    m = re.search(r'ERROR: (AddressSanitizer|LeakSanitizer|libFuzzer): ([\w-]+(?: [\w-]+)?)', out)
    if 'replay: gp_assert failed' in out:
        return 'fail', 'check (gp_assert)'
    if m:
        return 'fail', '%s %s' % (m.group(1), m.group(2))
    m = re.search(r'runtime error: ([^\n]{0,70})', out)
    if m:
        return 'fail', 'UBSan: ' + m.group(1)
    if 'Assertion' in out and 'failed' in out:
        return 'fail', 'assertion'
    if 'deadly signal' in out:
        return 'fail', 'deadly signal'
    if 'out-of-memory' in out:
        return 'fail', 'out-of-memory'
    if 'replay:' in out and rc == 4:
        return 'error', out.strip().splitlines()[-1][:100]
    return 'fail', 'exit %d' % rc


def private_tree(p, patched, tag=''):
    """A private tree (removed at exit), with a tag for several in one process (seeded faults)."""
    d = tree_path(p, patched, private=True) + tag
    if tag:
        import atexit
        atexit.register(shutil.rmtree, d, True)
    return materialize(p, d, patched)


def law_replay_binary(p, law, patched=True, fault=None, tag=''):
    """The law built natively (ASan/UBSan, as `qp fuzz`) with tools/fuzz/replay_main.c as its driver."""
    tree = private_tree(p, patched, tag)
    for f in fault or []:
        apply_fault(tree, f)
    n = Native(tree)
    objs, err = n.lib_objs()
    if objs is None:
        die('library build failed: ' + err[-2000:])
    ho = n.harness_obj(law)
    drv = n.cc(os.path.join(FUZZ_DIR, 'replay_main.c'), 'replay_main.o', opt='-O1')
    exe = os.path.join(n.b, 'replay_' + law)
    if not ho or not drv or sh(['gcc'] + SAN + [ho] + objs + [drv, '-o', exe], check=False, capture=True).returncode:
        die('build of the law %s failed (try `tools/qp fuzz %s %s`)' % (law, p.name, law))
    return exe


def replay_native(exe, inputs, timeout=30):
    r = sh([exe] + list(inputs), check=False, capture=True, timeout=timeout,
           env=NATIVE_ENV)
    rc = r.returncode
    if rc < 0:      # killed by a signal: the run failed
        rc = 128 - rc
    return classify_native(rc, r.stdout or '')


def replay_env_c(blobs):
    """A GP_ENV file for quickproof/tools/interp.sh that serves the replay protocol from embedded inputs."""
    L = ['/* tools/qp replay --interp: the nondet_* of a law of tools/qp import-fuzz, from embedded inputs (generated). */',
         '#include <stddef.h>', '#include <stdint.h>']
    for i, b in enumerate(blobs):
        L.append('static const unsigned char qp_replay_in%d[%d] = {%s};' % (i, max(1, len(b)), ','.join(map(str, b)) or '0'))
    L += ['static const unsigned char *const qp_replay_inputs[%d] = {%s};' % (len(blobs), ','.join('qp_replay_in%d' % i for i in range(len(blobs)))),
          'static const size_t qp_replay_lengths[%d] = {%s};' % (len(blobs), ','.join('%dU' % len(b) for b in blobs)),
          'static int qp_replay_next = 0, qp_replay_cur = -1;',
          'size_t nondet_size(void) {',
          '  if (qp_replay_next >= %d) for (;;) {}   /* not the replay protocol: diverge (reported as skipped) */' % len(blobs),
          '  qp_replay_cur = qp_replay_next; qp_replay_next = qp_replay_next + 1;',
          '  return qp_replay_lengths[qp_replay_cur];', '}',
          'void nondet_bytes(uint8_t *buf, size_t n) {',
          '  size_t i;',
          '  if (qp_replay_cur < 0 || n != qp_replay_lengths[qp_replay_cur]) for (;;) {}',
          '  for (i = 0; i < n; i = i + 1) buf[i] = qp_replay_inputs[qp_replay_cur][i];', '}',
          'uint8_t nondet_u8(void) { return qp_replay_next < %d; }' % len(blobs),
          'uint32_t nondet_u32(void) { return 0; }', '']
    return '\n'.join(L)


def replay_interp(tree, law, inputs, timeout=60):
    blobs = [open(f, 'rb').read() for f in inputs]
    fd, env_c = tempfile.mkstemp(suffix='.c', prefix='qp_replay_')
    os.write(fd, replay_env_c(blobs).encode())
    os.close(fd)
    try:
        r = sh([FW + '/tools/interp.sh', CONF, 'harness/%s.c' % law, '1', '1'], cwd=tree, check=False,
               capture=True, coq=True, env={'GP_ENV': env_c, 'GP_INTERP_TIMEOUT': str(timeout)})
    finally:
        os.unlink(env_c)
    out = r.stdout or ''
    if re.search(r'runs 1: no stop \(0 skipped', out):
        return 'pass', ''
    if re.search(r'runs 1: no stop \(1 skipped', out):
        return 'timeout', 'diverged or timed out (%d s), or an assumption is false' % timeout
    m = re.search(r'Stuck state: in function (\w+), expression\s*(.{0,90})', out, re.S)
    if m:
        if m.group(1) == 'gp_assert':
            return 'fail', 'check (gp_assert)'
        return 'fail', 'UB in %s: %s' % (m.group(1), ' '.join(m.group(2).split())[:80])
    if 'Stuck state' in out or 'ERROR' in out:
        return 'fail', ' '.join(out.strip().splitlines()[-1].split())[:100]
    return 'error', ' '.join((out.strip().splitlines() or ['exit %d' % r.returncode])[-1].split())[:100]


def replay(p, law, inputs, interp_=False, variant='patched', stateful=False, timeout=60):
    """`qp replay`: the verdict of the law on each input file (or, with --sequence, on the sequence)."""
    files = []
    for x in inputs:
        files += sorted(glob.glob(os.path.join(x, '*'))) if os.path.isdir(x) else [x]
    groups = [files] if stateful else [[f] for f in files]
    if interp_:
        tree = materialize(p, tree_path(p, variant == 'patched', private=True), variant == 'patched')
    else:
        exe = law_replay_binary(p, law, variant == 'patched')
    counts = {}
    for g in groups:
        v, why = replay_interp(tree, law, g, timeout) if interp_ else replay_native(exe, g, timeout)
        counts[v] = counts.get(v, 0) + 1
        print('%-12s %-60s %s' % (v, ' '.join(os.path.basename(f) for f in g)[:60], why), flush=True)
    print('%s, %s: %s' % (law, 'interpreter' if interp_ else 'native (%s)' % variant,
                          ', '.join('%s %d' % kv for kv in sorted(counts.items()))))


# ---- fidelity: the law against the original target built the upstream way ----

def apply_fault(tree, spec):
    """A seeded fault FILE|OLD|NEW: OLD must occur exactly once in FILE of the tree."""
    parts = spec.split('|')
    if len(parts) != 3:
        die('--fault %s: expected FILE|OLD|NEW' % spec)
    f, old, new = parts
    path = os.path.join(tree, f)
    s = open(path).read()
    if s.count(old) != 1:
        die('--fault %s: OLD occurs %d times in %s of %s' % (spec, s.count(old), f, tree))
    open(path, 'w').write(s.replace(old, new))


def law_style(p, law):
    """The engine of an imported law: libfuzzer, afl-main, honggfuzz-main or honggfuzz-entry."""
    return fuzz_header(os.path.join(p.dir, 'harness', law + '.c'))['opts'].get('style', 'libfuzzer')


def orig_binaries(p, laws, fault=None, tag=''):
    """The original targets of `laws`, built from unmodified upstream at COMMIT as fuzz.conf says (by default
    clang -fsanitize=fuzzer,address,undefined -fno-sanitize-recover=all).  An AFL++ or honggfuzz harness with its own
    main is built without libFuzzer (-fsanitize=address,undefined), with tools/fuzz/afl_repro.h (what afl-cc defines,
    in a reproduction run) or tools/fuzz/hfuzz_repro.c (libhfuzz's HF_ITER on standard input)."""
    fc = fuzz_conf(p)
    cc = (fc['ORIG_CC'] or ['clang'])[0]
    tree = private_tree(p, False, tag)
    for f in fault or []:
        apply_fault(tree, f)
    b = os.path.join(tree, 'build', 'orig')
    os.makedirs(b, exist_ok=True)

    def san_of(style):
        if style in ('afl-main', 'honggfuzz-main'):
            return fc['ORIG_SANITIZE'] or ['-fsanitize=address,undefined', '-fno-sanitize-recover=all']
        return fc['ORIG_SANITIZE'] or ['-fsanitize=fuzzer,address,undefined', '-fno-sanitize-recover=all']

    def compile_(src, obj, style, extra=()):     # -fsanitize=fuzzer at compile time only instruments; the link adds libFuzzer
        r = sh([cc, '-c'] + san_of(style) + list(extra) + fc['ORIG_CFLAGS'] + [src, '-o', obj], cwd=tree, check=False,
               capture=True)
        if r.returncode:
            die('original build failed: %s\n%s' % (src, (r.stdout or '')[-2000:]))
        return obj
    objs, out = {}, {}
    for law in laws:
        h = fuzz_header(os.path.join(p.dir, 'harness', law + '.c'))
        style = law_style(p, law)
        kind = 'main' if style.endswith('-main') else 'fuzzer'
        if kind not in objs:
            objs[kind] = [compile_(s, os.path.join(b, 'src%d_%s.o' % (i, kind)), style)
                          for i, s in enumerate(fc['ORIG_SOURCES'])]
        extra = ['-include', os.path.join(FUZZ_DIR, 'afl_repro.h')] if style == 'afl-main' else []
        tobj = compile_(h['target'], os.path.join(b, 't_%s.o' % law), style, extra)
        if style == 'honggfuzz-main':
            objs[kind] = objs[kind] + [compile_(os.path.join(FUZZ_DIR, 'hfuzz_repro.c'), os.path.join(b, 'hfuzz_repro.o'), style)]
        exe = os.path.join(b, law)
        r = sh([cc] + san_of(style) + [tobj] + objs[kind] + ['-o', exe], cwd=tree, check=False, capture=True)
        if style == 'honggfuzz-main':
            objs[kind] = objs[kind][:-1]
        if r.returncode:
            die('original link failed for %s:\n%s' % (law, (r.stdout or '')[-2000:]))
        out[law] = exe
    return out


def run_orig(exe, f, timeout=60, style='libfuzzer'):
    """The verdict of the original on one input: libFuzzer's reproduction mode (`./target FILE`); an AFL++ or
    honggfuzz harness with its own main reads the input on stdin, and only a signal is a crash there (an exit
    status is not)."""
    if style.endswith('-main'):
        r = sh(['bash', '-c', 'exec "$1" < "$2"', '_', exe, f], check=False, capture=True, timeout=timeout + 10,
               env=dict(DEBUGINFOD_URLS='', ASAN_OPTIONS='abort_on_error=1:detect_leaks=0',
                        UBSAN_OPTIONS='abort_on_error=1:halt_on_error=1'))
        rc = r.returncode if r.returncode >= 0 else 128 - r.returncode
        if rc < 128 and r.returncode != 124:
            return 'pass', ''
        return classify_native(rc, r.stdout or '')
    fc_opts = run_orig.opts
    r = sh([exe] + fc_opts + [f], check=False, capture=True, timeout=timeout + 10, env={'DEBUGINFOD_URLS': ''})
    rc = r.returncode if r.returncode >= 0 else 128 - r.returncode
    return classify_native(rc, r.stdout or '')


def kinds(vs):
    """'deadly signal 24, AddressSanitizer heap-buffer-overflow 3' for the failing verdicts in vs."""
    c = {}
    for v, why in vs:
        if v == 'fail':
            k = re.sub(r' on$', '', why or 'fail')
            c[k] = c.get(k, 0) + 1
    return ', '.join('%s %d' % kv for kv in sorted(c.items(), key=lambda kv: (-kv[1], kv[0]))) or '-'


def fidelity(p, laws, corpus, interp_n, interp_max, itimeout, faults, out_md, jobs):
    fc = fuzz_conf(p)
    run_orig.opts = fc['ORIG_RUN_OPTS'] or ['-timeout=25']
    laws = laws or fuzz_imported_laws(p.dir)
    now = datetime.datetime.now().strftime('%Y-%m-%d %H:%M')
    files = {}
    for law in laws:
        d = os.path.join(corpus, law)
        if not os.path.isdir(d):
            die('no corpus %s (one directory per law)' % d)
        files[law] = sorted(glob.glob(os.path.join(d, '*')))
    rows, dis, irows, frows, krows = [], [], [], [], []

    def table(orig, lawexe, law, fs):
        style = law_style(p, law)
        with cf.ThreadPoolExecutor(jobs) as ex:
            o = list(ex.map(lambda f: run_orig(orig, f, style=style), fs))
            n = list(ex.map(lambda f: replay_native(lawexe, [f]), fs))
        return o, n

    origs = orig_binaries(p, laws)
    for law in laws:
        fs = files[law]
        exe = law_replay_binary(p, law, True)
        o, n = table(origs[law], exe, law, fs)
        cov = [(f, a, b) for f, a, b in zip(fs, o, n) if b[0] != 'not covered']
        agree = sum(1 for _, a, b in cov if a[0] == b[0])
        rows.append((law, len(fs), len(fs) - len(cov), sum(a[0] == 'fail' for _, a, _ in cov),
                     sum(b[0] == 'fail' for _, _, b in cov), agree, len(cov)))
        krows.append(('`%s`' % law, kinds([a for _, a, _ in cov]), kinds([b for _, _, b in cov])))
        dis += [(law, os.path.basename(f), a, b) for f, a, b in cov if a[0] != b[0]]
        print('%-22s files %d, covered %d, original fails %d, law fails %d, agree %d/%d' % (
            law, len(fs), len(cov), rows[-1][3], rows[-1][4], agree, len(cov)), flush=True)
        if interp_n:
            # a deterministic sample: the covered inputs of at most interp_max bytes, evenly spread by size
            small = sorted([x for x in cov if os.path.getsize(x[0]) <= interp_max], key=lambda x: (os.path.getsize(x[0]), x[0]))
            step = max(1, len(small) // interp_n) if small else 1
            sample = small[::step][:interp_n]
            tree = materialize(p, tree_path(p, True, private=True), True)
            res = []
            with cf.ThreadPoolExecutor(jobs) as ex:
                res = list(ex.map(lambda x: replay_interp(tree, law, [x[0]], itimeout), sample))
            # an interpreter timeout gives no verdict (the run is slow, or diverges): left out of the agreement
            ia = sum(1 for (f, a, b), r in zip(sample, res) if r[0] == a[0])
            nt = sum(r[0] == 'timeout' for r in res)
            irows.append((law, len(sample) - nt, ia, nt))
            krows.append(('`%s`, interpreter sample' % law, kinds([a for _, a, _ in sample]), kinds(res)))
            dis += [(law + ' (interp)', os.path.basename(f), a, r) for (f, a, b), r in zip(sample, res)
                    if r[0] != a[0] and r[0] != 'timeout']
            print('%-22s interpreter: %d inputs (<= %d bytes), agree %d, timeouts %d' % (law, len(sample), interp_max, ia, irows[-1][3]), flush=True)
    for k, fault in enumerate(faults):
        tag = '.fault%d' % k
        fo = orig_binaries(p, laws, [fault], tag)
        for law in laws:
            fs = files[law]
            exe = law_replay_binary(p, law, True, [fault], tag)
            o, n = table(fo[law], exe, law, fs)
            cov = [(f, a, b) for f, a, b in zip(fs, o, n) if b[0] != 'not covered']
            agree = sum(1 for _, a, b in cov if a[0] == b[0])
            frows.append((k, law, sum(a[0] == 'fail' for _, a, _ in cov), sum(b[0] == 'fail' for _, _, b in cov), agree, len(cov)))
            krows.append(('`%s`, fault %d' % (law, k), kinds([a for _, a, _ in cov]), kinds([b for _, _, b in cov])))
            dis += [('%s (fault %d)' % (law, k), os.path.basename(f), a, b) for f, a, b in cov if a[0] != b[0]]
            print('fault %d %-22s original fails %d, law fails %d, agree %d/%d' % (k, law, frows[-1][2], frows[-1][3], agree, len(cov)), flush=True)
    L = ['# %s: fidelity of the imported laws' % p.name, '',
         'By `tools/qp fidelity` on %s: upstream %s%s, quickproof %s, corpus `%s`.' % (
             now, p.commit[:12], ' + patch' if p.patch else '', p.framework_label(), corpus), '',
         'Each input file is run through the original fuzz target, built the upstream way from unmodified upstream '
         '(`fuzz.conf`: %s %s %s; for libFuzzer targets), and through the imported law with the input bytes as its nondet stream, natively '
         '(the verified configuration of `quickproof.conf` with the patch, ASan/UBSan) and, on a sample, under '
         'CompCert\'s interpreter. A verdict is pass or fail; inputs the law does not cover (an assumption, e.g. '
         '`--max-len`) are left out.' % ((fc['ORIG_CC'] or ['clang'])[0], ' '.join(fc['ORIG_SANITIZE'] or
                                         ['-fsanitize=fuzzer,address,undefined', '-fno-sanitize-recover=all']),
                                         ' '.join(fc['ORIG_CFLAGS'])), '']
    if any(law_style(p, law).endswith('-main') for law in laws):
        L += ['An AFL++ or honggfuzz harness with its own main is built without libFuzzer (`-fsanitize=address,undefined` '
              'unless `ORIG_SANITIZE` says otherwise), with `tools/fuzz/afl_repro.h` (the macros of afl-cc as they behave '
              'outside afl-fuzz) or `tools/fuzz/hfuzz_repro.c` (`HF_ITER` on standard input); it reads each input on '
              'standard input, and only a signal (abort, a sanitizer report, a crash) counts as a failure, as for '
              'AFL++ and honggfuzz.', '']
    L += [
         '## Native: original target vs law', '',
         '| law | inputs | not covered | original fails | law fails | agree |', '|---|---|---|---|---|---|']
    L += ['| `%s` | %d | %d | %d | %d | **%d/%d** |' % r for r in rows]
    if irows:
        L += ['', '## CompCert interpreter: original target vs law', '',
              'A deterministic sample of the inputs of at most %d bytes, spread evenly by size; an interpreter '
              'timeout (%d s) gives no verdict and is left out.' % (interp_max, itimeout), '',
              '| law | inputs with a verdict | agree | interpreter timeouts |', '|---|---|---|---|']
        L += ['| `%s` | %d | **%d/%d** | %d |' % (r[0], r[1], r[2], r[1], r[3]) for r in irows]
    if faults:
        L += ['', '## Seeded faults (applied to the library in both builds)', '']
        L += ['%d. `%s`' % (k, f.replace('|', ' | ')) for k, f in enumerate(faults)]
        L += ['', '| fault | law | original fails | law fails | agree |', '|---|---|---|---|---|']
        L += ['| %d | `%s` | %d | %d | **%d/%d** |' % r for r in frows]
    L += ['', '## How each side failed', '',
          'The original reports a failing FUZZ_ASSERT or assert() as a deadly signal (abort); the law as a failing '
          'check (gp_assert) of the shim.', '', '| run | original | law |', '|---|---|---|']
    L += ['| %s | %s | %s |' % r for r in krows if r[1] != '-' or r[2] != '-']
    L += ['', '## Disagreements', '']
    if dis:
        L += ['| law | input | original | law |', '|---|---|---|---|']
        L += ['| %s | `%s` | %s %s | %s %s |' % (l, f, a[0], a[1], b[0], b[1]) for l, f, a, b in dis[:200]]
        if len(dis) > 200:
            L.append('| ... | %d more | | |' % (len(dis) - 200))
    else:
        L.append('none')
    L.append('')
    open(out_md, 'w').write('\n'.join(L))
    print('wrote %s' % out_md)


